  ["During static shock, your attacks have a 10% (per level) chance to deal extra damage to enemies affected by Static Shock. (this effect is increased by magic level and base weapon damage)"] = "Durante o Static Shock, seus ataques têm 10% de chance (por nível) de causar dano extra a inimigos afetados pelo Choque Estático. (Este efeito é amplificado pelo nível mágico e dano base da arma)",
  ["Every third consecutive Life punch has a 20% (per level) chance to triger a healing chi wave wich heals a random nearby ally."] = "A cada terceiro soco de Vida consecutivo, há 20% de chance (por nível) de ativar uma onda de cura chi que cura um aliado próximo aleatório.",
  ["If you have 2 or more Elusive Charges, Veil of swords now turns into veil of Echos. Veil of Echos consume all Elusive Charges and  deals high amounts of physical damage."] = "Se você tiver 2 ou mais Cargas Elusivas, o Véu de Espadas se transforma em Véu de Ecos. O Véu de Ecos consome todas as Cargas Elusivas e causa grande quantidade de dano físico.",
  ["You have a 2% (per level) chance to parry physical damage and send a small portion back to the attacker as energy damage."] = "Você tem 2% de chance (por nível) de aparar o dano físico e devolver uma pequena parte ao atacante como dano de energia.",
  ["Your Fire damage have a 1% chance per level to trigger 2 extra fireballs wich deal AOE fire damage"] = "Your Fogo dano have a 1% chance por nível to trigger 2 extra fogobtodoss wich deal AOE fogo dano",
  ["Your Short Circuit now have a chance 25% to grant you High Voltage, wich increases your magic level by 10% (per level) for 6 seconds."] = "Your Short Circuit now have a chance 25% to grant you High Voltage, wich aumenta your magic nível by 10% (por nível) for 6 seconds.",
  ["Your Veil of Swords now heals you for 4% of your max health (per level) and grants you a dodge chance of 3% (per level) for 5 seconds."] = "Your Veil of Swords now heals you for 4% of your max vida (por nível) and concede you a dodge chance of 3% (por nível) for 5 seconds.",
  ["Your adaptive punch (ice + ice) now has a 5% (per level) chance to trigger Glacial Palm wich deals damage to the target and all nearby enemies."] = "Seu soco adaptativo (gelo + gelo) agora tem 5% de chance (por nível) de ativar Glacial Palm, que causa dano ao alvo e a todos os inimigos próximos.",
  ["Your melee attacks have a 3% (per level) chance to deal extra death damage on hit."] = "Seus ataques corpo a corpo têm 3% de chance (por nível) de causar dano de morte extra ao acertar.",
  ["Your nature or earth damage, has a 2% (per level) chance to trigger a carnivorous vile with 45% effectiveness."] = "Seu dano de natureza ou terra têm 2% de chance (por nível) de ativar o Carnivorous Vile com 45% de efetividade.",
  ["Channel the thunder beast - gain +55% attack speed. Physical attacks shock targets for 5.5% of their max HP as energy damage (30s cooldown)"] = "Canalize a besta do trovão - ganha +15% de velocidade de ataque. Ataques físicos chocam os alvos com 1,5% do HP máximo deles como dano de energia (30s de recarga)",
  ["Dwarven resilience kicks in - when HP drops below 40%, instantly recover 60% max HP and gain a burst of speed for 5s (60s cooldown)"] = "A resiliência dos anões entra em ação - quando o HP cai abaixo de 40%, recupera instantaneamente 20% do HP máximo e ganha um impulso de velocidade por 5s (60s de recarga)",
  ["Your mana pool deepens your arcane mastery - gain +2 magic level per 850 max mana"] = "Sua reserva de mana aprofunda sua maestria arcana - ganhe +2 nível mágico por 650 de mana máxima",
  ["Empowers Stormfist, extending its duration by 1 second and amplifying its damage by 10% (per level)"] = "Potencializa o Stormfist, estendendo sua duração em 1 segundo e amplificando seu dano em 10% (por nível)",
  ["Equip"] = "Equipar",
  ["Epic"] = "Épico",
  ["Each kill fuels your momentum - reduce all cooldowns by 150ms on kill"] = "Cada morte alimenta seu ímpeto - reduz todas as recargas em 1500ms ao matar",
  ["Your earth and poison magic strike with serpentine fangs - bonus poison damage scaling with level (x0.22)"] = "Sua magia de terra e veneno ataca com presas serpentinas - dano de veneno bônus escalando com nível (x0.22)",
  ["Your bones absorb the blow - 15% chance to nullify a physical attack, reducing it to just 1 damage (15s cooldown)"] = "Seus ossos absorvem o golpe - 5% de chance de anular um ataque físico, reduzindo-o a apenas 1 de dano (15s de recarga)",
  ["Gallop into battle with relentless momentum - gain +16% movement speed and +16% attack speed"] = "Galope para a batalha com impulso implacável - ganha +6% de velocidade de movimento e +6% de velocidade de ataque",
  ["Your fallen servants detonate in dark fury - when a summon dies, it explodes dealing 35% of its max HP as AoE damage"] = "Seus servos caídos detonam em fúria sombria - quando uma invocação morre, ela explode causando 23% de seu PV máximo como dano em área",
  ["Your legend grows with every conquest - earn +35% bonus fame points when slaying monsters level 2 or higher"] = "Sua lenda cresce a cada conquista - ganhe +23% de pontos de fama bônus ao matar monstros de nível 2 ou superior",
  ["Fame"] = "Fama",
  ["Dungeons"] = "Masmorras",
  ["Fame level:"] = "Nível de Fama:",
  ["Fame Points:"] = "Pontos de Fama:",
  ["Extra Healing"] = "Cura Extra",
  ["Earth Damage"] = "Dano de Terra",
}

modules.client_locales.installLocale(locale)