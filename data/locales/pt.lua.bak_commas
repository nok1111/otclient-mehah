 ["Supply Stash"] = "",
 ["System malfunction triggers a failsafe - 15% chance to activate total immunity for 1.5s when hit (12s cooldown)"] = "Mau funcionamento do sistema ativa um mecanismo de segurança - 15% de chance de ativar imunidade total por 1.5s ao ser atingido (12s de recarga)",
 ["TASK BOARD"] = "QUADRO DE TAREFAS",
