on:"] = "Accion:", ["Activate ignorelist"] = "Activar lista de ignorados", ["Activate whitelist"] = "Activar lista blanca", ["Add new server"] = "Anadir nuevo servidor", ["Add new VIP"] = "Anadir nuevo VIP", ["Add to VIP list"] = "Anadir a lista VIP", ["Add"] = "Anadir", ["Addon 1"] = "Addon 1", ["Addon 2"] = "Addon 2", ["Addon 3"] = "Addon 3", ["Adjust volume"] = "Ajustar volumen", ["Alas! Brave adventurer, you have met a sad fate.\nBut do not despair, for the gods will bring you back\ninto this world in exchange for a small sacrifice\n\nSimply click on Ok to resume your journeys!"] = "¡Ay! Valiente aventurero, has encontrado un triste destino.\nPero no desesperes, pues los dioses te devolveran\na este mundo a cambio de un pequeno sacrificio.\n\n¡Simplemente haz clic en Aceptar para continuar tu travesia!", ["All modules and scripts were reloaded."] = "Todos los modulos y scripts se volvieron a cargar.", ["All"] = "Todo", ["Allow auto chase override"] = "Desactivar auto persecucion al andar", ["Allow VIPs to message you"] = "Permitir mensajes de VIPs", ["Allowed Players"] = "Jugadores permitidos", ["Also known as dash in tibia community, recommended\nfor playing characters with high speed"] = "Conocido por la comunidad de tibia como \"dash\".\nRecomenada para jugadores de alto nivel.", ["Ambient light: %s%%"] = "Luz de ambiente: %s%%", ["Amount"] = "Cantidad", ["Amount:"] = "Cantidad:", ["Anonymous"] = "Annimo", ["Any"] = "Cualquiera", ["Are you sure you want to logout?"] = "¿Estas seguro de que deseas cerrar sesion?", ["Attack"] = "Atacar", ["Auction End"] = "Fin de subasta", ["Audio"] = "Audio", ["Authenticator Token"] = "Token de autenticacion", ["Author"] = "Autor", ["Auto login selected character on next charlist load"] = "Ingresar la siguiente vez que aparece el charlist con el personaje seleccionado", ["Auto login"] = "Auto ingresar", ["Autoload priority"] = "Auto carga prioritaria", ["Autoload"] = "Auto carga", ["Axe Fighting"] = "Combate con hacha", ["Balance"] = "Saldo", ["Balance:"] = "Saldo:", ["Banishment + Final Warning"] = "Baneo + ultimo Aviso", ["Banishment"] = "Baneo", ["Battle"] = "Batalla", ["Browse Field"] = "Explorar campo", ["Browse"] = "Navegar", ["Bug report sent."] = "Reporte de error enviado.", ["Button Assign"] = "Asignar botn", ["Buy Now"] = "Compra ahora", ["Buy Offers"] = "Comprar ofertas", ["Buy with backpack"] = "Comprar con mochila", ["Buy"] = "Compra", ["Buyer Name"] = "Nombre del comprador", ["Cancel"] = "Cancelar", ["Cannot login while already in game."] = "No puedes iniciar sesion mientras ya estas en el juego.", ["Cap"] = "Cap", ["Capacity"] = "Capacidad", ["Center"] = "Centrar", ["Change language"] = "Cambiar idioma", ["Channel appended to %s"] = "Canal agregado a %s", ["Channels"] = "Canales", ["Character List"] = "Lista de personajes", ["Classic control"] = "Controles clasicos", ["Clear current message window"] = "Limpiar ventana de mensajes actual", ["Clear Messages"] = "Limpiar mensajes", ["Clear object"] = "Limpiar objeto", ["Client needs update."] = "El cliente necesita una actualizacion.", ["Client Version"] = "Version del cliente", ["Close this channel"] = "Cerrar este canal", ["Close"] = "Cerrar", ["Club Fighting"] = "Combate con mazo", ["Combat Controls"] = "Controles de combate", ["Comment"] = "Comentario", ["Comment:"] = "Comentario:", ["Connecting to game server..."] = "Conectando a servidor de juego...", ["Connecting to login server..."] = "Conectando a servidor de login...", ["Connection Error"] = "Error de conexion", ["Connection failed, the server address does not exist."] = "Error de conexion, la direccion del servidor no existe.", ["Connection failed."] = "Error de conexion.", ["Connection refused, the server might be offline or restarting.\nPlease try again later."] = "Conexion rechazada, el servidor puede estar fuera de linea o reiniciandose.\nPor favor, intentalo mas tarde.", ["Connection timed out. Either your network is failing or the server is offline."] = "La c