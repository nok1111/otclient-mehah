, ["Arrow Barrage"] = "Descarga de Flechas", ["Rapid Fire"] = "Fuego Rapido", ["Shield Wall"] = "Muro de Escudo", ["Taunt"] = "Provocacion", ["Minor Heal"] = "Sanacion Menor", ["Strong Heal"] = "Sanacion Fuerte", ["Great Heal"] = "Sanacion Mayor", ["Magic Shield"] = "Escudo Magico", ["Find Person"] = "Encontrar Persona", ["Food"] = "Comida", ["Haste"] = "Prisa", ["Levitate"] = "Levitar", ["Increase Aery"] = "Aumenta a Aery", ["Confirm Level Up"] = "Confirmar Subida de Nivel", ["Are you sure you want to level up this node?"] = "Estas seguro de que quieres subir este nodo?", ["To reset the passive skills, you need:"] = "Para reiniciar las habilidades pasivas, necesitas:", ["Confirm Tree Reset"] = "Confirmar Reinicio del Arbol", ["Are you sure you want to reset all your passive skills?"] = "Estas seguro de que quieres reiniciar todas tus habilidades pasivas?", ["pts"] = "pts", ["cap 30%"] = "cap 30%", ["cap 25%"] = "cap 25%", ["Paragon Lv %d | P:%d S:%d U:%d"] = "Nv Paragon %d | P:%d S:%d U:%d", ["%s %dpts: %s   [%s]"] = "%s %dpts: %s   [%s]", ["Failed"] = "Fallido", ["Could not allocate point."] = "No se pudo asignar el punto.", ["Success"] = "Exito", ["Reset Successful"] = "Reinicio Exitoso", ["All your passive skills have been reset."] = "Todas tus habilidades pasivas han sido reiniciadas.", ["Passive Tree"] = "Arbol de Pasivas", ["Available"] = "Disponible", ["Total"] = "Total", ["Reset"] = "Reiniciar", ["Confirm"] = "Confirmar", ["Points"] = "Puntos", ["Current"] = "Actual", ["Next"] = "Siguiente", ["Stats"] = "Estadisticas", ["Reset Tree"] = "Reiniciar Arbol", ["Level Up"] = "Subir Nivel", ["You do not have any available passive points."] = "No tienes puntos de pasivas disponibles.", ["Unable to retrieve tree data."] = "No se pueden obtener los datos del arbol.", ["Invalid node."] = "Nodo invalido.", [" has already reached its maximum level."] = " ha alcanzado su nivel maximo.", ["You need "] = "Necesitas ", [" available passive points to reach level "] = " puntos de pasivas disponibles para alcanzar el nivel ", [" in "] = " en ", ["You need to level up the previous node to at least level "] = "Necesitas subir el nodo anterior al menos al nivel ", [" before leveling up "] = " antes de subir ", [" in branch "] = " en la rama ", [" has been leveled up."] = " ha sido subido de nivel.", ["Could not retrieve passive tree data."] = "No se pudieron obtener los datos del arbol de pasivas.", ["Angelic Form"] = "Forma Angelical", ["Arcane Missiles"] = "Misiles Arcanos", ["Divine Punishment"] = "Castigo Divino", ["Draconic Chains"] = "Cadenas Draconicas", ["Dragon Soul"] = "Alma de Dragon", ["Elusive Blade"] = "Hoja Elusiva", ["Explosive Barrel"] = "Barril Explosivo", ["Explosive Shot"] = "Disparo Explosivo", ["Falcon Shot"] = "Disparo del Halcon", ["Fire Within"] = "Fuego Interior", ["Frost Barrel"] = "Barril de Escarcha", ["Frost Wave"] = "Ola de Escarcha", ["Full Moon"] = "Luna Llena", ["Hand of God"] = "Mano de Dios", ["Hells Core"] = "Nucleo del Infierno", ["Insect Swarm"] = "Enjambre de Insectos", ["Life Bloom"] = "Flor de Vida", ["Malediction"] = "Maldicion", ["Mountain Stance"] = "Postura de la Montana", ["Phantom Shot"] = "Disparo Fantasma", ["Phoenix Wrath"] = "Ira del Fenix", ["Shockwave"] = "Onda de Choque", ["Stealth"] = "Sigilo", ["StealthDuration"] = "Duracion de Sigilo", ["Stormfist"] = "Puno de Tormenta", ["StormfistDamage"] = "Danio de Puno de Tormenta", ["StormfistDuration"] = "Duracion de Puno de Tormenta", ["Tempest Coin"] = "Moneda de la Tempestad", ["Void Execution"] = "Ejecucion del Vacio", ["Zombie Wall"] = "Muro de Zombies", ["living ground"] = "Suelo Viviente", ["Elusive Blade now has a 12% (per level) chance to trigger a second time at 50% effectiveness granting you a Elusive Charge for 10 seconds. (this will refresh old charges of Elusive Charge)"] = "Hoja Elusiva ahora tiene un 12% (por nivel) de probabilidad de activarse una segunda vez con 50% de efectividad, otorgandote una Carga Elusiva durante 10 segundos. (esto refrescara cargas antiguas de Carga Elusiva)", ["Empowers Stormfist, extending its duration by 1 second and amplifying its damage by 10% (per level)"] = "Potencia Puno de Tormenta, extendiendo su duracion 1 segundo y amplificando su danio un 10% (por nivel)", ["Increase the damage done by your Phantom Shot, Falcon Shot and Rapid Fire by an additional 4% (per level)"] = "Aumenta el danio de Disparo Fantasma, Disparo del Halcon y Fuego Rapido un 4% adicional (por nivel)", ["Increase the damage of your casted charged strike based on your Tempest Coin roll by 1 % (per level) per roll"] = "Aumenta el danio de tu Golpe Cargado lanzado basado en tu tirada de Moneda de la Tempestad un 1% (por nivel) por tirada", ["Increases Fire Blast, Hand of God and Eruption damage by 2% per level"] = "Aumenta el danio de Explosion de Fuego, Mano de Dios y Erupcion un 2% por nivel", ["Increases the damage of Arcane Missiles by 3% per level"] = "Aumenta el danio de Misiles Arcanos un 3% por nivel", ["Increases the healing of Dragon Soul by 5% (per level)"] = "Aumenta la curacion de Alma de Dragon un 5% (por nivel)", ["Learn Elusive Blade spell"] = "Aprende el hechizo Hoja Elusiva", ["Learn Explosive Barrel\\nPlace a barrel at your target location exploding after a 4 seconds delay, igniting all enemies nearby. (if you dont have target it will be placed in front of you)"] = "Aprende Barril Explosivo\\nColoca un barril en la ubicacion de tu objetivo que explota tras 4 segundos, incendiando a todos los enemigos cercanos. (si no tienes objetivo se colocara frente a ti)", ["Learn Explosive Shot\\nShoot a powerful shot that explodes on impact after a short delay applying a burn to all nearby enemies"] = "Aprende Disparo Explosivo\\nDispara un potente disparo que explota al impactar tras un breve retraso, aplicando quemadura a todos los enemigos cercanos", ["Learn Falcon Shot\\nShoot a powerful shot that deals physical damage to the target and nearby enemies slowing them for 3 seconds\\n\\n\\nThis node does not require a previous node to be unlocked"] = "Aprende Disparo del Halcon\\nDispara un potente disparo que causa danio fisico al objetivo y enemigos cercanos, ralentizandolos durante 3 segundos\\n\\n\\nEste nodo no requiere un nodo previo desbloqueado", ["Learn Frost Barrel\\nPlace a barrel at your location exploding after a short delay, freezing all enemies nearby."] = "Aprende Barril de Escarcha\\nColoca un barril en tu ubicacion que explota tras un breve retraso, congelando a todos los enemigos cercanos.", ["Learn Life Bloom spell"] = "Aprende el hechizo Flor de Vida", ["Learn Phantom Shot\\nShoot a powerful shot that deals physical damage to the target"] = "Aprende Disparo Fantasma\\nDispara un potente disparo que causa danio fisico al objetivo", ["Learn Spell Full Moon"] = "Aprende el hechizo Luna Llena", ["Learn Spell Stormfist\\n For the next 3 seconds your physical damage sends a lighting shock to nearby target"] = "Aprende el hechizo Puno de Tormenta\\nDurante los siguientes 3 segundos tu danio fisico envia una descarga electrica al objetivo cercano", ["Learn Spell Zombie Wall\\n\\n\\nThis node does not require a previous node to be unlocked"] = "Aprende el hechizo Muro de Zombies\\n\\n\\nEste nodo no requiere un nodo previo desbloqueado", ["Learn spell Angelic Form"] = "Aprende el hechizo Forma Angelical", ["Learn spell Draconic Chains"] = "Aprende el hechizo Cadenas Draconicas", ["Learn spell Dragon Soul"] = "Aprende el hechizo Alma de Dragon", ["Learn spell Fire Within"] = "Aprende el hechizo Fuego Interior", ["Learn spell Malediction"] = "Aprende el hechizo Maldicion", ["Learn spell Mountain Stance\\nReduce Damage taken by 30% and increases your max health by 25% for 10 seconds"] = "Aprende el hechizo Postura de la Montana\\nReduce el danio recibido un 30% y aumenta tu vida maxima un 25% durante 10 segundos", ["Learn spell Phoenix Wrath"] = "Aprende el hechizo Ira del Fenix", ["Learn spell Shockwave"] = "Aprende el hechizo Onda de Choque", ["Learn spell Void Execution"] = "Aprende el hechizo Ejecucion del Vacio", ["Learn the spell Divine Punishment"] = "Aprende el hechizo Castigo Divino", ["Lern spell Tempest Coin\\nToss a tempest coin in the air that will grant you Tempest Charges, Tempest charges will determine the times Charged Strike will be triggered on next cast based on token results (1-3)."] = "Aprende el hechizo Moneda de la Tempestad\\nLanza una moneda de la tempestad al aire que te otorgara Cargas de Tempestad, estas cargas determinan las veces que Golpe Cargado se activara en el siguiente lanzamiento segun los resultados de la moneda (1-3).", ["Unlocks the spell Arcane Missiles\\nEnergy Blast grants 1 charge of Arcane Surge for 15 seconds, stacking up to 6 charges. Each Arcane Surge charge increases the number of Arcane Missiles fired."] = "Desbloquea el hechizo Misiles Arcanos\\nExplosion de Energia otorga 1 carga de Oleada Arcana durante 15 segundos, acumulandose hasta 6 cargas. Cada carga de Oleada Arcana aumenta la cantidad de Misiles Arcanos disparados.", ["Unlocks the spell Frost Wave"] = "Desbloquea el hechizo Ola de Escarcha", ["Unlocks the spell Hand of God"] = "Desbloquea el hechizo Mano de Dios", ["Unlocks the spell Hells Core"] = "Desbloquea el hechizo Nucleo del Infierno", ["When Malediction is applied to a target, it has a 20% (per level) chance to explode and send malefic pestilence to nearby enemies"] = "Cuando Maldicion se aplica a un objetivo, tiene un 20% (por nivel) de probabilidad de explotar y enviar pestilencia malefica a enemigos cercanos", ["Your Explosive Shot now instantly detonates your existing explosive barrels, and increase their damage by an aditional 10% and applying a burn to all nearby enemies"] = "Tu Disparo Explosivo ahora detona instantaneamente tus barriles explosivos existentes, aumenta su danio un 10% adicional y aplica quemadura a todos los enemigos cercanos",
}
}



modules.client_locales.installLocale(locale)