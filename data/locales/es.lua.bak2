ivel", ["Demolition"] = "Demolicion", ["Demolition Proc's now grant you 3% (per level) critical chance and attack speed for 5 seconds"] = "Demolition Proc's now otorgar you 3% (por nivel) critico probabilidad and ataque velocidad for 5 seconds", ["Demonic Bulwark"] = "Baluarte demoniaco", ["DemonicBulwark"] = "DemonicBulwark", ["Detonation Expert"] = "Detonation Expert", ["DetonationExpert"] = "DetonationExpert", ["Castigo Divino"] = "Castigo Divino", ["Divine Restoration"] = "Divine Restoration", ["Dodge"] = "Dodge", ["Cadenas Draconicas"] = "Cadenas Draconicas", ["Dragon Heart"] = "Dragon Heart", ["Alma de Dragon"] = "Alma de Dragon", ["Dragon aura now heals the caster, and increases its healing effectiveness by 5% (per level)"] = "Dragon aura now heals the caster, and aumenta its curacion efectoiveness by 5% (por nivel)", ["DragonHeart"] = "DragonHeart", ["Dragonknight Talents"] = "Dragonknight Talents", ["Druid Talents"] = "Talentos de Druida", ["During static shock, your attacks have a 10% (per level) chance to deal extra damage to enemies affected by Static Shock. (this effect is increased by magic level and base weapon damage)"] = "During static shock, your ataques have a 10% (por nivel) de probabilidad de deal extra dao to enemigos affected by Static Shock. (this efecto is increased by magic nivel and base arma dao)", ["EXP Gain"] = "Ganancia EXP", ["Echoing Command"] = "Echoing Command", ["EchoingCommand"] = "EchoingCommand", ["Elem Dmg"] = "Dao Elem", ["Elemental Harmony"] = "Armona Elemental", ["ElementalHarmony"] = "ElementalHarmony", ["Elusibe Blade"] = "Elusibe Blade", ["Hoja Evasiva"] = "Hoja Evasiva", ["Hoja Evasiva now has a 12% (per level) chance to trigger a second time at 50% effectiveness granting you a Elusive Charge for 10 seconds. (this will refresh old charges of Elusive Charge)"] = "Hoja Evasiva now has a 12% (per level) chance to trigger a second time at 50% effectiveness granting you a Elusive Carga for 10 seconds. (this will refresh old charges of Elusive Carga)", ["Ember Surge"] = "Oleada de Brasas", ["Ember Touch"] = "Ember Touch", ["EmberSurge"] = "EmberSurge", ["EmberTouch"] = "EmberTouch", ["Emberhide"] = "Emberhide", ["Empowers Puno de Tormenta, extending its duration by 1 second and amplifying its damage by 10% (per level)"] = "Empowers Puno de Tormenta, extending its duracion by 1 second and amplifying its dao by 10% (por nivel)", ["Energy Damage"] = "Dano de Energia", ["Enlightened Punishment"] = "Enlightened Punishment", ["EntanglingRoots"] = "EntanglingEnraizars", ["Every 4 hits of a melee attack will have a 20% (per level) chance to trigger consecrated strike to deal extra holy damage"] = "Every 4 hits of a melee ataque will have a 20% (por nivel) de probabilidad de trigger consecrated strike to deal extra sagrado dao", ["Every fourth attack you have a 5% (per level) chance to trigger Frost Quiver, wich deals shoots a fronzen bolt to the target dealing ice damage."] = "Every fourth ataque you have a 5% (por nivel) de probabilidad de trigger Frost Quiver, wich deals shoots a fronzen bolt to the objetivo dealing hielo dao.", ["Every third consecutive Life punch has a 20% (per level) chance to triger a healing chi wave wich heals a random nearby ally."] = "Every third consecutive Life punch has a 20% (por nivel) de probabilidad de triger a curacion chi wave wich heals a random nearby aliado.", ["Every time you use a monk healing spell, restore 1.2% of your maximum health and 2% of your maximum mana."] = "Every time you use a monk curacion hechizo, restore 1.2% of your maximo vida and 2% of your maximo man.", ["Explorer"] = "Explorador", ["Barril Explosivo"] = "Barril Explosivo", ["Disparo Explosivo"] = "Disparo Explosivo", ["Disparo de Halcon"] = "Disparo de Halcon", ["Falling Stars"] = "Ftodosing Stars", ["FallingStars"] = "FtodosingStars", ["Fame Gain"] = "Ganancia Fama", ["Final Veredict"] = "Final Veredict", ["FinalVeredict"] = "FinalVeredict", ["Dano de Fuego"] = "Fuego Dano", ["Fuego Interior"] = "Fuego Interior", ["Flame Eater"] = "Flame Eater", ["FlameEater"] = "FlameEater", ["FocusHealing"] = "FocusCuracion", ["Focused Fire"] = "Focused Fuego", ["FocusedFire"] = "FocusedFuego", ["Force of Nature"] = "Force of Nature", ["ForceOfNature"] = "ForceOfNature", ["Frenzied Blades"] = "Frenzied Blades", ["Frost Armor"] = "Armadura de Escarcha", ["Frost Aura"] = "Frost Aura", ["Frost Barrage"] = "Frost Barrage", ["Barril de Escarcha"] = "Barril de Escarcha", ["Frost Blossom"] = "Frost Blossom", ["Frost Quiver"] = "Frost Quiver", ["Frost Shards"] = "Frost Shards", ["Ola de Escarcha"] = "Ola de Escarcha", ["FrostAura"] = "FrostAura", ["FrostBarrage"] = "FrostBarrage", ["FrostBlossom"] = "FrostBlossom", ["FrostQuiver"] = "FrostQuiver", ["Frostbite Weapon"] = "Arma Gelida", ["Loto Congelado"] = "Loto Congelado", ["FrozenLotus"] = "FrozenLotus", ["Luna Llena"] = "Luna Llena", ["Gambler's Luck"] = "Gambler's Luck", ["GamblerLuck"] = "GamblerLuck", ["Glacial Empowerment"] = "Glacial Empowerment", ["Palma Glacial"] = "Palma Glacial", ["GlacialPalm"] = "GlacialPalm", ["God of Spears"] = "God of Spears", ["GodOfSpears"] = "GodOfSpears", ["Guardian"] = "Guardian", ["Guardian of Light"] = "Guardian of Light", ["Guiding Constellation"] = "Guiding Constellation", ["Mano de Dios"] = "Mano de Dios", ["Healing Concentration"] = "Concentracion de Curacion", ["HealingEffectiveness"] = "EfectividadCuracion", ["Health Regen"] = "Regeneracion de Vida", ["Heartseeker"] = "Heartseeker", ["Hell's Core"] = "Hell's Core", ["Nucleo del Infierno"] = "Nucleo del Infierno", ["High Voltage"] = "High Voltage", ["HighVoltage"] = "HighVoltage", ["Hive Queen"] = "Hive Queen", ["HiveQueen"] = "HiveQueen", ["Ascendencia Sagrada"] = "Ascendencia Sagrada", ["Holy Damage"] = "Dano Sagrado", ["Holy Flare"] = "Destello Sagrado", ["Holy strike deals an aditional 5% (per level) extra damage to enemies below 50% health"] = "El golpe sagrado inflige un 5% (por nivel) de dano adicional a enemigos con menos del 50% de vida", ["Holy strike now has a 10% chance (per level) to trigger a holy light wich heals you scaling with 10% of your max mana."] = "El golpe sagrado ahora tiene un 10% de probabilidad (por nivel) de activar una luz sagrada que te cura escalando con el 10% de tu mana maximo.", ["Hunter's Mercy"] = "Hunter's Mercy", ["HunterMercy"] = "HunterMercy", ["Ice Arrow"] = "Flecha de Hielo", ["Ice Clones"] = "Clones de Hielo", ["Ice Damage"] = "Dano de Hielo", ["Ice Shatter"] = "Rotura de Hielo", ["IceBarrage"] = "IceBarrage", ["IceCloneDamage"] = "IceCloneDano", ["If you have 2 or more Elusive Charges, Veil of swords now turns into veil of Echos. Veil of Echos consume all Elusive Charges and  deals high amounts of physical damage."] = "Si tienes 2 o mas cargas Elusivas, el Velo de Espadas se convierte en Velo de Ecos. El Velo de Ecos consume todas las cargas Elusivas y causa un gran dano fisico.", ["Immortal Flesh"] = "Immortal Flesh", ["Increase Aery's Strikes shots by 1 per level"] = "Aumenta los disparos de Aery's Strikes en 1 por nivel", ["Increase Rend damage by 3% (per level)"] = "Aumenta el dano de Desgarrar en un 3% (por nivel)", ["Increase Veil of Echos and Veil of Swords damage by an aditional 4% (per level)"] = "Aumenta el dano del Velo de Ecos y el Velo de Espadas un 4% adicional (por nivel)", ["Increase all holy damage by 2% per level \nThis talent does not requires a previous talent node."] = "Aumenta todo el dano sagrado un 2% por nivel.\\nEste talento no requiere un nodo previo.", ["Increase bear form maximum health and health regeneration by 5% per level"] = "Aumenta la vida maxima y la regeneracion de vida en forma de oso un 5% por nivel", ["Increase critical strike chance by 2% (per level)"] = "Aumenta la probabilidad de golpe critico un 2% (por nivel)", ["Increase critical strike chance by 2% per level"] = "Aumenta la probabilidad de golpe critico un 2% por nivel", ["Increase elemental resistance by 2% (per level)"] = "Aumenta la resistencia elemental un 2% (por nivel)", ["Increase malediction, curse and dark plague duration by 0.5 seconds per level"] = "Aumenta la duracion de maldicion, maldicion oscura y plaga oscura en 0.5 segundos por nivel", ["Increase max health by 4% (per level)"] = "Aumenta la vida maxima un 4% (por nivel)", ["Increase physical damage done by 2% and your energy damage by 2% (per level)"] = "Aumenta el dano fisico un 2% y tu dano de energia un 2% (por nivel)", ["Increase physical damage done by 2% per level"] = "Aumenta el dano fisico un 2% por nivel", ["Increase physical damage done by 3% (per level)"] = "Aumenta el dano fisico un 3% (por nivel)", ["Increase physical damage done by 6% per level"] = "Aumenta el dano fisico un 6% por nivel", ["Increase terra strike and carnivorous vile damage by 3% (per level)"] = "Increase terra strike and carnivorous vile damage by 3% (per level)", ["Increase the damage by Glacial Palm and Frozen Lotus haling by 6% (per level)"] = "Aumenta el dano de Glacial Palm y Frozen Lotus un 6% (por nivel)", ["Increase the damage done by Wrath of Nature by 4% (per level)"] = "Increase the damage done by Ira de la Naturaleza by 4% (per level)", ["Increase the damage done by your Disparo Fantasma, Disparo de Halcon and Rapid Fire by an additional 4% (per level)"] = "Increase the damage done by your Disparo Fantasma, Disparo de Halcon and Fuego Rapido by an additional 4% (per level)", ["Increase the damage done to burning targets by 2% (per level)"] = "Aumenta el dano infligido a objetivos en llamas un 2% (por nivel)", ["Increase the damage of your casted charged strike based on your Moneda de la Tempestad roll by 1 % (per level) per roll"] = "Increase the damage of your casted charged strike based on your Moneda de la Tempestad roll by 1 % (per level) per roll", ["Increase the damage of your holy ground by 8% (per level)"] = "Aumenta el dano de tu terreno sagrado un 8% (por nivel)", ["Increase the duration of Dark Aura by 0.5 seconds (per level)"] = "Increase the duration of Aura Oscura by 0.5 seconds (per level)", ["Increase the effectiveness of Focus Healing by 6% per level"] = "Increase the effectiveness of Sanacion Concentrada by 6% per level", ["Increase the energy damage done by 2% per level"] = "Aumenta el dano de energia infligido un 2% por nivel", ["Increase the healing effectiveness of your adaptive punch (life + life) by 10% (per level)"] = "Aumenta la efectividad de curacion de tu golpe adaptativo (vida + vida) un 10% (por nivel)", ["Increase the healing effectiveness of zen barrier when is casted on yourself and the healing effectiveness of fist of life by 10% (per level)"] = "Increase the healing effectiveness of zen barrier when is casted on yourself and the healing effectiveness of fist of life by 10% (per level)", ["Increase the healing of rain fall by 6% (per level)\nincrease the duration of rainfall by 1 second (per level)"] = "Aumenta la curacion de Rainfall un 6% (por nivel)\\\\nAumenta la duracion de Rainfall en 1 segundo (por nivel)", ["Increase the health gain from your brutal swing by 10% (per level)"] = "Increase the health gain from your brutal swing by 10% (per level)", ["Increase the mana recovery from energy blast and mana flow 3% per level\nIncreases your energy damage by 1% (per level)."] = "Increase the mana recovery from energy blast and mana flow 3% per level\\nIncreases your energy damage by 1% (per level).", ["Increase the mana transfer from blood pact by 12% per level"] = "Increase the mana transfer from blood pact by 12% per level", ["Increase the max health of your summons by an aditional 18% per level"] = "Aumenta la vida maxima de tus invocaciones un 18% adicional por nivel", ["Increase the max number result from tempest coin by 1 (per level)"] = "Aumenta el resultado maximo de la Moneda de la Tempestad en 1 (por nivel)", ["Increase the maximum number of Servants you can control by 1 (per level) and increase your chance to successfully summon by 100% per level."] = "Aumenta el numero maximo de Servidores que puedes controlar en 1 (por nivel) y aumenta tu probabilidad de invocar con exito un 100% por nivel.", ["Increase the passive healing of Aery by 6% (per level)"] = "Aumenta la curacion pasiva de Aery un 6% (por nivel)", ["Increase the shots from rapid fire by 1 (per level) and reduces its cast time."] = "Increase the shots from rapid fire by 1 (per level) and reduces its cast time.", ["Increase you max health by 3% (per level)"] = "Aumenta tu vida maxima un 3% (por nivel)", ["Increase your Melee skill by an aditional 3 points (per level)."] = "Aumenta tu habilidad cuerpo a cuerpo en 3 puntos adicionales (por nivel).", ["Increase your critical chance by an aditional 3% (per level)"] = "Aumenta tu probabilidad de golpe critico un 3% adicional (por nivel)", ["Increase your critical damage chance by 2% (per level) for each enemy reached by Swarn of Insects"] = "Aumenta tu probabilidad de dano critico un 2% (por nivel) por cada enemigo alcanzado por Swarn of Insects", ["Increase your fire damage by an additional 3% (per level) and your physical damage done by an additional 2% (per level)"] = "Aumenta tu dano de fuego un 3% adicional (por nivel) y tu dano fisico un 2% adicional (por nivel)", ["Increase your ice damage by 4% per level."] = "Aumenta tu dano de hielo un 4% por nivel.", ["Increase your ice damage by an aditional 2% (per level)"] = "Aumenta tu dano de hielo un 2% adicional (por nivel)", ["Increase your maximum health by 2% and 3 health points regeneration every 3 seconds (per level)"] = "Aumenta tu vida maxima un 2% y la regeneracion en 3 puntos de vida cada 3 segundos (por nivel)", ["Increases Dodge Chance by 2% per level"] = "Aumenta la probabilidad de esquivar un 2% por nivel", ["Increases Fire Blast, Mano de Dios and Eruption damage by 2% per level"] = "Increases Explosion de Fuego, Mano de Dios and Erupcion damage by 2% per level", ["Increases Healling effectivenessby 6% per level \nReduce the mana cost of moon light by 3% per level"] = "Increases Healling effectivenessby 6% per level \\nReduce the mana cost of moon light by 3% per level", ["Increases all fire damage done by 1% per level"] = "Aumenta todo el dano de fuego infligido un 1% por nivel", ["Increases attack speed by 2% per level"] = "Aumenta la velocidad de ataque un 2% por nivel", ["Increases attack speed by 5% (per level)"] = "Aumenta la velocidad de ataque un 5% (por nivel)", ["Increases critical chance by 2% per level"] = "Aumenta la probabilidad de golpe critico un 2% por nivel", ["Increases life leech by 2% (per level)"] = "Aumenta el robo de vida un 2% (por nivel)", ["Increases max Mana by 2.0% per level"] = "Aumenta el mana maximo un 2.0% por nivel", ["Increases max health by 3.0% per level"] = "Aumenta la vida maxima un 3.0% por nivel", ["Increases max health by 4.0% per level\n\n\nThis node does not require a previous node to be unlocked"] = "Aumenta la vida maxima un 4.0% por nivel.\\n\\n\\nEste nodo no requiere un nodo previo desbloqueado", ["Increases max health by 5.0% per level"] = "Aumenta la vida maxima un 5.0% por nivel", ["Increases max mana by 2% per level"] = "Aumenta el mana maximo un 2% por nivel", ["Increases max mana by 4% per level"] = "Aumenta el mana maximo un 4% por nivel", ["Increases maximum mana by 5% per level"] = "Aumenta el mana maximo un 5% por nivel", ["Increases mutilate damage by 3% per level"] = "Increases mutilate damage by 3% per level", ["Increases stealth duration by 1 second per level"] = "Aumenta la duracion del sigilo en 1 segundo por nivel", ["Increases the amount of life leech by 1% (per level)"] = "Aumenta la cantidad de robo de vida un 1% (por nivel)", ["Increases the damage of Misiles Arcanos by 3% per level"] = "Aumenta el dano de Misiles Arcanos un 3% por nivel", ["Increases the damage of your elemental fists (Fire, Ice, Life) by 2% per level when used in combination"] = "Aumenta el dano de tus punos elementales (Fuego, Hielo, Vida) un 2% por nivel cuando se usan en combinacion", ["Increases the damage of your summons by 4% (per level)."] = "Aumenta el dano de tus invocaciones un 4% (por nivel).", ["Increases the duration of Curse by 0.5 second (per level) \nIncreases curse damage by 3% (per level)"] = "Aumenta la duracion de Maldicion en 0.5 segundos (por nivel).\\nAumenta el dano de Maldicion un 3% (por nivel)", ["Increases the effectiveness of Blood Wall by 12% per level\n\n\nThis node does not require a previous node to be unlocked"] = "Increases the effectiveness of Muro de Sangre by 12% per level\\n\\n\\nThis node does not require a previous node to be unlocked", ["Increases the healing of Alma de Dragon by 5% (per level)"] = "Aumenta the curacion of Dragon Alma by 5% (por nivel)", ["Increases the number of times Drain Soul damages its targets by 1 per level."] = "Increases the number of times Drenar Alma damages its targets by 1 per level.", ["Increases your Magic Level by 2 points per level"] = "Aumenta tu Nivel Magico en 2 puntos por nivel", ["Increse the amount of shots of Ice Barrage by 1 per level"] = "Increse the amount of shots of Barrera de Hielo by 1 per level", ["Increse the damage of your frost spells by 3% per level"] = "Aumenta el dano de tus hechizos de escarcha un 3% por nivel", ["Increse the damage of your ice clones by 10% per level"] = "Aumenta el dano de tus clones de hielo un 10% por nivel", ["Increses the distance traveled of teleport by 1 tile (per level) \nIncrease your magic level percent by 10% (per level) for 5 seconds"] = "Aumenta la distancia del teletransporte en 1 casilla (por nivel).\\nAumenta tu nivel magico un 10% (por nivel) durante 5 segundos", ["Infernal Command"] = "Infernal Command", ["InfernalCommand"] = "InfernalCommand", ["Inner Tempo"] = "Inner Tempo", ["InnerTempo"] = "InnerTempo", ["Enjambre de Insectos"] = "Enjambre de Insectos", ["Jackpot"] = "Jackpot", ["Judgement and Exorcism deals 1% (per level) of your total mana as extra damage"] = "Juicio and Exorcismo deals 1% (per level) of your total mana as extra damage", ["Judgement now heals 2% of your max health (per level)"] = "Juicio now heals 2% of your max health (per level)", ["Judgment of Wisdom"] = "Judgment of Wisdom", ["JudmentManaExtraDamage"] = "JudmentManaExtraDano", ["JudmentRestore"] = "JudmentRestore", ["JudmentStun"] = "JudmentAturdimiento", ["Killing Instinct"] = "Killing Instinct", ["Kinetic Dancer"] = "Kinetic Dancer", ["Kings Blessing"] = "Bendicion del Rey", ["Landing a mystic punch increases your attack speed by 8% (per level) for 5 seconds"] = "Aterrizar un golpe mistico aumenta tu velocidad de ataque un 8% (por nivel) durante 5 segundos", ["Lasting Blight"] = "Lasting Blight", ["LastingBlight"] = "LastingBlight", ["Lawbringer's Shock"] = "Lawbringer's Shock", ["Learn Bear Form spell\\n\\n\\nThis node does not require a previous node to be unlocked"] = "Aprende el hechizo Forma de Oso.\\n\\n\\nEste nodo no requiere un nodo previo desbloqueado", ["Learn Hoja Evasiva spell"] = "Aprende el hechizo Hoja Evasiva", ["Learn Barril Explosivo\\nPlace a barrel at your target location exploding after a 4 seconds delay, igniting all enemies nearby. (if you dont have target it will be placed in front of you)"] = "Aprende Barril Explosivo.\\nColoca un barril en la ubicacion del objetivo que explota tras 4 segundos, incendiando a todos los enemigos cercanos. (Si no tienes objetivo, se coloca frente a ti)", ["Learn Disparo Explosivo\\nShoot a powerful shot that explodes on impact after a short delay applying a burn to all nearby enemies"] = "Aprende Disparo Explosivo.\\nDispara un poderoso proyectil que explota al impactar tras un breve retardo, aplicando quemadura a todos los enemigos cercanos", ["Learn Disparo de Halcon\\nShoot a powerful shot that deals physical damage to the target and nearby enemies solowing them for 3 seconds\\n\\n\\nThis node does not require a previous node to be unlocked"] = "Aprende Disparo de Halcon.\\nDispara un poderoso proyectil que causa dano fisico al objetivo y enemigos cercanos, ralentizandolos durante 3 segundos.\\n\\n\\nEste nodo no requiere un nodo previo desbloqueado", ["Learn Frost Armor spell\nGain a frost armor wich reduces your damage taken by 20% and deals ice damage back to the attacker."] = "Aprende el hechizo Armadura de Escarcha spell\\nGain a frost armor wich reduces your damage taken by 20% and deals ice damage back to the attacker.", ["Learn Barril de Escarcha\\nPlace a barrel at your location exploding after a short delay, freezing all enemies nearby."] = "Aprende Barril de Escarcha.\\\\nColoca un barril en tu ubicacion que explota tras un breve retardo, congelando a todos los enemigos cercanos.", ["Learn Ice Arrow\nShoot a powerful ice arrow that slows the target for 5 seconds, if target is already slowed or frozen, it will deal double damage."] = "Aprende el hechizo Flecha de Hielo \\nShoot a powerful ice arrow that slows the target for 5 seconds, if target is already slowed or frozen, it will deal double damage.", ["Learn Ice Shatter spell\nTurn the target into a solid ice block dealing ice damage and a second AOE damage when it ends."] = "Aprende el hechizo Rotura de Hielo spell\\nTurn the target into a solid ice block dealing ice damage and a second AOE damage when it ends.", ["Learn Flor de Vida spell"] = "Aprende el hechizo Flor de Vida", ["Learn Living Ground spell\\nPlace a nature ground on your current position wich heal all nearby allies while standing on it."] = "Aprende el hechizo Living Ground.\\nColoca un terreno de naturaleza en tu posicion actual que cura a todos los aliados cercanos mientras permanecen sobre el.", ["Learn Magnetic Shield spell\nGain damage immunity for 5 seconds to all damage types but reduce your damage done by 80%"] = "Aprende el hechizo Escudo Magnetico spell\\nGain damage immunity for 5 seconds to all damage types but reduce your damage done by 80%", ["Learn Disparo Fantasma\\nShoot a powerful shot that deals physical damage to the target"] = "Aprende Disparo Fantasma.\\\\nDispara un poderoso proyectil que causa dano fisico al objetivo", ["Learn Spell Luna Llena"] = "Aprende el hechizo Luna Llena", ["Learn Spell Holy Flare"] = "Aprende el hechizo Destello Sagrado", ["Learn Spell Solar Blessing\nIncrease the target's max health by 65% for 8 seconds and healing them instantly for 50% of your max mana at the start and ending of spell."] = "Aprende el hechizo Bendicion Solar \\nIncrease the target's max health by 65% for 8 seconds and healing them instantly for 50% of your max mana at the start and ending of spell.", ["Learn Spell Puno de Tormenta\\n For the next 3 seconds your physical damage sends a lighting shock to nearby target"] = "Aprende el hechizo Puno de Tormenta.\\\\nDurante los proximos 3 segundos, tu dano fisico envia una descarga electrica a los objetivos cercanos", ["Learn Spell Summon Void Guard"] = "Aprende el hechizo Invocar Guardian del Vacio", ["Learn Spell Summon Void Mender"] = "Aprende el hechizo Invocar Sanador del Vacio", ["Learn Spell Muro de Zombis\\n\\n\\nThis node does not require a previous node to be unlocked"] = "Aprende el hechizo Muro de Zombis.\\n\\n\\nEste nodo no requiere un nodo previo desbloqueado", ["Learn spell Forma Angelical"] = "Aprende el hechizo Forma Angelical", ["Learn spell Assassination"] = "Aprende el hechizo Asesionato", ["Learn spell Blackout"] = "Aprende el hechizo Apagon", ["Learn spell Bloodlust"] = "Aprende el hechizo Lujuria Sangrienta", ["Learn spell Dark Aura"] = "Aprende el hechizo Aura Oscura", ["Learn spell Dark Plague"] = "Aprende el hechizo Plaga Oscura", ["Learn spell Cadenas Draconicas"] = "Aprende el hechizo Cadenas Draconicas", ["Learn spell Alma de Dragon"] = "Aprende el hechizo Alma de Dragon", ["Learn spell Fuego Interior"] = "Aprende el hechizo Fuego Interior", ["Learn spell Guardian of Light"] = "Aprende el hechizo Guardian of Luz", ["Learn spell Kings Blessing"] = "Aprende el hechizo Bendicion del Rey", ["Learn spell Maledicion"] = "Aprende el hechizo Maledicion", ["Learn spell Postura de la Montana\\nReduce Damage taken by 30% and increases your max health by 25% for 10 seconds"] = "Aprende el hechizo Postura de la Montana.\\nReduce el dano recibido un 30% y aumenta tu vida maxima un 25% durante 10 segundos", ["Learn spell Ira del Fenix"] = "Aprende el hechizo Ira del Fenix", ["Learn spell Sacred Ground"] = "Aprende el hechizo Suelo Sagrado", ["Learn spell Onda de Choque"] = "Aprende el hechizo Onda de Choque", ["Learn spell Swarn of Insects\\nPlace a swarm of insects on a target incareasing it's damage received by 10% (per level) from all sources."] = "Aprende el hechizo Swarm of Insects.\\nColoca un enjambre de insectos sobre un objetivo aumentando el dano que recibe un 10% (por nivel) de todas las fuentes.", ["Learn spell Ejecucion del Vacio"] = "Aprende el hechizo Ejecucion del Vacio", ["Learn spell Zen Barrier\nPlace a serenity sphere on a chosen player for 8 seconds. Each time they take damage, the sphere absorbs the damage and instantly heals them for the same amount."] = "Aprende el hechizo Barrera Zen \\nPlace a serenity sphere on a chosen player for 8 seconds. Each time they take damage, the sphere absorbs the damage and instantly heals them for the same amount.", ["Learn the spell Castigo Divino"] = "Aprende el hechizo Castigo Divino", ["Legion Mastery"] = "Legion Mastery", ["LegionMasteryChance"] = "LegionMasteryChance", ["LegionMasteryNumber"] = "LegionMasteryNumber", ["Lern spell Moneda de la Tempestad\nToss a tempest coin in the air that will grant you Tempest Charges, Tempest charges will determine the times Charged Strike will be triggered on next cast based on token results (1-3)."] = "Aprende el hechizo Moneda de la Tempestad \\nToss a tempest coin in the air that will grant you Tempest Charges, Tempest charges will determine the times Golpe Cargado will be triggered on next cast based on token results (1-3).", ["Lethal Dagger now deals 5% (per level) extra physical damage and has a chance of 20% (per level) to apply a bleed to the target"] = "Daga Letal now deals 5% (per level) extra physical damage and has a chance of 20% (per level) to apply a bleed to the target", ["Lethal dagger now has a chance 12% per level to create a  shadow version of yourself wich deals death damage for 6 seconds."] = "Lethal dagger now has a chance 12% per level to create a  shadow version of yourself wich deals death damage for 6 seconds.", ["Level up"] = "Subir Nivel", ["Flor de Vida"] = "Flor de Vida", ["Life Leech"] = "Life Leech", ["Life Pulse"] = "Life Pulse", ["LifePulse"] = "LifePulse", ["Lifeblood Strike"] = "Lifeblood Strike", ["LifebloodStrike"] = "LifebloodStrike", ["Light Dancer Talents"] = "Light Dancer Talents", ["Light beam damage increased by 12% per level \nThis talent does not requires a previous talent node."] = "El dano del rayo de luz aumenta un 12% por nivel.\\nEste talento no requiere un nodo previo.", ["Light's ON"] = "Light's ON", ["Lightning Riposte"] = "Lightning Riposte", ["Lightning Spear is no longer range but its damage is increased by 4% (per level) and grants you a Elusive Charge for 10 seconds. (this will refresh old charges of Elusive Charge)"] = "Lanza de Relampago is no longer range but its damage is increased by 4% (per level) and grants you a Elusive Carga for 10 seconds. (this will refresh old charges of Elusive Carga)", ["Lightning Spear now grants you 3% attack speed for 8 seconds and deals 3% more damage per level"] = "Lanza de Relampago now grants you 3% attack speed for 8 seconds and deals 3% more damage per level", ["Lightning Waltz"] = "Lightning Waltz", ["LightningRiposte"] = "LightningRiposte", ["LightningWaltzHeal"] = "LightningWaltzHeal", ["LightningWaltzparry"] = "LightningWaltzparry", ["LightsON"] = "LightsON", ["Lingering Darkness"] = "Lingering Darkness", ["LingeringDarkness"] = "LingeringDarkness", ["Living Ground"] = "Living Ground", ["Living ground now deals damage to nearby enemies every 1.0 seconds, dealing 