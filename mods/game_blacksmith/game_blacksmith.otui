BlacksmithSlot < Item
  size: 64 64
  margin: 2
  phantom: false
  virtual: true
  focusable: true
  item-id: 0
  item-count: 0
  draggable: false
  border-width: 1
  border-color: #ffffff55
  background-color: #00000088

BSGridItem < Item
  size: 40 40
  margin: 1
  phantom: false
  virtual: true
  focusable: false
  draggable: false
  border-width: 1
  border-color: #ffffff33
  background-color: #00000055

  Label
    id: ilvlLabel
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 1
    margin-bottom: 0
    font: small-9px
    color: #dfdfdf
    text-auto-resize: true
    phantom: true

MaterialRow < Panel
  height: 28
  phantom: true

  Item
    id: matIcon
    size: 26 26
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: false
    virtual: true
    item-id: 0
    draggable: false

  Label
    id: matName
    anchors.left: matIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  Label
    id: matCount
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  Label
    id: matMark
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 60
    font: verdana-11px-rounded
    color: #00BC00
    text-auto-resize: true

MainWindow
  id: blacksmithWindow
  !text: tr('Blacksmith')
  size: 940 560
  @onEscape: Blacksmith.hide()

  // ==================== HEADER ====================
  Label
    id: headerLevel
    !text: tr('Level 0')
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
    margin-right: 12
    font: verdana-11px-rounded
    color: #80c7f8
    text-auto-resize: true

  Label
    id: headerRank
    !text: tr('Novice')
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  ProgressBar
    id: xpBar
    anchors.top: headerRank.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 3
    width: 300
    height: 12

  Label
    id: xpLabel
    !text: tr('0 / 0 XP')
    anchors.top: xpBar.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    font: small-9px
    color: #c0c0c0
    text-auto-resize: true

  // ==================== LEFT: INVENTORY ====================
  Panel
    id: inventoryPanel
    anchors.top: xpLabel.bottom
    anchors.bottom: statusPanel.top
    anchors.left: parent.left
    width: 296
    margin-top: 10
    margin-left: 10
    margin-bottom: 8
    phantom: false
    background-color: #00000055
    border-width: 1
    border-color: #ffffff33

    Label
      id: invTitle
      !text: tr('INVENTORY')
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6
      font: verdana-11px-rounded
      color: #dfdfdf
      text-auto-resize: true

    Button
      id: filterAll
      !text: tr('All')
      anchors.top: invTitle.bottom
      anchors.left: parent.left
      margin-top: 6
      margin-left: 8
      width: 56
      height: 20

    Button
      id: filterWeapons
      !text: tr('Weapons')
      anchors.top: invTitle.bottom
      anchors.left: filterAll.right
      margin-top: 6
      margin-left: 4
      width: 66
      height: 20

    Button
      id: filterArmor
      !text: tr('Armor')
      anchors.top: invTitle.bottom
      anchors.left: filterWeapons.right
      margin-top: 6
      margin-left: 4
      width: 56
      height: 20

    Button
      id: filterAccessory
      !text: tr('Access.')
      anchors.top: invTitle.bottom
      anchors.left: filterArmor.right
      margin-top: 6
      margin-left: 4
      width: 60
      height: 20

    Label
      id: invHint
      !text: tr('Click an item to place it in the station.')
      anchors.top: filterAll.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 8
      margin-right: 8
      height: 24
      font: small-9px
      color: #c0c0c0
      text-wrap: true

    ScrollablePanel
      id: invScroll
      anchors.top: invHint.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 6
      padding-right: 14
      vertical-scrollbar: invScrollBar
      border-width: 1
      border-color: #ffffff22
      background-color: #00000033

      Panel
        id: invGrid
        width: 262
        layout:
          type: grid
          cell-size: 42 42
          cell-spacing: 2
          num-columns: 6
          flow: true
          fit-children: true

    VerticalScrollBar
      id: invScrollBar
      anchors.top: invScroll.top
      anchors.right: invScroll.right
      anchors.bottom: invScroll.bottom
      step: 44
      pixels-scroll: true

    Label
      id: invEmpty
      !text: tr('No refinable equipment found.')
      anchors.centerIn: invScroll
      font: small-9px
      color: #dfdfdf88
      text-auto-resize: true

  // ==================== CENTER: REFINEMENT ====================
  Panel
    id: centerPanel
    anchors.top: xpLabel.bottom
    anchors.bottom: statusPanel.top
    anchors.left: inventoryPanel.right
    anchors.right: professionPanel.left
    margin-top: 10
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    phantom: false
    background-color: #00000044
    border-width: 1
    border-color: #ffffff33

    Label
      id: centerTitle
      !text: tr('REFINEMENT')
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6
      font: verdana-11px-rounded
      color: #dfdfdf
      text-auto-resize: true

    // --- Empty state ---
    Panel
      id: emptyState
      anchors.top: centerTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 190
      margin-top: 6
      phantom: true

      Item
        id: anvilIcon
        size: 64 64
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 24
        phantom: false
        virtual: true
        focusable: false
        draggable: false
        opacity: 0.55
        border-width: 1
        border-color: #ffffff22

      Label
        id: emptyHintLabel
        !text: tr('CLICK AN ITEM')
        anchors.top: anvilIcon.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 8
        font: verdana-11px-rounded
        color: #dfdfdf
        text-auto-resize: true

      Label
        id: emptySubLabel
        !text: tr('Select an eligible item from your inventory on the left to refine it.')
        anchors.top: emptyHintLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 12
        margin-right: 12
        height: 26
        font: small-9px
        color: #c0c0c0
        text-align: center
        text-wrap: true

    // --- Filled state ---
    Panel
      id: filledState
      anchors.top: centerTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 190
      margin-top: 6
      phantom: true
      visible: false

      BlacksmithSlot
        id: itemSlot
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 8

      Label
        id: itemNameLabel
        !text: tr('')
        anchors.top: itemSlot.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        font: verdana-11px-rounded
        color: #dfdfdf
        text-auto-resize: true

      Label
        id: itemInfoLabel
        !text: tr('')
        anchors.top: itemNameLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2
        font: small-9px
        color: #c0c0c0
        text-auto-resize: true

      // CURRENT -> TARGET
      Label
        id: currentRarity
        !text: tr('-')
        anchors.top: itemInfoLabel.bottom
        anchors.right: parent.horizontalCenter
        margin-top: 10
        margin-right: 26
        font: verdana-11px-rounded
        color: #dfdfdf
        text-auto-resize: true

      Label
        id: arrowLabel
        !text: tr('>')
        anchors.top: itemInfoLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10
        font: verdana-11px-rounded
        color: #80c7f8
        text-auto-resize: true

      Label
        id: targetRarity
        !text: tr('-')
        anchors.top: itemInfoLabel.bottom
        anchors.left: parent.horizontalCenter
        margin-top: 10
        margin-left: 26
        font: verdana-11px-rounded
        color: #dfdfdf
        text-auto-resize: true

      Label
        id: currentSub
        !text: tr('CURRENT')
        anchors.top: currentRarity.bottom
        anchors.horizontalCenter: currentRarity.horizontalCenter
        margin-top: 1
        font: small-9px
        color: #c0c0c0
        text-auto-resize: true

      Label
        id: targetSub
        !text: tr('TARGET')
        anchors.top: targetRarity.bottom
        anchors.horizontalCenter: targetRarity.horizontalCenter
        margin-top: 1
        font: small-9px
        color: #c0c0c0
        text-auto-resize: true

    // --- Materials ---
    Label
      id: materialsTitle
      !text: tr('REQUIRED MATERIALS')
      anchors.top: emptyState.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      font: verdana-11px-rounded
      color: #c0c0c0
      text-auto-resize: true

    Panel
      id: materialsPanel
      anchors.top: materialsTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 14
      margin-right: 14
      height: 100
      phantom: false
      background-color: #00000055
      border-width: 1
      border-color: #ffffff33

      Panel
        id: materialsList
        anchors.fill: parent
        margin: 6
        layout:
          type: verticalBox
          spacing: 3

    // --- Refinement info ---
    Panel
      id: infoPanel
      anchors.top: materialsPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 14
      margin-right: 14
      height: 56
      phantom: true

      Label
        id: xpGainLabel
        !text: tr('')
        anchors.top: parent.top
        anchors.left: parent.left
        font: verdana-11px-rounded
        color: #00BC00
        text-auto-resize: true

      Label
        id: effLabel
        !text: tr('')
        anchors.top: xpGainLabel.bottom
        anchors.left: parent.left
        margin-top: 2
        font: small-9px
        color: #c0c0c0
        text-auto-resize: true

      Label
        id: resultLabel
        !text: tr('')
        anchors.top: parent.top
        anchors.right: parent.right
        font: verdana-11px-rounded
        color: #dfdfdf
        text-auto-resize: true

    Button
      id: refineButton
      !text: tr('REFINE')
      anchors.top: infoPanel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6
      width: 160
      height: 30
      enabled: false

  // ==================== RIGHT: PROFESSION ====================
  Panel
    id: professionPanel
    anchors.top: xpLabel.bottom
    anchors.bottom: statusPanel.top
    anchors.right: parent.right
    width: 236
    margin-top: 10
    margin-right: 10
    margin-bottom: 8
    phantom: false
    background-color: #00000055
    border-width: 1
    border-color: #ffffff33

    Label
      id: profTitle
      !text: tr('BLACKSMITH')
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 6
      font: verdana-11px-rounded
      color: #dfdfdf
      text-auto-resize: true

    ScrollablePanel
      id: profScroll
      anchors.top: profTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 6
      padding-right: 14
      vertical-scrollbar: profScrollBar
      layout:
        type: verticalBox
        spacing: 2

    VerticalScrollBar
      id: profScrollBar
      anchors.top: profScroll.top
      anchors.right: profScroll.right
      anchors.bottom: profScroll.bottom
      step: 40
      pixels-scroll: true

  // ==================== BOTTOM: STATUS ====================
  Panel
    id: statusPanel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 30
    margin-left: 10
    margin-right: 10
    margin-bottom: 8
    phantom: false
    background-color: #00000044
    border-width: 1
    border-color: #ffffff22

    Label
      id: statusLabel
      !text: tr('')
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      anchors.right: parent.right
      margin-left: 8
      margin-right: 8
      font: verdana-11px-rounded
      color: #de6f6f
      text-align: center
      text-wrap: true
