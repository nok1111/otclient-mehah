BlacksmithSlot < Item
  size: 64 64
  margin: 2
  phantom: false
  virtual: true
  focusable: true
  item-id: 0
  item-count: 0
  draggable: false
  border-width: 1
  border-color: #ffffff55
  background-color: #00000088

BSGridItem < Item
  size: 40 40
  margin: 1
  phantom: false
  virtual: true
  focusable: false
  draggable: false
  border-width: 1
  border-color: #ffffff33
  background-color: #00000055

  Label
    id: ilvlLabel
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 1
    margin-bottom: 0
    font: small-9px
    color: #dfdfdf
    text-auto-resize: true
    phantom: true

// Infusion tab: slot row (icon + title + desc + action button)
InfSlotRow < Panel
  height: 40
  phantom: false
  border-width: 1
  border-color: #ffffff22
  background-color: #00000066

  UIItem
    id: slotIcon
    size: 30 30
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    virtual: true

  Label
    id: slotTitle
    anchors.left: slotIcon.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 4
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  Label
    id: slotDesc
    anchors.left: slotIcon.right
    anchors.top: slotTitle.bottom
    anchors.right: parent.right
    margin-left: 8
    margin-right: 156
    font: verdana-11px-rounded
    color: #c0c0c0
    text-auto-resize: true

  Button
    id: slotBtn
    width: 70
    height: 20
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6

  Button
    id: slotBtn2
    width: 70
    height: 20
    anchors.right: slotBtn.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6

// Forge tab: one learned-item row in the library (icon + name + tier + craft)
ForgeLibRow < Panel
  height: 40
  phantom: false
  border-width: 1
  border-color: #ffffff22
  background-color: #00000066

  UIItem
    id: libIcon
    size: 30 30
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    virtual: true

  Label
    id: libTitle
    anchors.left: libIcon.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 4
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  Label
    id: libDesc
    anchors.left: libIcon.right
    anchors.top: libTitle.bottom
    anchors.right: parent.right
    margin-left: 8
    margin-right: 84
    font: verdana-11px-rounded
    color: #c0c0c0
    text-auto-resize: true

  Button
    id: libBtn
    width: 70
    height: 20
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6

MaterialRow < Panel
  height: 28
  phantom: true

  Item
    id: matIcon
    size: 26 26
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: false
    virtual: true
    item-id: 0
    draggable: false

  Label
    id: matName
    anchors.left: matIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  Label
    id: matCount
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  Label
    id: matMark
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 60
    font: verdana-11px-rounded
    color: #00BC00
    text-auto-resize: true

// Forge commission: slider with a visible framed track (progressbar image as trough)
ForgeSlider < HorizontalScrollBar
  height: 16
  background-color: #00000066
  image-source: /images/ui/progressbar
  image-border: 1

// Forge commission: gold fee row (coin image + fee label + owned count)
FeeRow < Panel
  height: 28
  phantom: true

  UIWidget
    id: feeIcon
    size: 22 22
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    image-source: /images/icons/gold_coin
    image-smooth: true

  Label
    id: feeName
    anchors.left: feeIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  Label
    id: feeCount
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

// Materials tab: inventory material row (icon + name + owned count)
BSMatRow < Panel
  height: 26
  phantom: true

  Item
    id: matItemIcon
    size: 24 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: false
    virtual: true
    item-id: 0
    draggable: false

  Label
    id: matItemName
    anchors.left: matItemIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  Label
    id: matItemCount
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    font: verdana-11px-rounded
    color: #c0c0c0
    text-auto-resize: true

// Materials tab: smelting recipe row
BSSmeltRow < Panel
  height: 42
  phantom: true

  Item
    id: smeltOreIcon
    size: 30 30
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    phantom: false
    virtual: true
    item-id: 0
    draggable: false

  Label
    id: smeltOreLabel
    anchors.left: smeltOreIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    font: small-9px
    color: #dfdfdf
    text-auto-resize: true

  Item
    id: smeltFuelIcon
    size: 30 30
    anchors.left: smeltOreLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 14
    phantom: false
    virtual: true
    item-id: 0
    draggable: false

  Label
    id: smeltFuelLabel
    anchors.left: smeltFuelIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    font: small-9px
    color: #dfdfdf
    text-auto-resize: true

  Label
    id: smeltArrow
    !text: tr('->')
    anchors.left: smeltFuelLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    font: verdana-11px-rounded
    color: #80c7f8
    text-auto-resize: true

  Item
    id: smeltResultIcon
    size: 30 30
    anchors.left: smeltArrow.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    phantom: false
    virtual: true
    item-id: 0
    draggable: false

  Label
    id: smeltResultLabel
    anchors.left: smeltResultIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    font: small-9px
    color: #dfdfdf
    text-auto-resize: true

  Button
    id: smeltButton
    !text: tr('FORGE')
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    width: 70
    height: 24

  Label
    id: smeltInfo
    anchors.right: smeltButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    font: small-9px
    color: #00BC00
    text-auto-resize: true

// Specialization tab: one card per spec
BSSpecCard < Panel
  size: 210 190
  phantom: false
  background-color: #00000055
  border-width: 1
  border-color: #ffffff33

  Item
    id: specIcon
    size: 40 40
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    phantom: false
    virtual: true
    item-id: 0
    draggable: false

  Label
    id: specName
    anchors.top: specIcon.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    font: verdana-11px-rounded
    color: #80c7f8
    text-auto-resize: true

  Label
    id: specCat
    anchors.top: specName.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    font: small-9px
    color: #c0c0c0
    text-auto-resize: true

  Label
    id: specPerks
    anchors.top: specCat.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    margin-left: 12
    margin-right: 12
    height: 38
    font: small-9px
    color: #dfdfdf
    text-align: center
    text-wrap: true

  Button
    id: specButton
    !text: tr('SELECT')
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 8
    width: 130
    height: 24

BSTabButton < Button
  height: 34
  font: verdana-11px-rounded

// Progression tab: section header
BSSectionTitle < Label
  font: verdana-11px-rounded
  color: #80c7f8
  text-auto-resize: true
  margin-top: 6

// Progression tab: stat card (value over caption)
BSStatCard < Panel
  size: 190 54
  phantom: false
  background-color: #00000055
  border-width: 1
  border-color: #ffffff33

  Label
    id: statValue
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 9
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  Label
    id: statName
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 7
    font: small-9px
    color: #c0c0c0
    text-auto-resize: true

// Progression tab: requirement row (mark + label + status)
BSTierRow < Panel
  height: 26
  phantom: true
  background-color: #00000033
  border-width: 1
  border-color: #ffffff22

  Label
    id: rowMark
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    width: 14
    font: verdana-11px-rounded
    color: #00BC00

  Label
    id: rowName
    anchors.left: rowMark.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  Label
    id: rowReq
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    font: small-9px
    color: #c0c0c0
    text-auto-resize: true

// Progression tab: mastery milestone chip
BSMilestoneChip < Panel
  size: 66 22
  phantom: true
  background-color: #00000033
  border-width: 1
  border-color: #ffffff33

  Label
    id: chipLabel
    anchors.centerIn: parent
    font: small-9px
    color: #dfdfdf
    text-auto-resize: true

MainWindow
  id: blacksmithWindow
  !text: tr('Blacksmith')
  size: 940 560
  @onEscape: Blacksmith.hide()

  // ==================== HEADER ====================
  Label
    id: headerLevel
    !text: tr('Level 0')
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
    margin-right: 12
    font: verdana-11px-rounded
    color: #80c7f8
    text-auto-resize: true

  Label
    id: headerRank
    !text: tr('Novice')
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 6
    font: verdana-11px-rounded
    color: #dfdfdf
    text-auto-resize: true

  ProgressBar
    id: xpBar
    anchors.top: headerRank.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 3
    width: 300
    height: 12

  Label
    id: xpLabel
    !text: tr('0 / 0 XP')
    anchors.top: xpBar.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    font: small-9px
    color: #c0c0c0
    text-auto-resize: true

  // ==================== SIDEBAR TABS ====================
  Panel
    id: sideBar
    anchors.top: xpLabel.bottom
    anchors.bottom: statusPanel.top
    anchors.left: parent.left
    width: 104
    margin-top: 10
    margin-left: 8
    margin-bottom: 8
    phantom: false
    background-color: #00000055
    border-width: 1
    border-color: #ffffff33

    BSTabButton
      id: tabCraft
      !text: tr('Craft')
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 6
      margin-right: 6

    BSTabButton
      id: tabStudy
      !text: tr('Study')
      anchors.top: tabCraft.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 6
      margin-right: 6

    BSTabButton
      id: tabRefinement
      !text: tr('Refinement')
      anchors.top: tabStudy.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 6
      margin-right: 6

    BSTabButton
      id: tabMaterials
      !text: tr('Materials')
      anchors.top: tabRefinement.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 6
      margin-right: 6

    BSTabButton
      id: tabProgression
      !text: tr('Progression')
      anchors.top: tabMaterials.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 6
      margin-right: 6

    BSTabButton
      id: tabInfusion
      !text: tr('Infusion')
      visible: false
      anchors.top: tabRefinement.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 6
      margin-right: 6

    BSTabButton
      id: tabSpecialization
      !text: tr('Spec')
      anchors.top: tabProgression.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 6
      margin-right: 6

  // ==================== PAGE: REFINEMENT ====================
  Panel
    id: refinementPage
    anchors.top: xpLabel.bottom
    anchors.bottom: statusPanel.top
    anchors.left: sideBar.right
    anchors.right: parent.right
    margin-top: 10
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    phantom: true

    // LEFT: INVENTORY
    Panel
      id: inventoryPanel
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 296
      phantom: false
      background-color: #00000055
      border-width: 1
      border-color: #ffffff33

      Label
        id: invTitle
        !text: tr('INVENTORY')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        font: verdana-11px-rounded
        color: #dfdfdf
        text-auto-resize: true

      Button
        id: filterAll
        !text: tr('All')
        anchors.top: invTitle.bottom
        anchors.left: parent.left
        margin-top: 6
        margin-left: 8
        width: 56
        height: 20

      Button
        id: filterWeapons
        !text: tr('Weapons')
        anchors.top: invTitle.bottom
        anchors.left: filterAll.right
        margin-top: 6
        margin-left: 4
        width: 66
        height: 20

      Button
        id: filterArmor
        !text: tr('Armor')
        anchors.top: invTitle.bottom
        anchors.left: filterWeapons.right
        margin-top: 6
        margin-left: 4
        width: 56
        height: 20

      Button
        id: filterAccessory
        !text: tr('Access.')
        anchors.top: invTitle.bottom
        anchors.left: filterArmor.right
        margin-top: 6
        margin-left: 4
        width: 60
        height: 20

      Label
        id: invHint
        !text: tr('Click an item to place it in the station.')
        anchors.top: filterAll.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 8
        margin-right: 8
        height: 24
        font: small-9px
        color: #c0c0c0
        text-wrap: true

      ScrollablePanel
        id: invScroll
        anchors.top: invHint.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 6
        padding-right: 14
        vertical-scrollbar: invScrollBar
        border-width: 1
        border-color: #ffffff22
        background-color: #00000033

        Panel
          id: invGrid
          anchors.top: parent.top
          anchors.left: parent.left
          width: 262
          layout:
            type: grid
            cell-size: 42 42
            cell-spacing: 2
            num-columns: 6
            flow: true
            fit-children: true

      VerticalScrollBar
        id: invScrollBar
        anchors.top: invScroll.top
        anchors.right: invScroll.right
        anchors.bottom: invScroll.bottom
        step: 44
        pixels-scroll: true

      Label
        id: invEmpty
        !text: tr('No refinable equipment found.')
        anchors.centerIn: invScroll
        font: small-9px
        color: #dfdfdf88
        text-auto-resize: true

    // CENTER: REFINEMENT
    Panel
      id: centerPanel
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: inventoryPanel.right
      anchors.right: parent.right
      margin-left: 8
      phantom: false
      background-color: #00000044
      border-width: 1
      border-color: #ffffff33

      Label
        id: centerTitle
        !text: tr('REFINEMENT')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        font: verdana-11px-rounded
        color: #dfdfdf
        text-auto-resize: true

      Label
        id: refSub
        !text: tr('Spend bars to raise item level.')
        anchors.top: centerTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2
        font: small-9px
        color: #c0c0c0
        text-auto-resize: true

      // --- Empty state ---
      Panel
        id: emptyState
        anchors.top: refSub.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 190
        margin-top: 6
        phantom: true

        Item
          id: anvilIcon
          size: 64 64
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 24
          phantom: false
          virtual: true
          focusable: false
          draggable: false
          opacity: 0.55
          border-width: 1
          border-color: #ffffff22

        Label
          id: emptyHintLabel
          !text: tr('CLICK AN ITEM')
          anchors.top: anvilIcon.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 8
          font: verdana-11px-rounded
          color: #dfdfdf
          text-auto-resize: true

        Label
          id: emptySubLabel
          !text: tr('Select an eligible item from your inventory on the left to refine it.')
          anchors.top: emptyHintLabel.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 4
          margin-left: 12
          margin-right: 12
          height: 26
          font: small-9px
          color: #c0c0c0
          text-align: center
          text-wrap: true

      // --- Filled state ---
      Panel
        id: filledState
        anchors.top: refSub.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 190
        margin-top: 6
        phantom: true
        visible: false

        BlacksmithSlot
          id: itemSlot
          anchors.top: parent.top
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 8

        Label
          id: itemNameLabel
          !text: tr('')
          anchors.top: itemSlot.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 6
          font: verdana-11px-rounded
          color: #dfdfdf
          text-auto-resize: true

        Label
          id: itemInfoLabel
          !text: tr('')
          anchors.top: itemNameLabel.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 2
          font: small-9px
          color: #c0c0c0
          text-auto-resize: true

        // CURRENT -> TARGET
        Label
          id: currentRarity
          !text: tr('-')
          anchors.top: itemInfoLabel.bottom
          anchors.right: parent.horizontalCenter
          margin-top: 10
          margin-right: 26
          font: verdana-11px-rounded
          color: #dfdfdf
          text-auto-resize: true

        Label
          id: arrowLabel
          !text: tr('>')
          anchors.top: itemInfoLabel.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 10
          font: verdana-11px-rounded
          color: #80c7f8
          text-auto-resize: true

        Label
          id: targetRarity
          !text: tr('-')
          anchors.top: itemInfoLabel.bottom
          anchors.left: parent.horizontalCenter
          margin-top: 10
          margin-left: 26
          font: verdana-11px-rounded
          color: #dfdfdf
          text-auto-resize: true

        Label
          id: currentSub
          !text: tr('CURRENT')
          anchors.top: currentRarity.bottom
          anchors.horizontalCenter: currentRarity.horizontalCenter
          margin-top: 1
          font: small-9px
          color: #c0c0c0
          text-auto-resize: true

        Label
          id: targetSub
          !text: tr('TARGET')
          anchors.top: targetRarity.bottom
          anchors.horizontalCenter: targetRarity.horizontalCenter
          margin-top: 1
          font: small-9px
          color: #c0c0c0
          text-auto-resize: true

        Label
          id: resultLabel
          !text: tr('')
          anchors.top: targetSub.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 12
          font: verdana-11px-rounded
          color: #dfdfdf
          text-auto-resize: true

        Label
          id: statGainLabel
          !text: tr('')
          anchors.top: resultLabel.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-top: 2
          font: verdana-11px-rounded
          color: #00BC00
          text-auto-resize: true

      // --- Materials ---
      Label
        id: materialsTitle
        !text: tr('REQUIRED MATERIALS')
        anchors.top: emptyState.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 4
        font: verdana-11px-rounded
        color: #c0c0c0
        text-auto-resize: true

      Panel
        id: materialsPanel
        anchors.top: materialsTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 14
        margin-right: 14
        height: 100
        phantom: false
        background-color: #00000055
        border-width: 1
        border-color: #ffffff33

        Panel
          id: materialsList
          anchors.fill: parent
          margin: 6
          layout:
            type: verticalBox
            spacing: 3

      // --- Refinement info ---
      Panel
        id: infoPanel
        anchors.top: materialsPanel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        margin-left: 14
        margin-right: 14
        height: 56
        phantom: true

        Label
          id: xpGainLabel
          !text: tr('')
          anchors.top: parent.top
          anchors.left: parent.left
          font: verdana-11px-rounded
          color: #00BC00
          text-auto-resize: true

        Label
          id: effLabel
          !text: tr('')
          anchors.top: xpGainLabel.bottom
          anchors.left: parent.left
          margin-top: 2
          font: small-9px
          color: #c0c0c0
          text-auto-resize: true

      Button
        id: refineButton
        !text: tr('REFINE')
        anchors.top: infoPanel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: -35
        width: 160
        height: 30
        enabled: false

  // ==================== PAGE: MATERIALS ====================
  Panel
    id: materialsPage
    anchors.top: xpLabel.bottom
    anchors.bottom: statusPanel.top
