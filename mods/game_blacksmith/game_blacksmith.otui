              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              font: verdana-11px-rounded
              color: #c0c0c0
              text-auto-resize: true

            Label
              id: cpMax
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
              font: verdana-11px-rounded
              color: #c0c0c0
              text-auto-resize: true

            ForgeSlider
              id: cpSlider
              anchors.left: cpMin.right
              anchors.right: cpMax.left
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 8
              margin-right: 8
              height: 16
              step: 1

          Label
            id: cpLevel
            anchors.top: cpSliderRow.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 4
            font: verdana-11px-rounded
            color: #80c7f8
            text-auto-resize: true

          Label
            id: cpInfo
            anchors.top: cpLevel.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 4
            font: small-9px
            color: #c0c0c0
            text-auto-resize: true

        // --- materials card ---
        Panel
          id: cpMatsCard
          anchors.top: cpLevelCard.bottom
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          margin-bottom: 46
          margin-left: 10
          margin-right: 10
          phantom: false
          background-color: #00000066
          border-width: 1
          border-color: #ffffff33

          Label
            id: cpMatsTitle
            !text: tr('REQUIRED MATERIALS')
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 6
            font: small-9px
            color: #c0c0c0
            text-auto-resize: true

          Panel
            id: cpCosts
            anchors.top: cpMatsTitle.bottom
            anchors.left: parent.left
            anchors.right: parent.right
            margin-top: 6
            margin-left: 10
            margin-right: 10
            height: 0
            phantom: true
            layout:
              type: verticalBox
              spacing: 3
              fit-children: true

        Button
          id: cpCraftBtn
          !text: tr('Forge')
          anchors.bottom: parent.bottom
          anchors.horizontalCenter: parent.horizontalCenter
          margin-bottom: 10
          width: 140
          height: 28

  // ==================== BOTTOM: STATUS ====================
  Panel
    id: statusPanel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 30
    margin-left: 10
    margin-right: 10
    margin-bottom: 8
    phantom: false
    background-color: #00000044
    border-width: 1
    border-color: #ffffff22

    Label
      id: statusLabel
      !text: tr('')
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      anchors.right: closeButton.left
      margin-left: 8
      margin-right: 8
      font: verdana-11px-rounded
      color: #de6f6f
      text-align: center
      text-wrap: true

    Button
      id: closeButton
      !text: tr('Close')
      width: 70
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      margin-right: 6
