RoundedButton < Button
  image-source: /images/ui/button_rounded

NodeButton < Button
  width: 64
  height: 20
  !text: tr('Level up')
  color: #f4ca16
  background-color: #1a152080
  border-width: 1
  border-color: #2a2040
  !tooltip: tr("Ctrl + left click to level up with out confirmation request")

NodeEntry < Panel
  size: 44 44
  image-smooth: true
  phantom: false

NodeEntryBorder < Panel
  size: 50 50
  image-smooth: true
  anchors.centerIn: parent
  phantom: true

NodeEntryLevel < FlatPanel
  margin-top: -27
  text-auto-resize: true
  padding: 4
  color: #a098b0
  background-color: #1a1525
  border-width: 1
  border-color: #2a2040

NodeEntryLevel2D < FlatPanel
  text-auto-resize: true
  padding: 3
  color: #f4ca16
  background-color: #1a1525
  border-width: 1
  border-color: #2a2040

MessageBase < UIWidget
  !text: tr('.')
  text-offset: 0 2
  text-align: top
  color: #f4ca16
  size: 300 220
  image-source: /images/ui/window
  image-border: 6
  image-border-top: 27
  anchors.centerIn: parent
  visible: false

  Button
    id: ConfirmButton
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: 20
    !text: tr("OK")

  Label
    id: Text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom:  ConfirmButton.top
    margin-top: 40
    margin-left: 20
    margin-right: 20
    margin-bottom: 10
    text-align: center
    text-wrap: true

ConfirmMessageBase < UIWidget
  !text: tr('.')
  text-offset: 0 2
  text-align: top
  color: #f4ca16
  size: 300 220
  image-source: /images/ui/window
  image-border: 6
  image-border-top: 27
  anchors.centerIn: parent
  visible: false

  Button
    id: ConfirmButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 20
    margin-right: 20
    !text: tr("Yes")

  Button
    id: CancelButton
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-bottom: 20
    margin-left: 20
    !text: tr("No")

  UIWidget
    id: Text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom:  ConfirmButton.top
    margin-top: 40
    margin-left: 20
    margin-right: 20
    margin-bottom: 10
    text-wrap: true

LockUI < Panel
  anchors.fill: parent
  opacity: 0.6
  phantom: false
  visible: false
  background-color: #8c8c8c

FullLockUI < Panel
  anchors.fill: parent
  opacity: 1
  phantom: false
  visible: false
  background-color: #000000

MainWindow
  id: mainWindow
  !text: tr('Passive Skills')
  size: 900 760

  Button
    id: tabTalents
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 2
    margin-left: 10
    size: 100 22
    !text: tr('Talents')
    color: #f4ca16
    background-color: #1a152080
    border-width: 1
    border-color: #2a2040

  Button
    id: tabAscension
    anchors.top: parent.top
    anchors.left: tabTalents.right
    margin-top: 2
    margin-left: 4
    size: 100 22
    !text: tr('Ascension')
    background-color: #1a152080
    border-width: 1
    border-color: #2a2040

  CheckBox
    id: devModeCheckBox
    anchors.top: parent.top
    anchors.left: tabAscension.right
    margin-top: 4
    margin-left: 8
    size: 90 18
    !text: tr('Dev Mode')
    color: #ff4040
    visible: false

  Button
    id: devSaveButton
    anchors.top: parent.top
    anchors.left: devModeCheckBox.right
    margin-top: 2
    margin-left: 4
    size: 70 22
    !text: tr('Save')
    color: #40ff40
    background-color: #1a152080
    border-width: 1
    border-color: #2a2040
    visible: false

  UIWidget
    id: background
    anchors.fill: internalPanel
    opacity: 0.6
    image-fixed-ratio: true
    image-repeat: false
    image-smooth: true
    border: 1 #f4ca16

  Panel
    id: internalPanel
    anchors.bottom: legendPanel.top
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 30
    margin-bottom: 4
    margin-left: 20
    margin-right: 20
    padding: 4
    layout:
      type: anchor

  Panel
    id: legendPanel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 45
    height: 95
    background-color: #1a152580
    border: 1 #2a2040

    Panel
      id: legendConstellation
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      width: 225
      margin-left: 60

      NodeEntry
        id: legendConstellationIcon
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 12
        size: 36 36
        background-color: #1a1525

        NodeEntryBorder
          id: legendConstellationBorder
          anchors.centerIn: parent
          size: 50 47
          image-source: images/new_borders/star.png

      Label
        id: legendConstellationTitle
        anchors.left: legendConstellationIcon.right
        anchors.top: parent.top
        margin-top: 20
        margin-left: 16
        text-auto-resize: true
        color: #dfdfdf
        !text: tr('Constellation')

      Label
        id: legendConstellationDesc
        anchors.left: legendConstellationIcon.right
        anchors.top: legendConstellationTitle.bottom
        anchors.right: parent.right
        margin-top: 2
        margin-left: 16
        margin-right: 8
        text-wrap: true
        text-auto-resize: true
        text-align: left
        color: #a0a0b0
        !text: tr('Notable passive bonus. Choose wisely.')

    Panel
      id: legendKeystone
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: legendConstellation.right
      width: 225
      margin-left: 60

      NodeEntry
        id: legendKeystoneIcon
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 16
        size: 36 36
        background-color: #1a1525

        NodeEntryBorder
          id: legendKeystoneBorder
          anchors.centerIn: parent
          size: 58 58
          image-source: images/new_borders/keystone.png

      Label
        id: legendKeystoneTitle
        anchors.left: legendKeystoneIcon.right
        anchors.top: parent.top
        margin-top: 20
        margin-left: 16
        text-auto-resize: true
        color: #dfdfdf
        !text: tr('Keystone')

      Label
        id: legendKeystoneDesc
        anchors.left: legendKeystoneIcon.right
        anchors.top: legendKeystoneTitle.bottom
        anchors.right: parent.right
        margin-top: 2
        margin-left: 16
        margin-right: 8
        text-wrap: true
        text-auto-resize: true
        text-align: left
        color: #a0a0b0
        !text: tr('Powerful capstone. One rank only.')

    Panel
      id: legendNexus
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.left: legendKeystone.right
      width: 225
      margin-left: 60

      NodeEntry
        id: legendNexusIcon
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 12
        size: 36 36
        background-color: #1a1525

        NodeEntryBorder
          id: legendNexusBorder
          anchors.centerIn: parent
          size: 50 47
          image-source: images/new_borders/constellation.png

      Label
        id: legendNexusTitle
        anchors.left: legendNexusIcon.right
        anchors.top: parent.top
        margin-top: 20
        margin-left: 16
        text-auto-resize: true
        color: #dfdfdf
        !text: tr('Nexus')

      Label
        id: legendNexusDesc
        anchors.left: legendNexusIcon.right
        anchors.top: legendNexusTitle.bottom
        anchors.right: parent.right
        margin-top: 2
        margin-left: 16
        margin-right: 8
        text-wrap: true
        text-auto-resize: true
        text-align: left
        color: #a0a0b0
        !text: tr('Hybrid bridge between branches.')

  Label
    id: TotalPassivePoints
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 0
    margin-left: 20
    width: 250
    color: #a098b0

  Label
    id: AvaliablePassivePoints
    anchors.bottom: TotalPassivePoints.top
    anchors.left: parent.left
    margin-bottom: 5
    margin-left: 20
    width: 250
    color: #f4ca16

  Button
    id: CloseButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 3
    margin-right: 3
    !text: tr('Close')
    @onClick: self:getParent():hide()

  Button
    id: ApplyButton
    anchors.right: CloseButton.left
    anchors.bottom: parent.bottom
    margin-bottom: 3
    margin-right: 8
    size: 70 22
    color: #40ff40
    background-color: #1a152080
    border-width: 1
    border-color: #2a2040
    !text: tr('Apply')

  Button
    id: ResetButton
    anchors.right: ApplyButton.left
    anchors.bottom: parent.bottom
    margin-bottom: 3
    margin-right: 8
    size: 70 22
    !text: tr('Reset')

  UIScrollArea
    id: ascensionContent
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 30
    margin-bottom: 40
    margin-left: 10
    margin-right: 10
    padding: 8
    visible: false
    layout:
      type: verticalBox
      spacing: 6
      align-top: true
    vertical-scrollbar: ascensionScrollBar

  VerticalScrollBar
    id: ascensionScrollBar
    anchors.top: ascensionContent.top
    anchors.bottom: ascensionContent.bottom
    anchors.right: ascensionContent.right
    margin-right: -12
    pixels-scroll: true
    step: 50
    visible: false

  Label
    id: ascensionParagonLevel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 0
    margin-left: 20
    width: 350
    visible: false

  Button
    id: ascensionCloseButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 3
    margin-right: 20
    !text: tr('Close')
    visible: false
    @onClick: self:getParent():hide()

  Button
    id: ascensionResetButton
    anchors.right: ascensionCloseButton.left
    anchors.bottom: parent.bottom
    margin-bottom: 3
    margin-right: 8
    !text: tr('Reset')
    visible: false

  LockUI
    id: LockUI

  FullLockUI
    id: FullLockUI

  MessageBase
    id: MessageBase

  ConfirmMessageBase
    id: ConfirmMessageBase