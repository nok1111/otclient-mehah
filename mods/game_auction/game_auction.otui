AuctionWindow < MainWindow
  id: auctionWindow
  !text: tr("Auction House")
  size: 640 500
  visible: false
  @onEscape: self:hide()

  Button
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
    margin-right: 6
    text: X
    @onClick: self:getParent():hide()

  Button
    id: openButton
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 8
    margin-left: 8
    text: Refresh
    @onClick: Auction.onRefresh()

  TextEdit
    id: searchEdit
    anchors.left: openButton.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 8
    size: 200 20

  Button
    id: searchButton
    anchors.left: searchEdit.right
    anchors.top: parent.top
    margin-left: 6
    margin-top: 8
    text: Search
    @onClick: Auction.onSearch()


  Panel
    id: contentPane
    anchors.top: openButton.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 8
    size: 590 400

    Panel
      id: tabsRow
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      layout:
        type: anchor

      Button
        id: tabAuction
        text: Auction
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter

      Button
        id: tabMy
        text: My Listings
        anchors.left: tabAuction.right
        margin-left: 6
        anchors.verticalCenter: parent.verticalCenter

    Panel
      id: resultsHeader
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: tabsRow.bottom
      margin-top: 4
      height: 16
      phantom: true
      layout:
        type: anchor
      
      Label
        text: Item
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        color: #cccccc
        phantom: true

      Label
        text: Price
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 16
        color: #cccccc
        phantom: true

    UIScrollArea
      id: browseScroll
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: resultsHeader.bottom
      margin-top: 4
      height: 260
      background-color: #1f1f1fcc
      border: 1 #555555
      vertical-scrollbar: browseVBar

      Panel
        id: browseList
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        margin-right: 14
        layout:
          type: verticalBox
          fit-children: true
          fit-children-last: true

    VerticalScrollBar
      id: browseVBar
      anchors.right: parent.right
      anchors.top: browseScroll.top
      anchors.bottom: browseScroll.bottom
      step: 20
      on: true

    Label
      id: createLabel
      text: Create Listing
      anchors.left: parent.left
      anchors.top: browseScroll.bottom
      margin-top: 6

    Panel
      id: createRow
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 38
      margin-top: 4

      FlatPanel
        id: listItemBg
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 34 34
        background-color: #2a2a2acc
        border: 1 #666666
        phantom: true

      Item
        id: listItemSlot
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 36 36
        virtual: true
        accept-drop: true
        focusable: true
        z-index: 3
        item-id: 0
        item-count: 0
        draggable: false
        tooltip: Drag item here from inventory

      Label
        text: Unit Price:
        anchors.left: listItemSlot.right
        anchors.top: parent.top
        margin-left: 8

      TextEdit
        id: priceEdit
        anchors.left: prev.right
        anchors.top: parent.top
        margin-left: 4
        size: 80 18
        numbers-only: true

      Label
        text: Count:
        anchors.left: priceEdit.right
        anchors.top: parent.top
        margin-left: 8

      HorizontalScrollBar
        id: countSpin
        anchors.left: prev.right
        anchors.top: parent.top
        margin-left: 4
        size: 100 18
        minimum: 1
        maximum: 100
        orientation: horizontal

      Label
        id: countValue
        anchors.left: countSpin.right
        anchors.top: parent.top
        margin-left: 6
        text: 1
        width: 40
        text-align: right

      Button
        id: listButton
        anchors.right: parent.right
        anchors.top: parent.top
        text: List
        @onClick: Auction.onList()

    Panel
      id: actionsRow
      anchors.top: createRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 32
      margin-top: 8

      Button
        id: buyButton
        anchors.left: parent.left
        text: Buy Selected
        @onClick: Auction.onBuy()

      Button
        id: cancelButton
        anchors.left: buyButton.right
        margin-left: 8
        text: Cancel My Selected
        @onClick: Auction.onCancel()


AuctionRow < Panel
  height: 36
  minimum-width: 260
  width: 280
  layout:
    type: anchor
  background-color: #222222ff
  border: 1 #444444
  margin-top: 2
  margin-left: 4
  margin-right: 4
  focusable: true
  
  Panel
    id: sel
    anchors.fill: parent
    background-color: #33557766
    border: 1 #88aaff
    visible: false
    phantom: true
    z-index: 1

  Item
    id: icon
    size: 32 32
    virtual: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    z-index: 2
    margin-left: 2

  Label
    id: name
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: price.left
    margin-left: 6
    text: Item Name
    color: white
    text-auto-resize: false
    wrap: false
    phantom: true

  Label
    id: price
    anchors.right: parent.right
    margin-right: 6
    width: 80
    anchors.verticalCenter: parent.verticalCenter
    text: 0
    color: yellow
    phantom: true


