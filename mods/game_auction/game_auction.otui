AuctionWindow < MainWindow
  id: auctionWindow
  !text: tr("Auction House")
  size: 640 500
  visible: false
  @onEscape: self:hide()

  Button
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
    margin-right: 6
    text: X
    @onClick: self:getParent():hide()

  Button
    id: openButton
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 8
    margin-left: 8
    text: Refresh
    @onClick: Auction.onRefresh()

  TextEdit
    id: searchEdit
    anchors.left: openButton.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 8
    size: 200 20

  Button
    id: searchButton
    anchors.left: searchEdit.right
    anchors.top: parent.top
    margin-left: 6
    margin-top: 8
    text: Search
    @onClick: Auction.onSearch()


  Panel
    id: contentPane
    anchors.top: openButton.bottom
    anchors.left: parent.left
    margin-top: 8
    margin-left: 8
    size: 590 450

    Panel
      id: tabsRow
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      layout:
        type: anchor

      Button
        id: tabAuction
        text: Auction
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter

      Button
        id: tabMy
        text: My Offers
        anchors.left: tabAuction.right
        margin-left: 6
        anchors.verticalCenter: parent.verticalCenter

      Button
        id: tabHistory
        text: History
        anchors.left: tabMy.right
        margin-left: 6
        anchors.verticalCenter: parent.verticalCenter

      Button
        id: tabMail
        text: Mail
        anchors.left: tabHistory.right
        margin-left: 6
        anchors.verticalCenter: parent.verticalCenter

    Panel
      id: resultsHeader
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: tabsRow.bottom
      margin-top: 4
      height: 16
      phantom: true
      layout:
        type: anchor
      
      Label
        text: Item
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        color: #cccccc
        phantom: true

      Label
        text: Price
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 16
        color: #cccccc
        phantom: true

      Label
        id: sellerHeader
        text: Seller
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 242
        color: #cccccc
        phantom: true

    UIScrollArea
      id: browseScroll
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: resultsHeader.bottom
      margin-top: 4
      height: 260
      background-color: #1f1f1fcc
      border: 1 #555555
      vertical-scrollbar: browseVBar

      Panel
        id: browseList
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        margin-right: 14
        layout:
          type: verticalBox
          fit-children: true
          fit-children-last: true

    VerticalScrollBar
      id: browseVBar
      anchors.right: parent.right
      anchors.top: browseScroll.top
      anchors.bottom: browseScroll.bottom
      step: 20
      on: true

    Label
      id: createLabel
      text: Create Listing
      anchors.left: parent.left
      anchors.top: browseScroll.bottom
      margin-top: 6

    Panel
      id: createRow
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 64
      margin-top: 4

      FlatPanel
        id: listItemBg
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 34 34
        background-color: #2a2a2acc
        border: 1 #666666
        phantom: true

      Item
        id: listItemSlot
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 36 36
        virtual: true
        accept-drop: true
        focusable: true
        z-index: 3
        item-id: 0
        item-count: 0
        draggable: false
        tooltip: Drag item here from inventory

      Label
        text: Unit Price:
        anchors.left: listItemSlot.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8

      TextEdit
        id: priceEdit
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        size: 100 18
        numbers-only: true

      Label
        id: counterLabel
        text: Count:
        anchors.left: listItemSlot.right
        anchors.top: priceEdit.bottom
        margin-left: 8
        margin-top: 4

      SpinBox
        id: countSpin
        anchors.left: prev.right
        anchors.top: prev.top
        margin-left: 4
        size: 80 18
        minimum: 1
        maximum: 1
        focusable: true
        read-only: false
        buttons: true
        mouse-scroll: true

      Label
        id: createCostLabel
        anchors.left: listItemSlot.right
        anchors.top: counterLabel.bottom
        margin-left: 8
        margin-top: 4
        text: Total Price:
        color: #dddddd
        z-index: 2
        phantom: false

      Label
        id: createCostValue
        anchors.left: createCostLabel.right
        anchors.top: createCostLabel.top
        margin-left: 2
        width: 50
        text-align: right
        text: 0
        color: #dddddd
        z-index: 2
        phantom: false

      Label
        id: createCostSuffix
        anchors.left: createCostValue.right
        anchors.top: createCostValue.top
        margin-left: 6
        text:  gold
        color: #dddddd
        z-index: 2
        phantom: false

      Button
        id: listButton
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        text: List
        @onClick: Auction.onList()

    Panel
      id: actionsRow
      anchors.top: createRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 32
      margin-top: 8

      Label
        id: buyAmountLabel
        text: Amount:
        anchors.left: parent.left
        anchors.top: parent.top
        visible: false

      SpinBox
        id: buyCountSpin
        anchors.left: prev.right
        anchors.top: parent.top
        margin-left: 4
        size: 80 18
        minimum: 1
        maximum: 1

      Label
        id: buyCostLabel
        anchors.left: buyCountSpin.right
        anchors.top: parent.top
        margin-left: 12
        text: Cost:

      Label
        id: buyCostValue
        anchors.left: buyCostLabel.right
        anchors.top: parent.top
        margin-left: 4
        width: 80
        text-align: right
        text: 0

      Label
        id: buyCostSuffix
        anchors.left: buyCostValue.right
        anchors.top: parent.top
        margin-left: 4
        text:  gold

      Button
        id: buyButton
        anchors.left: buyCostSuffix.right
        margin-left: 12
        text: Buy Selected
        @onClick: Auction.onBuy()

    Panel
      id: historyPanel
      anchors.top: resultsHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      visible: false
      layout:
        type: anchor
      z-index: 3

      Label
        id: historyHeader
        text: Last 50 Sales (Name | Count | Price | Date)
        color: #cccccc
        phantom: false
        height: 16
        margin-bottom: 2

      Panel
        id: historyBody
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: historyHeader.bottom
        anchors.bottom: parent.bottom
        layout:
          type: verticalBox
        z-index: 4
        background-color: #00112266
        border: 1 #224466

        Panel
          id: historyList
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-left: 6
          margin-top: 4
          minimum-height: 40
          layout:
            type: verticalBox
            fit-children: true
            fit-children-last: true
          z-index: 5
          background-color: #11331144
          border: 1 #44aa44

AuctionRow < Panel
  height: 36
  minimum-width: 260
  width: 280
  layout:
    type: anchor
  background-color: #222222ff
  border: 1 #444444
  margin-top: 2
  margin-left: 4
  margin-right: 4
  focusable: true
  
  Panel
    id: sel
    anchors.fill: parent
    background-color: #33557766
    border: 1 #88aaff
    visible: false
    phantom: true
    z-index: 1

  Item
    id: icon
    size: 32 32
    virtual: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    z-index: 2
    margin-left: 2

  Label
    id: name
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: seller.left
    margin-left: 6
    text: Item Name
    color: white
    text-auto-resize: false
    wrap: false
    phantom: true

  Label
    id: seller
    anchors.left: icon.right
    margin-left: 200
    anchors.verticalCenter: parent.verticalCenter
    width: 120
    text: ""
    color: #cccccc
    text-align: right
    phantom: true

  Label
    id: price
    anchors.right: parent.right
    margin-right: 6
    width: 80
    anchors.verticalCenter: parent.verticalCenter
    text: 0
    color: yellow
    phantom: true

  Button
    id: rowCancel
    anchors.right: price.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    text: Remove
    visible: false
    phantom: false


