WikiCategoryItem < Button
  height: 30
  text-align: left
  padding-left: 34
  font: verdana-11px-rounded
  color: #dfdfdf
  background-color: #ffffff08
  border-width-bottom: 1
  border-color-bottom: #ffffff0a
  $hover:
    background-color: #355d8988
    color: #ffffff
  $on:
    background-color: #d4a8432e
    color: #ffd75e
    border-width-left: 3
    border-color-left: #ffd75e

  UIWidget
    id: iconWidget
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 18 18
    margin-left: 9
    image-fixed-ratio: true
    phantom: true

WikiSubCategoryItem < Button
  height: 28
  text-align: left
  padding-left: 15
  font: verdana-11px-rounded
  color: #c0c0c0
  background-color: #ffffff08
  border-width-bottom: 1
  border-color-bottom: #ffffff0a
  $hover:
    background-color: #355d8988
    color: #ffffff
  $on:
    background-color: #d4a8432e
    color: #ffd75e
    border-width-left: 3
    border-color-left: #ffd75e

WikiListItem < Panel
  height: 60
  image-source: /images/ui/windows/card_window_legendary
  image-border: 10
  margin: 3

  Item
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 40 40
    margin-left: 10

  Panel
    id: imageIcon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 40 40
    margin-left: 10
    image-fixed-ratio: true
    visible: false

  Label
    id: name
    anchors.left: icon.right
    anchors.top: parent.top
    anchors.right: parent.right
    margin-left: 10
    margin-top: 8
    font: verdana-11px-rounded
    color: #ffd75e

  Label
    id: description
    anchors.left: icon.right
    anchors.top: name.bottom
    anchors.right: parent.right
    margin-left: 10
    margin-top: 2
    font: verdana-11px-antialised
    color: #c0c0c0
    text-wrap: true
    text-auto-resize: true

WikiPetItem < Panel
  height: 150
  background-color: #ffffff0d
  border-width: 1
  border-color: #ffffff1a
  margin: 3
  padding: 12
  
  UICreature
    id: petOutfit
    anchors.top: parent.top
    anchors.left: parent.left
    size: 64 64
    margin-top: 5
    margin-left: 5
  
  Label
    id: petName
    anchors.top: parent.top
    anchors.left: petOutfit.right
    anchors.right: parent.right
    margin-left: 12
    margin-top: 2
    font: verdana-11px-rounded
    color: #ffd75e
    text-align: left
    height: 20
  
  Label
    id: petRarity
    anchors.top: petName.bottom
    anchors.left: petOutfit.right
    margin-left: 12
    margin-top: 2
    font: verdana-11px-antialised
    color: #aaaaff
    height: 15
  
  Label
    id: petElement
    anchors.top: petRarity.bottom
    anchors.left: petOutfit.right
    margin-left: 12
    margin-top: 2
    font: verdana-11px-antialised
    color: #ffaa55
    height: 15
  
  Label
    id: petCollector
    anchors.top: petElement.bottom
    anchors.left: petOutfit.right
    margin-left: 12
    margin-top: 2
    font: verdana-11px-antialised
    color: #aaffaa
    height: 15
  
  Label
    !text: tr('Special Abilities:')
    id: abilitiesLabel
    anchors.top: petOutfit.bottom
    anchors.left: parent.left
    margin-top: 10
    margin-left: 5
    font: verdana-11px-rounded
    color: #ffffff
    height: 15
  
  Label
    id: petAbilities
    anchors.top: abilitiesLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-left: 5
    margin-right: 5
    margin-bottom: 5
    font: verdana-11px-antialised
    color: #c0c0c0
    text-wrap: true

WikiTextContent < Label
  height: 25
  text-wrap: true
  text-auto-resize: true
  background-color: #ffffff11
  padding: 10
  font: verdana-11px-antialised

WikiRichTextSection < Label
  text-wrap: true
  text-auto-resize: true
  background-color: #00000000
  padding: 10
  font: verdana-11px-antialised
  margin: 2

WikiRichBoldTextSection < Label
  text-wrap: true
  text-auto-resize: true
  background-color: #00000000
  padding: 10
  font: exo-16px-ultra-bold-italic
  margin: 2
  color: #ffd75e

WikiRichImage < UIWidget
  background-color: #00000000
  margin: 2
  image-auto-resize: true
  image-keep-aspect-ratio: true
  image-smooth: true

WikiRichSpacer < Panel
  height: 10
  background-color: #00000000

WikiRichTitle < Label
  text-wrap: true
  text-auto-resize: true
  text-align: center
  background-color: #00000000
  font: eras-16px-bold
  color: #ffd75e
  margin-top: 4
  margin-bottom: 2

WikiRichSubtitle < Label
  text-wrap: true
  text-auto-resize: true
  background-color: #00000000
  font: exo-14px-ultra-bold-italic
  color: #ffaa33
  margin: 2
  margin-top: 6

WikiRichColoredText < Label
  text-wrap: true
  text-auto-resize: true
  background-color: #00000000
  padding-left: 10
  padding-right: 10
  padding-top: 3
  padding-bottom: 3
  font: verdana-11px-antialised
  color: #dfdfdf
  margin: 1

WikiRichDivider < Panel
  height: 5
  image-source: /images/ui/divider_horizontal
  margin-left: 12
  margin-right: 12
  margin-top: 5
  margin-bottom: 5

WikiRichCard < Panel
  height: 58
  image-source: /images/ui/windows/card_window_legendary
  image-border: 10
  margin: 3

  Item
    id: icon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 36 36
    margin-left: 10

  Panel
    id: imageIcon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 36 36
    margin-left: 10
    image-fixed-ratio: true
    visible: false

  Label
    id: name
    anchors.left: icon.right
    anchors.top: parent.top
    anchors.right: parent.right
    margin-left: 10
    margin-top: 8
    font: verdana-11px-rounded
    color: #ffd75e
    text-wrap: true
    text-auto-resize: true

  Label
    id: description
    anchors.left: icon.right
    anchors.top: name.bottom
    anchors.right: parent.right
    margin-left: 10
    margin-top: 2
    margin-right: 8
    font: verdana-11px-antialised
    color: #c0c0c0
    text-wrap: true
    text-auto-resize: true

WikiRichTip < Panel
  height: 40
  background-color: #00BC0014
  border-width: 1
  border-color: #00BC0066
  border-width-left: 3
  border-color-left: #00BC00
  margin: 3

  Label
    id: text
    anchors.fill: parent
    padding: 8
    font: verdana-11px-antialised
    color: #cfeecc
    text-wrap: true
    text-auto-resize: true

WikiRichWarn < Panel
  height: 40
  background-color: #F55E5E14
  border-width: 1
  border-color: #F55E5E66
  border-width-left: 3
  border-color-left: #F55E5E
  margin: 3

  Label
    id: text
    anchors.fill: parent
    padding: 8
    font: verdana-11px-antialised
    color: #ffd8cf
    text-wrap: true
    text-auto-resize: true

WikiSearchResult < Panel
  height: 70
  image-source: /images/ui/windows/card_window_legendary
  image-border: 10
  margin: 3
  padding: 8

  $hover:
    background-color: #355d8955

  Label
    id: resultCategory
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    font: verdana-11px-antialised
    color: #dfdfdf88
    height: 15

  Label
    id: resultName
    anchors.top: resultCategory.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    font: verdana-11px-rounded
    color: #ffd75e
    height: 20

  Label
    id: resultDesc
    anchors.top: resultName.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    font: verdana-11px-antialised
    color: #c0c0c0
    text-wrap: true
    height: 20

WikiButton < Button
  border-width: 1
  border-color: #d4a84366
  color: #ffd75e
  $hover:
    border-color: #ffd75e
    color: #ffffff
  $pressed:
    border-color: #ffd75e
    color: #d4a843

MainWindow
  id: wikiWindow
  !text: tr('Game Wiki')
  size: 900 600
  font: eras-16px-bold
  color: #ffd75e
  @onEscape: modules.game_wiki.hide()

  Panel
    id: leftPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 200
    margin-top: 5
    margin-left: 5
    margin-bottom: 5
    image-source: /images/ui/miniwindow_orange
    image-border: 13
    padding: 2

    Label
      id: categoriesLabel
      !text: tr('CATEGORIES')
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 25
      text-align: center
      font: verdana-11px-rounded
      color: #ffd75e
      background-color: #d4a84322
      border-width-bottom: 1
      border-color-bottom: #d4a84355
      margin: 2
    
    ScrollablePanel
      id: categoryList
      anchors.top: categoriesLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-left: 2
      margin-right: 2
      margin-bottom: 2
      vertical-scrollbar: categoryListScrollBar
      layout:
        type: verticalBox
        spacing: 2
    
    VerticalScrollBar
      id: categoryListScrollBar
      anchors.top: categoryList.top
      anchors.bottom: categoryList.bottom
      anchors.right: parent.right
      step: 14
      pixels-scroll: true

  Panel
    id: subCategoryPanel
    anchors.top: parent.top
    anchors.left: leftPanel.right
    anchors.bottom: parent.bottom
    width: 220
    margin-top: 5
    margin-left: 5
    margin-bottom: 5
    image-source: /images/ui/miniwindow_orange
    image-border: 13
    padding: 2

    Label
      id: subCategoriesLabel
      !text: tr('SUBCATEGORIES')
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 25
      text-align: center
      font: verdana-11px-rounded
      color: #ffd75e
      background-color: #d4a84322
      border-width-bottom: 1
      border-color-bottom: #d4a84355
      margin: 2
    
    ScrollablePanel
      id: subCategoryList
      anchors.top: subCategoriesLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-left: 2
      margin-right: 2
      margin-bottom: 2
      vertical-scrollbar: subCategoryListScrollBar
      layout:
        type: verticalBox
        spacing: 2
    
    VerticalScrollBar
      id: subCategoryListScrollBar
      anchors.top: subCategoryList.top
      anchors.bottom: subCategoryList.bottom
      anchors.right: parent.right
      step: 14
      pixels-scroll: true

  Panel
    id: contentContainer
    anchors.top: parent.top
    anchors.left: subCategoryPanel.right
    anchors.right: parent.right
    anchors.bottom: bottomPanel.top
    margin-top: 5
    margin-left: 5
    margin-right: 5
    margin-bottom: 5
    image-source: /images/ui/miniwindow_orange
    image-border: 13
    padding: 2

    Panel
      id: searchPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 35
      background-color: #d4a84314
      border-width-bottom: 1
      border-color-bottom: #d4a84355
      margin: 2

      UIWidget
        id: searchIcon
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 16 16
        margin-left: 12
        image-source: /images/icons/search.png
        image-fixed-ratio: true
        phantom: true

      TextEdit
        id: searchEdit
        anchors.left: searchIcon.right
        anchors.right: languageButton.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        margin-right: 5
        height: 25
        placeholder: 'Search the wiki...'
        @onTextChange: modules.game_wiki.onSearchTextChange()

      WikiButton
        id: languageButton
        !text: EN
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        width: 50
        height: 25
        margin-right: 10
        @onClick: modules.game_wiki.changeLanguage()
    
    ScrollablePanel
      id: contentPanel
      anchors.top: searchPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-left: 2
      margin-right: 2
      margin-bottom: 2
      vertical-scrollbar: contentScrollBar
      layout:
        type: verticalBox
        spacing: 5
    
    VerticalScrollBar
      id: contentScrollBar
      anchors.top: contentPanel.top
      anchors.bottom: contentPanel.bottom
      anchors.right: parent.right
      step: 14
      pixels-scroll: true

  Panel
    id: bottomPanel
    anchors.left: leftPanel.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 40
    margin-left: 5
    margin-right: 5
    margin-bottom: 5
    image-source: /images/ui/miniwindow_orange
    image-border: 13
    padding: 2

    Label
      id: progressLabel
      !text: tr('Progress')
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 14
      font: verdana-11px-antialised
      color: #c0c0c0

    WikiButton
      id: closeButton
      !text: tr('Close')
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 80
      margin-right: 10
      @onClick: modules.game_wiki.hide()
