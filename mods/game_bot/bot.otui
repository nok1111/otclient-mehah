BotTabBar < TabBar
  tab-spacing: 1
  margin-left: 1
  margin-right: 1
  height: 20

  $on:
    visible: true
    margin-top: 2

  $!on:
    visible: false
    margin-top: -20

BotTabBarPanel < TabBarPanel
BotTabBarButton < TabBarButton
  padding: 4
  padding-right: 5
  text-horizontal-auto-resize: true
  $!first:
    margin-left: 0

BotPanel < ScrollablePanel
  padding-right: 14
  padding-bottom: 5
  vertical-scrollbar: botTabBarScrollBar

  VerticalScrollBar
    id: botTabBarScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    margin-top: 5
    margin-bottom: 5
    margin-right: 2
    pixels-scroll: true

MiniWindow
  id: botWindow
  !text: tr('Bot')
  height: 600
  @onClose: modules.game_bot.onMiniWindowClose()
  &save: true
  &autoOpen: 10

  MiniWindowContents
    Button
      id: enableButton
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      margin-left: 2
      margin-right: 2
      height: 40
      text-align: center
      text-vertical-align: center

      $on:
        text: On
        color: #00AA00

      $!on:
        text: Off
        color: #FF0000

    Label
      id: statusLabel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      text-wrap: true
      text-auto-resize: true
      text-align: center
      !text: tr('Status: waiting')
      margin-left: 3
      margin-right: 3

      $on:
        margin-top: 4

      $!on:
        text:
        margin-top: -13

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 3
      margin-left: 2
      margin-right: 2

    Panel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      id: messages
      layout:
        type: verticalBox
        fit-children: true

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 5
      margin-left: 2
      margin-right: 2

    Panel
      id: tabButtonsPanel
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 75
      margin-top: 5
      layout:
        type: verticalBox
        spacing: 2
      
      Button
        id: combatTabButton
        text: Combat
        height: 22
        
        $on:
          background-color: #2a5a2a
          color: #00ff00
          
        $!on:
          background-color: #1a1a1a
          color: #aaaaaa
        
      Button
        id: healingTabButton
        text: Healing
        height: 22
        
        $on:
          background-color: #2a5a2a
          color: #00ff00
          
        $!on:
          background-color: #1a1a1a
          color: #aaaaaa
        
      Button
        id: supportTabButton
        text: Support
        height: 22
        
        $on:
          background-color: #2a5a2a
          color: #00ff00
          
        $!on:
          background-color: #1a1a1a
          color: #aaaaaa

    Panel
      id: botPanel
      margin-top: 2
      anchors.top: prev.bottom
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
