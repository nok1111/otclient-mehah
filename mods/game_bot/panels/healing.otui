Panel
  id: healingPanelTab
  anchors.fill: parent

  ScrollablePanel
    id: healingPanel
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: healingPanelScrollBar.left
    vertical-scrollbar: healingPanelScrollBar
    margin-bottom: 5
    padding-right: 5
    focusable: true
    enabled: true
    phantom: false
  
    Label
      !text: tr('Healing Settings')
      font: verdana-11px-rounded
      text-align: center
      text-auto-resize: true
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
    
    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 2
      margin-right: 2
    
    Label
      !text: tr('Healing Spell:')
      text-auto-resize: true
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 5
      margin-right: 5
      font: verdana-11px-rounded
    
    CheckBox
      id: healSpellEnabled
      !text: tr('Enabled')
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 10
      margin-right: 5
    
    Button
      id: healSpellButton
      !text: tr('Click to set spell')
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 10
      margin-right: 5
      height: 25
    
    Label
      !text: tr('Use when HP is below:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 10
    
    HorizontalScrollBar
      id: healSpellHpSlider
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 10
      margin-right: 5
      minimum: 0
      maximum: 100
      step: 5
    
    Label
      id: healSpellHpLabel
      text: 60%
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
    
    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 2
      margin-right: 2
    
    Label
      !text: tr('Health Potion:')
      text-auto-resize: true
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 5
      margin-right: 5
      font: verdana-11px-rounded
    
    CheckBox
      id: healthPotionEnabled
      !text: tr('Enabled')
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 10
      margin-right: 5
    
    Button
      id: healthPotionButton
      !text: tr('Click to set item ID')
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 10
      margin-right: 5
      height: 25
    
    Label
      !text: tr('Use when HP is below:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 10
    
    HorizontalScrollBar
      id: healthPotionHpSlider
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 10
      margin-right: 5
      minimum: 0
      maximum: 100
      step: 5
    
    Label
      id: healthPotionHpLabel
      text: 40%
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
    
    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 2
      margin-right: 2
    
    Label
      !text: tr('Mana Potion:')
      text-auto-resize: true
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 5
      margin-right: 5
      font: verdana-11px-rounded
    
    CheckBox
      id: manaPotionEnabled
      !text: tr('Enabled')
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 10
      margin-right: 5
    
    Button
      id: manaPotionButton
      !text: tr('Click to set item ID')
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 10
      margin-right: 5
      height: 25
    
    Label
      !text: tr('Use when MP is below:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 8
      margin-left: 10
    
    HorizontalScrollBar
      id: manaPotionMpSlider
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 10
      margin-right: 5
      minimum: 0
      maximum: 100
      step: 5
    
    Label
      id: manaPotionMpLabel
      text: 70%
      anchors.top: prev.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2

  VerticalScrollBar
    id: healingPanelScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    margin-top: 5
    margin-bottom: 5
    margin-right: 2
    pixels-scroll: true
