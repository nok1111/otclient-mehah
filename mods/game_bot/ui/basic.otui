BotButton < Button
  height: 17
  margin-top: 2

BotSwitch < Button
  margin-top: 2
  height: 17
  image-color: green
  $!on:
    image-color: red

SmallBotSwitch < Button
  margin-top: 2
  height: 15
  image-color: green
  $!on:
    image-color: red

BotLabel < Label
  margin-top: 2
  height: 15
  text-auto-resize: true
  text-align: center
  text-wrap: true

BotItem < Item
  virtual: true
  &selectable: true
  &editable: true

BotTextEdit < TextEdit
  text-align: center
  multiline: false
  height: 20
  focusable: true
  editable: true
  phantom: false

BotSeparator < HorizontalSeparator
  margin-top: 5
  margin-bottom: 3

BotSmallScrollBar < VerticalScrollBar
  step: 14
  pixels-scroll: true
  width: 13

BotPanel < ScrollablePanel
  vertical-scrollbar: botPanelScroll
  phantom: false
  
  BotSmallScrollBar
    id: botPanelScroll
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    pixels-scroll: true
