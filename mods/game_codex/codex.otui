CardObtainedParticles < UIParticles
  effect: card-obtained-effect

CardEffectWidget < UIEffect
  effect-id: 1075
  size: 1000 1000
  anchors.centerIn: parent

CardSuspenseEffect < UIEffect
  effect-id: 889
  size: 600 600
  anchors.centerIn: parent

CardEntry < UIWidget
  size: 48 80
  margin: 5
  phantom: false
  
  UIWidget
    id: cardImage
    anchors.fill: parent
    phantom: true

CollectionCardEntry < CardEntry
  UIWidget
    id: lockIcon
    size: 32 32
    image-source: /images/ui/icon-lock
    anchors.centerIn: parent
    phantom: true
    visible: false

  Label
    id: cardNameLabel
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 17
    text-align: bottom
    font: verdana-11px-rounded
    text-auto-resize: true

  Label
    id: cardLevelLabel
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 17
    margin-left: 19
    font: verdana-11px-rounded
    color: #A020F0
    text-auto-resize: true

  ProgressBar
    id: expBar
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 20
    margin-left: 2
    margin-right: 2
    height: 10
    background-color: #A020F0
    visible: false

  Label
    id: expLabel
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: -2
    font: verdana-11px-rounded
    color: #fdfdfcff
    text-auto-resize: true
    visible: false

UpgradeCardEntry < CardEntry
  Label
    id: cardNameLabel
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 10
    text-align: bottom
    font: verdana-11px-rounded
    text-auto-resize: true

  Label
    id: cardLevelLabel
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: -12
    font: verdana-11px-rounded
    color: #A020F0
    text-auto-resize: true

  ProgressBar
    id: miniExpBar
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 4
    margin-right: 4
    margin-bottom: 2
    height: 6
    background-color: #A020F0
    visible: false

CardLockIcon < UIWidget
  size: 32 32
  image-source: /images/ui/icon-lock
  anchors.centerIn: parent
  phantom: true

CardLevelLabel < Label
  anchors.bottom: parent.bottom
  anchors.horizontalCenter: parent.horizontalCenter
  margin-bottom: 3
  text-auto-resize: true
  font: verdana-11px-rounded

DeckCardEntry < Panel
  height: 60
  phantom: false
  
  UIWidget
    id: cardIcon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    size: 48 80
    margin-left: 5
    phantom: true
  
  Label
    id: cardName
    anchors.left: cardIcon.right
    anchors.top: parent.top
    anchors.right: equipButton.left
    margin-left: 10
    margin-top: 5
    margin-right: 5
    font: verdana-11px-rounded
  
  Label
    id: cardLevel
    anchors.left: cardIcon.right
    anchors.top: cardName.bottom
    margin-left: 10
    margin-top: 2
    color: #ffff00
  
  Button
    id: equipButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 5
    width: 60
    !text: tr('Equip')

  ProgressBar
    id: expBar
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 3
    margin-bottom: 1
    margin-left: 5
    margin-right: 5
    background-color: #A020F0
    visible: false

  Label
    id: expLabel
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 3
    font: verdana-11px-rounded
    color: #A020F0
    text-auto-resize: true
    visible: false

ActiveSlot < Panel
  size: 190 230
  image-source: /images/ui/panel_flat
  image-border: 3
  margin: 5
  phantom: false
  
  UIWidget
    id: slotPlaceholder
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    size: 130 185
    margin-top: 25
    image-source: /images/codex/cards/empty_slot.png
    phantom: true
  
  UIWidget
    id: slotCardImage
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    size: 130 185
    margin-top: 25
    phantom: true
    visible: false
  
  Label
    id: slotLabel
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5
    !text: tr('Slot 1')
    font: verdana-11px-rounded
  
  Label
    id: requirementLabel
    anchors.centerIn: parent
    text-align: center
    text-wrap: true
    font: verdana-11px-rounded
    color: #f57905ff
    visible: false
    width: 160
  
  Button
    id: removeButton
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 8
    width: 90
    !text: tr('Remove')
    visible: false

CrateEntry < Panel
  height: 50
  image-border: 3
  margin-top: 3
  phantom: false

MessageBase < UIWidget
  !text: tr('.')
  text-offset: 0 2
  text-align: top
  color: #f4ca16
  size: 350 220
  image-source: /images/ui/window
  image-border: 6
  image-border-top: 27
  anchors.centerIn: parent
  visible: false

  Button
    id: ConfirmButton
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    margin-bottom: 20
    !text: tr("OK")

  Label
    id: Text
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: ConfirmButton.top
    margin-top: 40
    margin-left: 20
    margin-right: 20
    margin-bottom: 10
    text-align: center
    text-wrap: true

LockUI < Panel
  anchors.fill: parent
  opacity: 0.6
  phantom: false
  visible: false
  background-color: #8c8c8c

MainWindow
  id: mainWindow
  text: CODEX
  size: 1000 800

  // Header with Tabs
  Panel
    id: TabsPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    margin-top: 5
    margin-left: 10
    margin-right: 10

    Button
      id: CollectionTab
      anchors.left: parent.left
      anchors.top: parent.top
      width: 100
      !text: tr('Collection')

    Button
      id: DeckTab
      anchors.left: CollectionTab.right
      anchors.top: parent.top
      margin-left: 5
      width: 100
      !text: tr('Deck')

    Button
      id: CratesTab
      anchors.left: DeckTab.right
      anchors.top: parent.top
      margin-left: 5
      width: 100
      !text: tr('Crates')

    Button
      id: UpgradeTab
      anchors.left: CratesTab.right
      anchors.top: parent.top
      margin-left: 5
      width: 100
      !text: tr('Upgrade')

    Panel
      id: EssencesPanel
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 10
      width: 180
      height: 30
      
      UIWidget
        id: EssenceIcon
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 24 24
        image-source: /images/icons/gem_24px
        
      Label
        id: EssencesLabel
        anchors.left: EssenceIcon.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        text: Codex Essences: 0
        color: #A020F0

  // FILTER PANEL
  Panel
    id: FilterPanel
    anchors.top: TabsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 65
    margin-top: 5
    margin-left: 10
    margin-right: 10
    background-color: #00000080
    image-source: /images/ui/panel_flat
    image-border: 3

    TextEdit
      id: SearchInput
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 10
      margin-top: 8
      width: 200
      height: 22
      !placeholder: tr('Search cards...')
      font: verdana-11px-rounded

    Label
      id: TriggerFilterLabel
      anchors.left: SearchInput.right
      anchors.top: parent.top
      margin-left: 15
      margin-top: 10
      !text: tr('Trigger:')
      font: verdana-11px-rounded
      color: #ffffff

    ComboBox
      id: TriggerFilterDropdown
      anchors.left: TriggerFilterLabel.right
      anchors.top: parent.top
      margin-left: 5
      margin-top: 8
      width: 150
      height: 22
      font: verdana-11px-rounded

    Label
      id: RarityFilterLabel
      anchors.left: TriggerFilterDropdown.right
      anchors.top: parent.top
      margin-left: 15
      margin-top: 10
      !text: tr('Rarity:')
      font: verdana-11px-rounded
      color: #ffffff

    CheckBox
      id: CommonCheckbox
      anchors.left: RarityFilterLabel.right
      anchors.top: parent.top
      margin-left: 5
      margin-top: 8
      width: 80
      !text: tr('Common')
      font: verdana-11px-rounded

    CheckBox
      id: RareCheckbox
      anchors.left: CommonCheckbox.right
      anchors.top: parent.top
      margin-left: 5
      margin-top: 8
      width: 70
      !text: tr('Rare')
      font: verdana-11px-rounded

    CheckBox
      id: EpicCheckbox
      anchors.left: RareCheckbox.right
      anchors.top: parent.top
      margin-left: 5
      margin-top: 8
      width: 70
      !text: tr('Epic')
      font: verdana-11px-rounded

    CheckBox
      id: LegendaryCheckbox
      anchors.left: EpicCheckbox.right
      anchors.top: parent.top
      margin-left: 5
      margin-top: 8
      width: 90
      !text: tr('Legendary')
      font: verdana-11px-rounded

    Label
      id: LevelFilterLabel
      anchors.left: parent.left
      anchors.top: SearchInput.bottom
      margin-left: 10
      margin-top: 8
      !text: tr('Level:')
      font: verdana-11px-rounded
      color: #ffffff

    CheckBox
      id: Level1to3Checkbox
      anchors.left: LevelFilterLabel.right
      anchors.top: SearchInput.bottom
      margin-left: 5
      margin-top: 6
      width: 70
      !text: tr('1-3')
      font: verdana-11px-rounded

    CheckBox
      id: Level4to6Checkbox
      anchors.left: Level1to3Checkbox.right
      anchors.top: SearchInput.bottom
      margin-left: 5
      margin-top: 6
      width: 70
      !text: tr('4-6')
      font: verdana-11px-rounded

    CheckBox
      id: Level7to9Checkbox
      anchors.left: Level4to6Checkbox.right
      anchors.top: SearchInput.bottom
      margin-left: 5
      margin-top: 6
      width: 70
      !text: tr('7-9')
      font: verdana-11px-rounded

    CheckBox
      id: Level10Checkbox
      anchors.left: Level7to9Checkbox.right
      anchors.top: SearchInput.bottom
      margin-left: 5
      margin-top: 6
      width: 70
      !text: tr('Max (10)')
      font: verdana-11px-rounded

    Button
      id: ClearFiltersButton
      anchors.right: parent.right
      anchors.top: parent.top
      margin-right: 10
      margin-top: 8
      width: 100
      height: 22
      !text: tr('Clear Filters')
      font: verdana-11px-rounded

  // COLLECTION PANEL
  Panel
    id: CollectionPanel
    anchors.top: FilterPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 5
    margin-left: 10
    margin-right: 10
    margin-bottom: 40
    visible: false

    // Left side: Card Grid
    UIWidget
      id: CollectionBackground
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 680
      image-source: /images/codex/deck_bg
      margin-top: 30
      image-size: 680 560
      image-fixed-ratio: true
      image-border: 3
      phantom: true
    
    // Pagination Controls
    Panel
      id: PaginationPanel
      anchors.top: parent.top
      anchors.left: parent.left
      width: 680
      height: 30
      background-color: #00000080
      
      Button
        id: PrevPageButton
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        !text: tr('< Previous')
        width: 100
        margin-left: 10
      
      Label
        id: PageInfo
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        !text: tr('Page %s / %s', 1, 1)
        width: 100
        color: #ffffff
      
      Button
        id: NextPageButton
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        !text: tr('Next >')
        width: 100
        margin-right: 10
    
    UIScrollArea
      id: CollectionGrid
      anchors.top: PaginationPanel.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 680
      background-color: alpha
      padding: 10
      margin-top: 5
      layout:
        type: grid
        cell-size: 160 205
        flow: true
      vertical-scrollbar: CollectionScrollBar

    VerticalScrollBar
      id: CollectionScrollBar
      anchors.top: CollectionGrid.top
      anchors.bottom: CollectionGrid.bottom
      anchors.right: CollectionGrid.right
      margin-right: -10
      pixels-scroll: true
      step: 50

    // Right side: Card Details
    Panel
      id: CardDetailsPanel
      anchors.top: parent.top
      anchors.left: CollectionGrid.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 10
      image-source: /images/ui/window
      image-border: 6
      image-border-top: 27
      !text: tr('Card Details')
      text-offset: 0 2
      text-align: top
      
      UIWidget
        id: CardImageHeader
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        size: 160 205
        margin-top: 10
        visible: false
      padding: 15

      Label
        id: CardName
        anchors.top: CardImageHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 10
        !text: tr('Select a card')
        text-align: center
        font: verdana-11px-rounded
        color: #ffffff

      Label
        id: CardLevel
        anchors.top: CardName.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
        !text: tr('Level: -')
        text-align: center
        font: verdana-11px-rounded
        
      ProgressBar
        id: CardExpBar
        anchors.top: CardLevel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 10
        margin-left: 20
        margin-right: 20
        height: 20
        background-color: #A020F0
        percent: 0
        
      Label
        id: CardExpText
        anchors.top: CardExpBar.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
        !text: tr('0 / 0 EXP')
        text-align: center
        font: verdana-11px-rounded
        color: #A020F0

      Label
        id: CardTrigger
        anchors.top: CardExpText.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 15
        !text: tr('Trigger: -')
        text-align: center
        color: #00ffff

      UIScrollArea
        id: CardDescription
        anchors.top: CardTrigger.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: CardStatus.top
        margin-top: 30
        margin-bottom: 10
        padding: 5
        layout:
          type: verticalBox
        vertical-scrollbar: CardDescScrollBar

      VerticalScrollBar
        id: CardDescScrollBar
        anchors.top: CardDescription.top
        anchors.bottom: CardDescription.bottom
        anchors.right: CardDescription.right
        margin-right: -10
        pixels-scroll: true
        step: 30

      Label
        id: CardStatus
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 10
        !text: tr('Status: -')
        text-align: center

  // DECK PANEL
  Panel
    id: DeckPanel
    anchors.top: FilterPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 5
    margin-left: 10
    margin-right: 10
    margin-bottom: 40
    visible: false

    // Left side: Available Cards
    UIScrollArea
      id: AvailableCardsPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 450
      image-source: /images/ui/window
      image-border: 6
      image-border-top: 27
      !text: tr('Available Cards')
      text-offset: 0 2
      text-align: top
      padding-top: 30
      padding-left: 10
      padding-right: 10
      padding-bottom: 10
      layout:
        type: verticalBox
        spacing: 2
      vertical-scrollbar: AvailableCardsScrollBar

    VerticalScrollBar
      id: AvailableCardsScrollBar
      anchors.top: AvailableCardsPanel.top
      anchors.bottom: AvailableCardsPanel.bottom
      anchors.right: AvailableCardsPanel.right
      margin-right: -10
      pixels-scroll: true
      step: 50

    // Right side: Active Slots
    UIScrollArea
      id: ActiveSlotsPanel
      anchors.top: parent.top
      anchors.left: AvailableCardsPanel.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 10
      image-source: /images/ui/window
      image-border: 6
      image-border-top: 27
      !text: tr('Active Deck')
      text-offset: 0 2
      text-align: top
      padding-top: 30
      padding-left: 10
      padding-right: 10
      padding-bottom: 10
      layout:
        type: grid
        cell-size: 200 240
        flow: true
        align-center: true
      vertical-scrollbar: ActiveSlotsScrollBar

    VerticalScrollBar
      id: ActiveSlotsScrollBar
      anchors.top: ActiveSlotsPanel.top
      anchors.bottom: ActiveSlotsPanel.bottom
      anchors.right: ActiveSlotsPanel.right
      margin-right: -10
      pixels-scroll: true
      step: 50

  // CRATES PANEL - NEW DESIGN
  Panel
    id: CratesPanel
    anchors.top: TabsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 5
    margin-left: 10
    margin-right: 10
    margin-bottom: 40
    visible: false

    // Top: Crate Selector (LoL Style)
    Panel
      id: CrateSelectorPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 80
      margin-top: 30
      layout:
        type: horizontalBox
        spacing: 10
        align-center: true

      // Bronze Crate Button
      Button
        id: BronzeCrateButton
        size: 200 156
        !text: tr('BRONZE CRATE')
        icon: /images/codex/bronze
        icon-align: top
        icon-offset: 0 -50
        font: verdana-11px-rounded

      // Silver Crate Button
      Button
        id: SilverCrateButton
        size: 200 156
        !text: tr('SILVER CRATE')
        icon: /images/codex/silver
        icon-align: top
        icon-offset: 0 -50
        font: verdana-11px-rounded

      // Golden Crate Button
      Button
        id: GoldenCrateButton
        size: 200 156
        !text: tr('GOLDEN CRATE')
        icon: /images/codex/golden
        icon-align: top
        icon-offset: 0 -50
        font: verdana-11px-rounded

    // Center: Selected Crate Display
    Panel
      id: CrateDisplayPanel
      anchors.top: CrateSelectorPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: CraftingPanel.top
      margin-top: 25
      margin-bottom: 10
      image-source: /images/ui/windows/card_window_normal
      image-auto-resize: true
      image-border: 10
      padding: 10

      Label
        id: SelectedCrateName
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2
        !text: tr('BRONZE CODEX CRATE')
        text-align: center
        font: verdana-11px-rounded
        color: #FFD700

      Label
        id: CrateOwnedCount
        anchors.top: SelectedCrateName.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 15
        !text: tr('You own: %s', 0)
        text-align: center
        width: 300
        color: #FFFFFF

      Label
        id: DropChancesTitle
        anchors.top: CrateOwnedCount.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 20
        !text: tr('Drop Chances:')
        text-align: center
        font: verdana-11px-rounded
        color: #AAAAAA

      // Probability Bars Container
      Panel
        id: ProbabilityBarsPanel
        anchors.top: DropChancesTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10
        width: 450
        height: 200
        layout:
          type: verticalBox
          spacing: 8
          align-center: true

      Button
        id: OpenCrateButton
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        margin-bottom: 10
        size: 200 30
        !text: tr('OPEN CRATE')
        font: verdana-11px-rounded

    // Bottom: Crafting Info
    Panel
      id: CraftingPanel
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 40
      image-source: /images/ui/window
      image-border: 6
      padding: 10
      layout:
        type: horizontalBox
        spacing: 20
        align-center: true

      Label
        id: CraftingLabel
        !text: tr('Crafting:')
        color: #AAAAAA

      Button
        id: CraftBronzeButton
        size: 150 25
        !text: tr('100 Essences -> Bronze')
        font: verdana-11px-rounded

      Button
        id: CraftSilverButton
        size: 150 25
        !text: tr('200 Essences -> Silver')
        font: verdana-11px-rounded

      Button
        id: CraftGoldenButton
        size: 150 25
        !text: tr('350 Essences -> Golden')
        font: verdana-11px-rounded

  // UPGRADE PANEL
  Panel
    id: UpgradePanel
    anchors.top: FilterPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 5
    margin-left: 10
    margin-right: 10
    margin-bottom: 40
    visible: false

    // Left side: Card Grid
    UIScrollArea
      id: UpgradeCardGrid
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 550
      image-source: /images/ui/window
      image-border: 6
      image-border-top: 27
      !text: tr('Cards')
      text-offset: 0 2
      text-align: top
      padding-top: 35
      padding-left: 10
      padding-right: 10
      padding-bottom: 10
      layout:
        type: grid
        cell-size: 105 145
        flow: true
      vertical-scrollbar: UpgradeGridScrollBar

    VerticalScrollBar
      id: UpgradeGridScrollBar
      anchors.top: UpgradeCardGrid.top
      anchors.bottom: UpgradeCardGrid.bottom
      anchors.right: UpgradeCardGrid.right
      margin-right: -10
      pixels-scroll: true
      step: 50

    // Right side: Selected Card Details
    Panel
      id: UpgradeDetailsPanel
      anchors.top: parent.top
      anchors.left: UpgradeCardGrid.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 10
      image-source: /images/ui/window
      image-border: 6
      image-border-top: 27
      !text: tr('Card Details')
      text-offset: 0 2
      text-align: top
      padding: 20

      UIWidget
        id: UpgradeCardImage
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        size: 160 205
        margin-top: 30
        visible: false

      Label
        id: UpgradeCardName
        anchors.top: UpgradeCardImage.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 20
        !text: tr('Select a card')
        text-align: center
        font: verdana-11px-rounded
        color: #ffffff

      Label
        id: UpgradeCardLevel
        anchors.top: UpgradeCardName.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        !text: tr('Level: -')
        text-align: center
        font: verdana-11px-rounded
        color: #ffff00

      ProgressBar
        id: UpgradeExpBar
        anchors.top: UpgradeCardLevel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 15
        margin-left: 30
        margin-right: 30
        height: 25
        background-color: #A020F0
        percent: 0

      Label
        id: UpgradeExpText
        anchors.top: UpgradeExpBar.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        !text: tr('0 / 0 EXP')
        text-align: center
        font: verdana-11px-rounded
        color: #A020F0

      Label
        id: UpgradeCardDescription
        anchors.top: UpgradeExpText.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 25
        margin-left: 15
        margin-right: 15
        text: -
        text-align: center
        text-wrap: true
        text-auto-resize: true
        font: verdana-11px-rounded
        color: #aaaaaa

      Label
        id: UpgradeNextLevelDescription
        anchors.top: UpgradeCardDescription.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 15
        margin-left: 15
        margin-right: 15
        text: -
        text-align: center
        text-wrap: true
        text-auto-resize: true
        font: verdana-11px-rounded
        color: #66ff66
        visible: false

      Button
        id: FeedExpButton
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        margin-bottom: 30
        size: 200 40
        !text: tr('[ FEED EXP ]')
        font: verdana-11px-rounded
        enabled: false

      Label
        id: MaxLevelLabel
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        margin-bottom: 35
        !text: tr('Max Level')
        text-align: center
        font: verdana-11px-rounded
        color: #888888
        visible: false

  // CARD OBTAINED OVERLAY (Crate opens directly)
  Panel
    id: CardObtainedOverlay
    anchors.fill: parent
    visible: false
    background-color: #000000DD
    focusable: true

    Panel
      id: CardObtainedContent
      anchors.centerIn: parent
      size: 500 600
      image-source: /images/ui/windows/transparent
      image-border: 6
      padding: 40

      Label
        id: CardObtainedTitle
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 20
        !text: tr('CARD OBTAINED!')
        font: verdana-11px-rounded
        color: #FFD700

      // Card Display (starts with opacity 0, clickable)
      UIWidget
        id: ObtainedCardImage
        anchors.top: CardObtainedTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 40
        size: 300 385
        opacity: 0
        focusable: true

      Label
        id: ObtainedCardName
        anchors.top: ObtainedCardImage.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: -52
        text-align: center
        width: 300
        font: verdana-11px-rounded
        font-scale: 1.3
        color: #FFFFFF
        opacity: 0

      Label
        id: ObtainedCardLevel
        anchors.top: ObtainedCardName.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 16
        text-align: center
        font: verdana-11px-rounded
        font-scale: 1.2
        background-color: #353635ff
        color: #00FF00
        opacity: 0

  // ESSENCES BONUS OVERLAY (After card click if bonus exists)
  Panel
    id: EssencesBonusOverlay
    anchors.fill: parent
    visible: false
    background-color: #000000DD
    focusable: true

    Panel
      id: EssencesBonusContent
      anchors.centerIn: parent
      size: 450 550
      image-source: /images/ui/windows/transparent
      image-border: 6
      padding: 40

      Label
        id: EssencesBonusTitle
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 20
        !text: tr('BONUS!')
        font: verdana-11px-rounded
        color: #FFD700

      // Essence Image (starts with opacity 0, clickable)
      UIWidget
        id: BonusEssenceImage
        anchors.top: EssencesBonusTitle.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 40
        size: 260 400
        opacity: 0
        focusable: true

      Label
        id: BonusEssenceAmount
        anchors.top: BonusEssenceImage.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 20
        text-align: center
        font: verdana-11px-rounded
        color: #A020F0

  // Bottom Buttons
  Button
    id: CloseButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-bottom: 3
    margin-right: 10
    !text: tr('Close')
    @onClick: self:getParent():hide()

  LockUI
    id: LockUI

  MessageBase
    id: MessageBase
