MainWindow
  id: passwordModal
  !text: tr('Enter Password')
  size: 280 130
  @onEscape: self:destroy()

  Label
    id: modalLabel
    !text: tr('Password:')
    font: verdana-11px-rounded
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 15
    margin-left: 10
    height: 18

  TextEdit
    id: modalPasswordEdit
    anchors.top: prev.top
    anchors.left: prev.right
    anchors.right: parent.right
    margin-left: 5
    margin-right: 10
    height: 20
    phantom: false
    text-hidden: true

  Button
    id: modalOkButton
    !text: tr('OK')
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 10
    margin-left: 40
    width: 80
    height: 28

  Button
    id: modalCancelButton
    !text: tr('Cancel')
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 10
    width: 80
    height: 28
    @onClick: self:getParent():destroy()
