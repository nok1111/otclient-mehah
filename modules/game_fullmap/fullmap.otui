FullMapWindow < MainWindow
  id: fullMapWindow
  !text: tr('World Map - Press Ctrl+W to toggle')
  size: 1400 900
  @onEscape: modules.game_fullmap.hide()

  UIMap
    id: mapView
    anchors.fill: parent
    margin: 4
    zoom: 11
    max-zoom: 30
    min-zoom: 1

  Panel
    id: controlPanel
    height: 40
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    margin-top: 4
    margin-left: 4
    margin-right: 4
    background-color: #00000088

    Label
      id: positionLabel
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      text: Position: 0, 0, 0
      color: #ffffff

    Label
      id: zoomLabel
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      text: Zoom: 11x
      color: #ffffff

    Button
      id: zoomOutButton
      anchors.left: zoomLabel.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      text: -
      width: 30
      @onClick: modules.game_fullmap.zoomOut()

    Button
      id: zoomInButton
      anchors.left: zoomOutButton.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5
      text: +
      width: 30
      @onClick: modules.game_fullmap.zoomIn()

    Button
      id: maximizeButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 10
      text: Fullscreen
      width: 90
      @onClick: modules.game_fullmap.showFullscreen()

    Button
      id: centerButton
      anchors.right: maximizeButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 5
      text: Center on Player
      width: 120
      @onClick: modules.game_fullmap.centerOnPlayer()

  Panel
    id: npcListPanel
    width: 250
    anchors.top: controlPanel.bottom
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 4
    margin-right: 4
    margin-bottom: 4
    background-color: #00000088

    Label
      id: npcListTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 5
      text: NPCs & Points of Interest
      text-align: center
      color: #ffff00
      font: verdana-11px-rounded

    VerticalScrollBar
      id: npcListScrollBar
      anchors.top: npcListTitle.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-right: 2
      margin-bottom: 5
      step: 14
      pixels-scroll: true

    TextList
      id: npcList
      anchors.top: npcListTitle.bottom
      anchors.left: parent.left
      anchors.right: npcListScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-left: 5
      margin-right: 2
      margin-bottom: 5
      padding: 1
      focusable: false
      vertical-scrollbar: npcListScrollBar

  Button
    id: closeButton
    !text: tr('Close')
    width: 60
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 4
    margin-bottom: 4
    @onClick: modules.game_fullmap.hide()
