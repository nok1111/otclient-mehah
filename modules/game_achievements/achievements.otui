// Achievement Item Widget (Custom widget definition)
AchievementItem < Panel
  height: 105
  background-color: #2a2a2a
  border-width: 1
  border-color: #444444

  // Icon/Visual
  Panel
    id: iconPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 70
    margin: 5

    Item
      id: achievementIcon
      anchors.fill: parent
      phantom: true
      visible: false

    UIWidget
      id: achievementImage
      anchors.fill: parent
      phantom: true
      visible: false

  // Status Icon (top-right corner)
  Label
    id: statusIcon
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 5
    margin-right: 5
    size: 16 16
    text: ?
    text-align: center
    font: verdana-11px-rounded
    color: #c0c0c0

  // Content
  Panel
    id: contentPanel
    anchors.top: parent.top
    anchors.left: iconPanel.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 5
    margin-right: 5

    Label
      id: achievementName
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      text: Achievement Name
      font: verdana-11px-rounded
      color: #FFD700

    Label
      id: achievementPoints
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 5
      margin-right: 5
      text: 0 pts
      font: verdana-11px-rounded
      color: #AAAAAA

    Label
      id: achievementDesc
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      text: Achievement description goes here
      font: verdana-11px-rounded
      color: #CCCCCC
      text-wrap: true

    // Claim Button
    Button
      id: claimButton
      anchors.top: prev.bottom
      anchors.right: parent.right
      width: 70
      height: 20
      margin-top: 8
      margin-right: 5
      !text: tr('Claim')
      visible: false
      enabled: false

    // Progress Bar Background
    Panel
      id: progressBackground
      anchors.top: claimButton.top
      anchors.left: parent.left
      anchors.right: claimButton.left
      margin-left: 80
      margin-right: 5
      height: 18
      background-color: #1a1a1a
      border-width: 1
      border-color: #444444
      
      ProgressBar
        id: progressBar
        anchors.fill: parent
        background-color: #00aa00
        percent: 0
        phantom: false
        border-width: 0
        
      Label
        id: progressLabel
        anchors.centerIn: parent
        text: 0 / 100 (0%)
        font: verdana-11px-rounded
        color: #FFFFFF
        phantom: true

    // Hint Label (how to get achievement)
    Label
      id: hintLabel
      anchors.top: progressBackground.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 80
      text: Hint: Complete the task to earn this achievement
      font: verdana-11px-rounded
      color: #c0c0c0
      text-wrap: true

// Reward Item Widget (outfit card for rewards shop)
RewardItem < Panel
  height: 120
  background-color: #2a2a2a
  border-width: 1
  border-color: #444444

  // Outfit Preview
  UICreature
    id: outfitPreview
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 80
    margin: 8
    phantom: true

  // Content
  Panel
    id: rewardContent
    anchors.top: parent.top
    anchors.left: outfitPreview.right
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 8

    Label
      id: rewardName
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      text: Outfit Name
      font: verdana-11px-rounded
      color: #FFD700

    Label
      id: rewardDesc
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      text: Description
      font: verdana-11px-rounded
      color: #CCCCCC
      text-wrap: true

    Label
      id: rewardCost
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6
      text: Cost: 0 pts
      font: verdana-11px-rounded
      color: #00FF00

    Button
      id: buyButton
      anchors.top: rewardCost.top
      anchors.right: parent.right
      width: 80
      height: 22
      margin-right: 5
      !text: tr('Buy')
      enabled: true

    Label
      id: ownedLabel
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: parent.right
      margin-right: 10
      text: OWNED
      font: verdana-11px-rounded
      color: #44FF44
      visible: false

MainWindow
  !text: tr('Achievements')
  size: 800 600
  @onEscape: self:hide()

  // Header with tabs and stats
  Panel
    id: headerPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40
    background-color: #1a1a1a
    border-width: 1
    border-color: #333333

    // Tab: Achievements
    Button
      id: tabAchievements
      anchors.top: parent.top
      anchors.left: parent.left
      width: 120
      height: 28
      margin-top: 6
      margin-left: 10
      !text: tr('Achievements')
      font: verdana-11px-rounded
      color: #FFD700
      text-align: center
      image-source: /images/ui/buttons/tabbar_button
      image-clip: 0 68 116 34
      image-border: 12
      padding: 2 6 2 6

    // Tab: Rewards
    Button
      id: tabRewards
      anchors.top: parent.top
      anchors.left: prev.right
      width: 120
      height: 28
      margin-top: 6
      margin-left: 5
      !text: tr('Rewards')
      font: verdana-11px-rounded
      color: #dfdfdf
      text-align: center
      image-source: /images/ui/buttons/tabbar_button
      image-clip: 0 0 116 34
      image-border: 12
      padding: 2 6 2 6

      $hover !disabled:
        image-clip: 0 34 116 34

      $pressed:
        image-clip: 0 68 116 34

      $disabled:
        color: #dfdfdf88

    Label
      id: statsLabel
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 10
      margin-right: 15
      width: 300
      text: Completed: 0 | Claimed: 0 | Points: 0
      font: verdana-11px-rounded
      color: #CCCCCC

  // Left panel - Categories
  Panel
    id: categoryPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 170
    margin-top: 5
    margin-left: 5
    margin-bottom: 5
    background-color: #1a1a1a
    border-width: 1
    border-color: #333333

    Label
      id: categoryTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 25
      margin: 5
      text: Categories
      font: verdana-11px-rounded
      color: #FFD700
      text-align: center

    VerticalScrollBar
      id: categoryScrollBar
      anchors.top: categoryTitle.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5
      step: 28
      pixels-scroll: true

    ScrollablePanel
      id: categoryList
      anchors.top: categoryTitle.bottom
      anchors.left: parent.left
      anchors.right: categoryScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-bottom: 5
      vertical-scrollbar: categoryScrollBar
      layout:
        type: verticalBox
        spacing: 2

      Button
        id: cat_all
        height: 26
        margin-top: 5
        margin-left: 5
        margin-right: 5
        !text: tr('All')
        font: verdana-11px-rounded
        color: #dfdfdf
        text-align: center
        image-source: /images/ui/buttons/tabbar_button
        image-clip: 0 0 116 34
        image-border: 12
        padding: 2 6 2 6

        $hover !disabled:
          image-clip: 0 34 116 34

        $pressed:
          image-clip: 0 68 116 34

        $disabled:
          color: #dfdfdf88

      Button
        id: cat_combat
        height: 26
        margin-top: 2
        margin-left: 5
        margin-right: 5
        !text: tr('Combat')
        font: verdana-11px-rounded
        color: #dfdfdf
        text-align: center
        image-source: /images/ui/buttons/tabbar_button
        image-clip: 0 0 116 34
        image-border: 12
        padding: 2 6 2 6

        $hover !disabled:
          image-clip: 0 34 116 34

        $pressed:
          image-clip: 0 68 116 34

        $disabled:
          color: #dfdfdf88

