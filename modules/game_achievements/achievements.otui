        font: verdana-11px-rounded
        color: #00FF00

    VerticalScrollBar
      id: rewardsScrollBar
      anchors.top: rewardsHeader.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      step: 28
      pixels-scroll: true

    ScrollablePanel
      id: rewardsList
      anchors.top: rewardsHeader.bottom
      anchors.left: parent.left
      anchors.right: prev.left
      anchors.bottom: parent.bottom
      margin: 5
      vertical-scrollbar: rewardsScrollBar
      layout:
        type: verticalBox
        spacing: 5

  Button
    id: closeButton
    !text: tr('Close')
    width: 80
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 10
    margin-right: 10

// Achievement Unlock Popup Widget
AchievementPopup < UIWidget
  id: achievementPopup
  size: 450 120
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.top: parent.top
  margin-top: 100
  visible: false
  focusable: false
  phantom: true

  UIWidget
    id: popupBackground
    image-source: /images/dungeons/challenge_completed
    image-repeated: false
    anchors.fill: parent

  Label
    id: popupTitle
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 30
    text: ACHIEVEMENT UNLOCKED!
    font: verdana-11px-rounded
    color: #FFD700
    text-align: center

  Label
    id: popupAchievementName
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 40
    margin-right: 40
    text: Achievement Name
    font: verdana-11px-rounded
    color: #FFFFFF
    text-align: center
    text-wrap: true

  Label
    id: popupPoints
    anchors.top: prev.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 40
    margin-right: 40
    text: +0 points
    font: verdana-11px-rounded
    color: #00FF00
    text-align: center
