MiniWindow
  id: mainoptionspanel
  height: 130
  &panelHeight: 130
  image-source: /images/ui/windows/mainwindow
  on: true


  UIWidget
    id: onPanel
    anchors.fill: parent
    margin-top: 38
    phantom: true

    UIWidget
      id: store

      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      size: 140 20
      phantom: true
      layout:
        type: verticalBox
        cell-size: 140 20
        cell-spacing: 2
        flow: true

    UIWidget
      id: options
      anchors.left: store.left
      anchors.right: store.right
      anchors.top: store.bottom
      anchors.bottom: parent.bottom
      margin-top: 6
      margin-left: 0
      margin-right: 0
      margin-bottom: 0
      phantom: true
      layout:
        type: grid
        cell-size: 68 20
        cell-spacing: 4
        flow: true

    UIWidget
      anchors.top: options.top
      anchors.bottom: options.bottom
      anchors.left: store.right
      margin-left: 5
      phantom: true
      width: 1

    UIWidget
      id: specials
      anchors.left: store.left
      anchors.right: store.right
      anchors.top: options.top
      anchors.bottom: parent.bottom
      margin-top: 0
      margin-left: 0
      margin-right: 0
      margin-bottom: 0
      phantom: true
      layout:
        type: grid
        cell-size: 52 20
        cell-spacing: 4
        flow: true
