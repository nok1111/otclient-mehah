InventoryWindow
  id: mainoptionspanel
  height: 280
  &panelHeight: 280
  image-source: /images/ui/windows/panel_border
  margin-top: 2
  image-border: 50
  padding: 5
  on: true


  UIWidget
    id: onPanel
    anchors.fill: parent
    margin-top: 10
    phantom: true

    UIWidget
      id: topControls
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      size: 140 30
      phantom: true
      layout:
        type: horizontalBox
        cell-size: 68 28
        cell-spacing: 4

    UIWidget
      id: store

      anchors.top: topControls.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 4
      size: 140 104
      phantom: true
      layout:
        type: verticalBox
        cell-size: 140 32
        cell-spacing: 2
        flow: true

    UIWidget
      id: options
      anchors.left: store.left
      anchors.right: store.right
      anchors.top: store.bottom
      anchors.bottom: parent.bottom
      margin-top: 6
      margin-left: 0
      margin-right: 0
      margin-bottom: 0
      phantom: true
      layout:
        type: grid
        cell-size: 68 24
        cell-spacing: 4
        flow: true

    UIWidget
      anchors.top: options.top
      anchors.bottom: options.bottom
      anchors.left: store.right
      margin-left: 5
      phantom: true
      width: 1
