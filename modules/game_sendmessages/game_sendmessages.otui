sendMessagesLabel < Label
  padding: 10
  width: 600
  height: 150
  color: white
  background-color: #000000a0
  font: verdana-14px
  text-align: center
  text-wrap: true
  text-auto-resize: true
  focusable: false
  phantom: true
  modal: false

HeadlessWindow
  id: sendMessages
  size: 300 300
  padding: 3
  image-source: /images/ui/windows/mainwindow
  focusable: false
  draggable: false

  Button
    size: 24 24
    !text: tr('X')
    anchors.top: parent.top
    anchors.right: parent.right
    @onClick: modules.game_sendmessages.closeWindow()

  Label
    id: messageTitle
    !text: tr('Title')
    color: #FFD700
    font: verdana-14px
    text-wrap: true
    text-auto-resize: true
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    width: 300
    text-align: center
    margin-top: 0
    padding: 10

  UIWidget
    id: messagePicture
    anchors.top: messageTitle.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    image-source: /images/tutorial.png
    image-align: center
    image-size: 128 128
    size: 128 128
    margin-top: 15

  Label
    id: messageText
    !text: tr('Description')
    color: white
    font: verdana-12px
    text-wrap: true
    text-auto-resize: true
    anchors.top: messagePicture.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    width: 280
    text-align: center
    margin-top: 15
    padding: 15

  Button
    id: closeButton
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    width: 100
    margin-bottom: 10
    @onClick: modules.game_sendmessages.closeWindow()
