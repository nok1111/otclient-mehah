AskWidget < MainWindow
  size: 200 100
  draggable: true
  !text: tr('Delete task')
  image-source: /images/ui/miniwindow

  Label
    !text: tr('Are you sure?')
    size: 200 34
    text-align: center
    anchors.top: parent.top
    anchors.right: parent.right
    anchors.left: parent.left
    margin-top: 1
    color: #ff3333

  Button
    id: yesButton
    width: 80
    !text: tr('Yes')
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: -5
    @onClick: modules.game_tasklist.yes()

  Button
    id: noButton
    width: 80
    !text: tr('No')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: -5
    @onClick: modules.game_tasklist.no()

RewardItem < UIWidget
  size: 218 34

  Item
    id: rewardItem
    anchors.left: parent.left

  Label
    id: rewardItemCnt
    size: 25 34
    anchors.top: prev.top
    anchors.left: prev.right
    margin-top: 4
    margin-left: 5
    color: white

  Label
    id: rewardItemName
    size: 150 34
    anchors.top: prev.top
    anchors.left: prev.right
    margin-top: 0
    margin-left: 3
    color: white

# Left-list style row for choice rewards (mirrors TaskRecord sizing/anchoring)
ChoiceListItem < UIWidget
  width: 256
  height: 34
  layout:
    type: anchor
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  background: #00000033
  border-width: 1
  border-color: #333333

  Item
    id: rewardItem
    size: 28 28
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 4
    margin-top: 3

  Label
    id: rewardItemCnt
    size: 40 28
    anchors.left: rewardItem.right
    anchors.top: rewardItem.top
    margin-left: 6
    margin-top: 4
    color: white

  Label
    id: rewardItemName
    size: 170 28
    anchors.left: rewardItemCnt.right
    anchors.top: rewardItem.top
    margin-left: 6
    margin-top: 0
    color: #dddddd

# Wrapper used to stack each choice row (mirrors left list container behavior)
ChoiceRowWrapper < Panel
  height: 34
  layout:
    type: anchor
  margin-top: 2

  

TaskRecord < UIWidget
  image-source: /images/taskList/task_item
  width: 256
  height: 54
  @onClick: modules.game_tasklist.onTaskClick(self)

  Label
    id: taskState
    size: 30 30
    image-size: 30 30
    image-source: /images/taskList/0
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 5

  Label
    id: taskLevel
    size: 85 40
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 35
    margin-top: 10
    text-align: left

  Label
    id: taskName
    size: 150 40
    anchors.left: taskLevel.right
    anchors.top: parent.top
    margin-left: 5
    margin-top: 10
    text-align: left

  Label
    id: taskBadge
    size: 44 16
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 6
    margin-top: 4
    text-align: center
    background: #00000055
    color: #ffcc66
    border-width: 1
    border-color: #333333

  Panel
    id: selectedAccent
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    anchors.top: parent.top
    width: 2
    background: #32aaff
    visible: false

  # Progress bar background
  Panel
    id: progressBg
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 6
    margin-left: 34
    margin-right: 6
    margin-bottom: 6
    background: #00000055
    border-width: 1
    border-color: #333333

    Panel
      id: progressFill
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      height: 4
      width: 0
      background: #3cb371

# Collapsible zone grouping templates (top-level)
ZoneHeader < UIWidget
  width: 330
  height: 22
  layout:
    type: anchor
  padding: 3 6 3 6
  margin-top: 4
  background: #000000aa
  border-width: 1
  border-color: #202327
  @onClick: modules.game_tasklist.onZoneHeaderClick(self)

  # subtle gradient polish via top/bottom shade lines
  Panel
    id: shadeTop
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 1
    background: #ffffff22

  Panel
    id: shadeBottom
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 1
    background: #00000055

  Label
    id: zoneCaret
    size: 12 12
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    text: '+'

  Label
    id: zoneTitle
    anchors.left: zoneCaret.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    color: #ffffff

ZoneContent < Panel
  width: 330
  layout:
    type: verticalBox
    fit-children: true
  margin-left: 10
  padding: 4
  background: #00000066
  border-width: 1
  border-color: #202327

TaskRewardsPanel < Panel
  size: 270 230

  ScrollablePanel
    id: rewardItemsPanel
    anchors.fill: parent
    vertical-scrollbar: rewardListScrollBar
    margin-right: 12
    layout:
      type: verticalBox
    border-width: 1
    border-color: #202327
    background: #00000066
    padding: 1

    # Stacking box for list rows (safe verticalBox)
    Panel
      id: rewardItemsBox
      layout:
        type: verticalBox

  VerticalScrollBar
    id: rewardListScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 34
    pixels-scroll: true

TaskListPanel < Panel
  width: 350
  height: 200

  ScrollablePanel
    id: taskListPanel
    anchors.fill: parent
    margin-right: 12
    vertical-scrollbar: taskListScrollBar
    layout:
      type: verticalBox
    border-width: 1
    border-color: #202327
    background: #00000066
    padding: 1

  VerticalScrollBar
    id: taskListScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 14
    pixels-scroll: true

TaskDescription < UIWidget
  size: 330 420
  draggable: false
  image-source: /images/ui/tooltip-blue
  image-repeated: false
  image-fixed-ratio: false
  border-width: 2
  border-color: #000000

  Item
    id: descIcon
    size: 16 16
    image-source: /images/icons/icon_misc
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 5
    margin-left: 5

  Label
    id: taskTitle
    anchors.left: descIcon.right
    anchors.top: parent.top
    anchors.right: parent.right
    height: 20
    text-wrap: true
    margin-left: 5
    margin-top: 5
    color: #ffdd88

  Label
    id: taskTags
    anchors.top: taskTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    color: #AAAAAA
    text-wrap: true
    margin-left: 5
    margin-top: 1

  Label
    !text: tr('Task description:')
    anchors.left: descIcon.right
    anchors.top: taskTags.bottom
    anchors.right: parent.right
    height: 20
    text-wrap: true
    margin-left: 5
    margin-top: 5

  Label
    id: taskDescription
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    color: #3396ff
    text-wrap: true
    text-auto-resize: true
    margin-left: 5
    margin-top: 2
    margin-bottom: 5

  Panel
    id: objectivesDivider
    anchors.top: taskDescription.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 1
    margin-top: 4
    margin-left: 5
    margin-right: 5
    background: #ffffff22

  Item
    id: objectivesIcon
    size: 16 16
    image-source: /images/icons/show_gui_help_grey
    anchors.left: parent.left
    anchors.top: taskDescription.bottom
    margin-left: 5
    margin-top: 10

  Label
    id: taskObjectives
    !text: tr('Objectives:')
    anchors.left: objectivesIcon.right
    anchors.top: objectivesIcon.top
    anchors.right: parent.right
    margin-left: 5
    text-wrap: true

  Label
    id: monsterGoals
    anchors.top: taskObjectives.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    color: #3396ff
    visible: false
    text-wrap: true
    text-auto-resize: true
    margin-left: 5
    margin-top: 5

  Label
    id: itemGoals
    anchors.top: taskObjectives.bottom
    anchors.left: parent.left
    size: 270 30
    color: #3396ff
    visible: false
    text-wrap: true
    text-auto-resize: true
    margin-top: 5
    margin-left: 5

  Label
    id: storageGoals
    anchors.top: taskObjectives.bottom
    anchors.left: parent.left
    size: 270 30
    color: #3396ff
    visible: false
    text-wrap: true
    text-auto-resize: true
    margin-top: 5
    margin-left: 5

  Item
    id: progressIcon
    size: 20 20
    anchors.top: storageGoals.bottom
    image-source: /images/icons/wow_obj
    anchors.left: parent.left
    margin-top: 4
    margin-left: 5

  Label
    id: itemProgress
    !text: tr('Progress:')
    anchors.top: storageGoals.bottom
    anchors.left: progressIcon.left
    width: 60
    visible: true
    margin-top: 8
    margin-left: 20

  Label
    id: itemCnt
    anchors.top: prev.top
    anchors.left: prev.right
    width: 75
    color: #61f296
    margin-left: 5

  Item
    id: hintsIcon
    size: 16 16
    image-source: /images/icons/prey_no_bonus
    anchors.left: parent.left
    anchors.top: prev.bottom
    margin-top: 10
    margin-left: 5

  Label
    !text: tr('Hints:')
    anchors.top: itemProgress.bottom
    anchors.left: hintsIcon.left
    margin-top: 10
    margin-left: 20

  Label
    id: taskHint
    size: 270 30
    anchors.top: prev.top
    anchors.left: prev.right
    color: #f69f32
    text-wrap: true
    text-auto-resize: true
    margin-left: 5

  Item
    id: zoneIcon
    size: 16 16
    image-source: /images/icons/wow_zone
    anchors.left: parent.left
    anchors.top: taskHint.bottom
    margin-top: 10
    margin-left: 5

  Label
    !text: tr('Zone:')
    anchors.top: taskHint.bottom
    anchors.left: zoneIcon.left
    margin-top: 10
    margin-left: 20

  Label
    id: taskZoneName
    size: 270 30
    anchors.top: prev.top
    anchors.left: prev.right
    color: #32f6e6
    text-wrap: true
    margin-left: 5

  Item
    id: sourceIcon
    size: 16 16
    image-source: /images/icons/wow_source
    anchors.left: parent.left
    anchors.top: taskZoneName.bottom
    margin-top: 10
    margin-left: 5

  Label
    !text: tr('Source:')
    anchors.top: taskZoneName.bottom
    anchors.left: sourceIcon.left
    margin-top: 10
    margin-left: 20

  Label
    id: taskSource
    size: 270 30
    anchors.top: prev.top
    anchors.left: prev.right
    color: #f69f32
    text-wrap: true
    margin-left: 5

  Panel
    id: objectivesDivider2
    anchors.top: taskSource.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 1
    margin-top: 4
    margin-left: 5
    margin-right: 5
    background: #ffffff22

  Item
    id: rewardsIcon
    size: 16 16
    image-source: /images/icons/wow_loot
    anchors.left: parent.left
    anchors.top: taskSource.bottom
    margin-top: 10
    margin-left: 5

  Label
    !text: tr('Your rewards:')
    anchors.top: taskSource.bottom
    anchors.left: rewardsIcon.left
    margin-top: 10
    margin-left: 20

  Button
    id: rewardsToggle
    width: 14
    height: 14
    anchors.left: prev.right
    anchors.verticalCenter: prev.verticalCenter
    margin-left: 6
    text: '▼'
    @onClick: modules.game_tasklist.toggleRewards()

  UIWidget
    id: rewardExpIcon
    size: 16 16
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 2
    margin-left: 5
    image-source: /images/topbuttons/experience

  Label
    id: rewardExp
    size: 120 20
    anchors.top: rewardExpIcon.top
    anchors.left: rewardExpIcon.right
    margin-top: 0
    margin-left: 5
    color: #ffffff
    background: #1a1f2a
    border-width: 1
    border-color: #2a3344
    text-align: center

  UIWidget
    id: rewardMoneyIcon
    size: 16 16
    anchors.top: rewardExp.top
    anchors.left: rewardExp.right
    margin-top: 2
    margin-left: 5
    image-source: /images/topbuttons/autoloot

  Label
    id: rewardMoney
    size: 120 20
    anchors.top: rewardMoneyIcon.top
    anchors.left: rewardMoneyIcon.right
    margin-top: 0
    margin-left: 5
    color: #e0c269
    background: #1a1f2a
    border-width: 1
    border-color: #2a3344
    text-align: center

  Label
    id: rewardOutfit
    size: 300 1
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 5
    margin-left: 21
    color: #3396ff

  Label
    id: basicRewardsTitle
    !text: tr('Basic Rewards:')
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 2
    margin-left: 21
    color: #ffcc66

  TaskRewardsPanel
    id: basicRewards
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 5
    margin-right: 5
    height: 98

  Label
    id: choiceRewardsTitle
    !text: tr('Choice Rewards:')
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 6
    margin-left: 21
    color: #ff6666

  TaskRewardsPanel
    id: choiceRewards
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 5
    margin-right: 5
    height: 120

# Choice reward entry with muted default and hover/selected emphasis
ChoiceRewardItem < UIWidget
  size: 218 34
  anchors.left: parent.left
  anchors.right: parent.right
  height: 34
  margin-top: 2
  background: #00000033
  border-width: 1
  border-color: #333333

  $hover:
    background: #2a2f3a
    border-color: #3e4655

  Item
    id: rewardItem
    anchors.left: parent.left

  Label
    id: rewardItemCnt
    size: 25 34
    anchors.top: prev.top
    anchors.left: prev.right
    margin-top: 10
    margin-left: 5
    color: white

  Label
    id: rewardItemName
    size: 150 34
    anchors.top: prev.top
    anchors.left: prev.right
    margin-top: 0
    margin-left: 3
    color: #dddddd

MainWindow
  id: taskListWindow
  !text: tr('Quest Log')
  image-source: /images/ui/miniwindow
  width: 760
  height: 700
  draggable: true
  @onEscape: hide()

  TextEdit
    id: searchBox
    size: 150 22
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 6
    margin-left: 6
    text:
    placeholder: Search quests
    @onTextChange: modules.game_tasklist.onSearchChange(self)

  ComboBox
    id: levelFilter
    size: 120 22
    anchors.top: parent.top
    anchors.left: searchBox.right
    margin-top: 6
    margin-left: 6
    currentIndex: 0
    @onOptionChange: modules.game_tasklist.onStatusFilterChange(self)

  Label
    id: capPill
    anchors.top: parent.top
    anchors.left: levelFilter.right
    anchors.right: collapseAllButton.left
    margin-top: 9
    margin-left: 8
    margin-right: 8
    text: ''
    background: #223344
    color: #dde6ff
    border-width: 1
    border-color: #2a3344
    padding: 2 6 2 6
    text-auto-resize: true

  Button
    id: collapseAllButton
    width: 24
    height: 24
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
    margin-right: 6
    image-source: /images/topbuttons/arrow_up
    image-size: 16 16
    image-fixed-ratio: false
    @onClick: modules.game_tasklist.collapseAllZones()

  Button
    id: expandAllButton
    width: 24
    height: 24
    anchors.top: parent.top
    anchors.right: collapseAllButton.left
    margin-top: 6
    margin-right: 6
    image-source: /images/topbuttons/arrow_down
    image-size: 16 16
    image-fixed-ratio: false
    @onClick: modules.game_tasklist.expandAllZones()

  TaskListPanel
    id: taskList
    anchors.left: parent.left
    anchors.top: searchBox.bottom
    anchors.bottom: parent.bottom
    width: 350
    margin-top: 6
    margin-left: 5
    margin-bottom: 40


  TaskDescription
    id: taskDescriptionWnd
    anchors.left: taskList.right
    anchors.top: searchBox.bottom
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-top: 6
    margin-left: 10
    margin-right: 5
    margin-bottom: 40

  Button
    id: deleteButton
    !text: tr('Delete')
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-bottom: 5
    margin-left: 5
    @onClick: modules.game_tasklist.delete()

  Button
    id: buttonCancel
    width: 65
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 5
    margin-right: 5
    @onClick: hide()