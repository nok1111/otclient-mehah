TasklistRewardItem < UIWidget
  size: 218 34
  # match main UI spacing (no extra padding)

  # Left spacer to keep selection border visible regardless of Item icon size
  Panel
    id: leftInset
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 4
    background: alpha

  Label
    id: rewardItemCnt
    size: 25 34
    anchors.top: leftInset.top
    anchors.left: leftInset.right
    margin-top: 4
    margin-left: 5
    color: white

  Label
    id: rewardItemName
    size: 150 34
    anchors.top: prev.top
    anchors.left: prev.right
    margin-top: 0
    margin-left: 3
    color: white

# Choice reward entry with same size as RewardItem
ChoiceRewardItem < UIWidget
  size: 218 34
  anchors.left: parent.left
  anchors.right: parent.right
  height: 34
  margin-top: 2
  margin-left: 5
  background: #00000033
  border-width: 1
  border-color: #333333
  # match main UI spacing (no extra padding)

  $hover:
    background: #2a2f3a
    border-color: #3e4655

  # Left spacer to keep selection border visible regardless of Item icon size
  Panel
    id: leftInset
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    width: 4
    background: alpha

  Item
    id: rewardItem
    anchors.left: leftInset.right
    size: 28 28
    anchors.top: parent.top
    margin-left: 8
    margin-top: 3

  Label
    id: rewardItemCnt
    size: 25 34
    anchors.top: leftInset.top
    anchors.left: rewardItem.right
    margin-top: 4
    margin-left: 5
    color: white

  Label
    id: rewardItemName
    size: 150 34
    anchors.top: rewardItemCnt.top
    anchors.left: rewardItemCnt.right
    margin-top: 0
    margin-left: 3
    color: white

# Wrapper used to stack each choice row (mirrors left list container behavior)
ChoiceRowWrapper < Panel
  height: 34
  layout:
    type: anchor
  margin-top: 2
  margin-left: 5
  margin-right: 5
  border-width: 1
  border-color: #333333


NpcTaskRecord < UIWidget
  image-source: /images/taskList/task_item
  width: 256
  height: 64
  layout:
    type: anchor
  @onClick: modules.game_tasklist.onNpcUnifiedRowClick(self)

  Panel
    id: selectedAccent
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    anchors.top: parent.top
    width: 2
    background: #32aaff
    visible: false

  UIWidget
    id: taskState
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 6
    margin-top: 6
    size: 16 16

  Label
    id: taskButton
    size: 180 20
    anchors.left: taskState.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 8
    text-align: left
    color: #ffffff

  # Cooldown text (appears under task name for cooldown entries only)
  Label
    id: cooldownText
    anchors.left: taskState.right
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-bottom: 8
    color: #aac3ff
    text-align: left
    text: ""

  Label
    id: taskLevel
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 10
    margin-top: 8
    color: #aac3ff
    text-align: right
    text: ""

  Label
    id: taskBadge
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 10
    margin-bottom: 8
    color: #ffc24a
    text: ""

  Panel
    id: taskProgress
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 8
    margin-left: 8
    margin-right: 8
    margin-bottom: 6
    background: #ffffff14
    visible: false

    Panel
      id: taskProgressBar
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      width: 0
      background: #32aaff

TaskButton < Button
  size: 116 34
  text-offset: 0 0
  image-source: /images/ui/list1
  image-color: #dfdfdf
  image-clip: 0 0 116 34
  image-border: 3
  padding: 5 10 5 10

  $hover !disabled:
    image-clip: 0 34 116 34

  $pressed:
    image-clip: 0 68 116 34
    text-offset: 1 1

NpcTaskButton < Button
  width: 250
  height: 24

NpcTaskWidget < UIWidget
  image-source: /images/ui/list1
  width: 250
  height: 24
  margin-top: 1

  NpcTaskButton
    id: taskButton
    anchors.left: parent.left
    anchors.top: parent.top
    @onClick: modules.game_tasklist.onNpcTaskSelectClick(self)

TaskRewardsPanel < Panel
  size: 270 450

  ScrollablePanel
    id: rewardItemsPanel
    anchors.fill: parent
    vertical-scrollbar: rewardListScrollBar
    margin-right: 12
    layout:
      type: verticalBox
    border-width: 1
    border-color: #202327
    background: #00000066
    padding: 1

    # Stacking box for list rows (safe verticalBox like main UI)
    Panel
      id: rewardItemsBox
      layout:
        type: verticalBox

  VerticalScrollBar
    id: rewardListScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 34
    pixels-scroll: true

NpcTaskListPanel < Panel
  width: 265
  height: 280

  ScrollablePanel
    id: npcTaskListPanel
    anchors.fill: parent
    margin-right: 12
    vertical-scrollbar: npcTaskListScrollBar
    layout:
      type: verticalBox
    border-width: 1
    border-color: #202327
    background: #000000cc
    padding: 1

  VerticalScrollBar
    id: npcTaskListScrollBar
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    step: 24
    pixels-scroll: true


NpcTaskDescription < UIWidget
  size: 420 380
  draggable: false
  image-source: /images/ui/tooltip-blue
  image-repeated: false
  image-fixed-ratio: false
  border-width: 2
  border-color: #000000

  Item
    id: descIcon
    size: 16 16
    image-source: /images/icons/icon_misc
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 5
    margin-left: 5

  Label
    id: taskTitle
    anchors.left: descIcon.right
    anchors.top: parent.top
    anchors.right: parent.right
    height: 20
    text-wrap: true
    margin-left: 5
    margin-top: 5
    color: #ffdd88

  Button
    id: detailsTab
    anchors.top: taskTitle.bottom
    anchors.left: parent.left
    width: 120
    height: 22
    margin-top: 6
    margin-left: 5
    !text: tr('Details')
    background: #1a2332
    border-color: #3a4a5f
    @onClick: modules.game_tasklist.showNpcTaskDetailsTab()

  Button
    id: rewardsTab
    anchors.top: taskTitle.bottom
    anchors.left: detailsTab.right
    width: 120
    height: 22
    margin-top: 6
    margin-left: 4
    !text: tr('Rewards')
    background: #0f141c
    border-color: #2a3344
    @onClick: modules.game_tasklist.showNpcTaskRewardsTab()

  Panel
    id: detailsPanel
    anchors.top: detailsTab.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-left: 5
    margin-right: 5
    margin-bottom: 5
    visible: true

    ScrollablePanel
      id: taskDescriptionScroll
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 120
      vertical-scrollbar: taskDescriptionScrollBar
      margin-top: 2
      border-width: 1
      border-color: #202327
      background: #00000033

      Label
        id: taskDescription
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        color: #3396ff
        text-wrap: true
        text-auto-resize: true
        margin-left: 5
        margin-top: 2
        margin-right: 5

    VerticalScrollBar
      id: taskDescriptionScrollBar
      anchors.top: taskDescriptionScroll.top
      anchors.bottom: taskDescriptionScroll.bottom
      anchors.right: parent.right
      width: 12
      step: 14
      pixels-scroll: true

    Panel
      id: objectivesDivider
      anchors.top: taskDescriptionScroll.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 1
      margin-top: 8
      background: #ffffff22

    Item
      id: objectivesIcon
      size: 16 16
      image-source: /images/icons/show_gui_help_grey
      anchors.left: parent.left
      anchors.top: objectivesDivider.bottom
      margin-top: 8

    Label
      id: taskObjectives
      !text: tr('Objectives:')
      anchors.left: objectivesIcon.right
      anchors.top: objectivesIcon.top
      anchors.right: parent.right
      margin-left: 5
      text-wrap: true

    Label
      id: monsterGoals
      anchors.top: taskObjectives.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      color: #3396ff
      visible: false
      text-wrap: true
      text-auto-resize: true
      margin-top: 5

    Label
      id: itemGoals
      anchors.top: taskObjectives.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      color: #3396ff
      visible: false
      text-wrap: true
      text-auto-resize: true
      margin-top: 5

    Label
      id: storageGoals
      anchors.top: taskObjectives.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      color: #3396ff
      visible: false
      text-wrap: true
      text-auto-resize: true
      margin-top: 5

    Item
      id: progressIcon
      size: 20 20
      anchors.top: storageGoals.bottom
      image-source: /images/icons/wow_obj
      anchors.left: parent.left
      margin-top: 8

    Label
      id: itemProgress
      !text: tr('Progress:')
      anchors.top: storageGoals.bottom
      anchors.left: progressIcon.left
      width: 60
      visible: true
      margin-top: 8
      margin-left: 20

    Label
      id: itemCnt
      anchors.top: prev.top
      anchors.left: prev.right
      width: 75
      color: #61f296
      margin-left: 5

    Item
      id: hintsIcon
      size: 16 16
      image-source: /images/icons/prey_no_bonus
      anchors.left: parent.left
      anchors.top: itemProgress.bottom
      margin-top: 10

    Label
      !text: tr('Hints:')
      anchors.top: itemProgress.bottom
      anchors.left: hintsIcon.left
      margin-top: 10
      margin-left: 20

    Label
      id: taskHint
      anchors.top: prev.top
      anchors.left: prev.right
      anchors.right: parent.right
      color: #f69f32
      text-wrap: true
      text-auto-resize: true
      margin-left: 5

  Panel
    id: rewardsPanel
    anchors.top: detailsTab.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-left: 5
    margin-right: 5
    margin-bottom: 5
    visible: false

    Item
      id: rewardsIcon
      size: 16 16
      image-source: /images/icons/wow_loot
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 8

    Label
      !text: tr('Your rewards:')
      anchors.top: parent.top
      anchors.left: rewardsIcon.left
      margin-top: 8
      margin-left: 20

    UIWidget
      id: rewardExpIcon
      size: 16 16
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 8
      image-source: /images/topbuttons/experience

    Label
      id: rewardExp
      size: 80 20
      anchors.top: rewardExpIcon.top
      anchors.left: rewardExpIcon.right
      margin-top: 0
      margin-left: 5
      color: #ffffff
      background: #1a1f2a
      border-width: 1
      border-color: #2a3344
      text-align: center

    UIWidget
      id: rewardMoneyIcon
      size: 16 16
      anchors.top: rewardExp.top
      anchors.left: rewardExp.right
      margin-top: 2
      margin-left: 5
      image-source: /images/topbuttons/autoloot

    Label
      id: rewardMoney
      size: 80 20
      anchors.top: rewardMoneyIcon.top
      anchors.left: rewardMoneyIcon.right
      margin-top: 0
      margin-left: 5
      color: #e0c269
      background: #1a1f2a
      border-width: 1
      border-color: #2a3344
      text-align: center

    Label
      id: rewardCodex
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      margin-left: 21
      color: #b388ff
      font: verdana-11px-rounded

    Label
      id: rewardOutfit
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 21
      color: #3396ff

    Label
      id: basicRewardsTitle
      !text: tr('Basic Rewards:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 2
      margin-left: 21
      color: #ffcc66

    TaskRewardsPanel
      id: basicRewards
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      margin-left: 0
      margin-right: 0
      border-width: 2
      border-color: #ffffff
      height: 98

    Label
      id: choiceRewardsTitle
      !text: tr('Choice Rewards:')
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6
      margin-left: 21
      color: #ff6666

    TaskRewardsPanel
      id: choiceRewards
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      margin-left: 0
      margin-right: 0
      border-width: 2
      border-color: #ffffff
      height: 140

NpcTaskListWidget < MainWindow
  id: npcTaskListWidget
  !text: tr('World Quests')
  image-source: /images/ui/miniwindow
  width: 600
  height: 640

  # Left pane: NPC task lists (Available, Active, Completed)
  Panel
    id: leftRail
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-left: 8
    margin-bottom: 10
    width: 280
    layout:
      type: verticalBox

    UIWidget
      id: availableHeader
      height: 20
      layout:
        type: anchor
      Label
        id: availableTitle
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        color: #ffffff
        text: 'Available (0)'

    NpcTaskListPanel
      id: npcTaskListAvailable
      height: 120

    UIWidget
      id: inProgressHeader
      height: 20
      layout:
        type: anchor
      Label
        id: inProgressTitle
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        color: #ffffff
        text: 'In Progress (0)'
      Label
        id: inProgressCaret
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        text: '-'
      @onClick: modules.game_tasklist.toggleStatusSection('inprogress')

    NpcTaskListPanel
      id: npcTaskListInProgress
      height: 120

    UIWidget
      id: completedHeader
      height: 20
      layout:
        type: anchor
      Label
        id: completedTitle
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2
        color: #ffffff
        text: 'Completed (0)'
      Label
        id: completedCaret
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        text: '-'
      @onClick: modules.game_tasklist.toggleStatusSection('completed')

    NpcTaskListPanel
      id: npcTaskListCompleted
      height: 120

  # Right pane: NPC task description/details
  NpcTaskDescription
    id: npcTaskDescription
    anchors.top: parent.top
    anchors.left: leftRail.right
    anchors.right: parent.right
    margin-top: 8
    margin-left: 10
    margin-right: 8
    height: 520

  Button
    id: acceptButton
    !text: tr('Accept')
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 10
    margin-bottom: 6
    @onClick: modules.game_tasklist.acceptNpcTask()

  Button
    id: declioneButton
    !text: tr('Close')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 10
    margin-bottom: 6
    @onClick: modules.game_tasklist.declineNpcTask()
