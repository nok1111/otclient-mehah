SpellIcon < UIWidget
  size: 52 52
  image-size: 52 52
  image-source: /images/game/buffs/0
  focusable: false
  draggable: true
  margin-right: 4
  &onMousePress: |
    function(self, mousePos, button)
      if button == MouseRightButton then
        return modules.game_buffs.cooldownSettings(self, mousePos, button)
      end
      return false
    end
  &onDragEnter: |
    function(self, mousePos)
      local window = self:getParent():getParent()
      if window then
        window:breakAnchors()
        window.movingReference = {
          x = mousePos.x - window:getX(),
          y = mousePos.y - window:getY()
        }
        return true
      end
      return false
    end
  &onDragMove: |
    function(self, mousePos, mouseMoved)
      local window = self:getParent():getParent()
      if window and window.movingReference then
        local pos = {
          x = mousePos.x - window.movingReference.x,
          y = mousePos.y - window.movingReference.y
        }
        window:setPosition(pos)
        window:bindRectToParent()
      end
    end

  UIWidget
    id: icon
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 4
    margin-left: 4
    size: 42 42
    image-size: 42 42
    focusable: false
    phantom: true

  UIWidget
    id: count
    focusable: false
    phantom: true
    font: verdana-11px-rounded
    color: #ffffffff
    anchors.top: icon.top
    anchors.right: icon.right
    margin-top: 2
    margin-right: 2
    text-align: topRight
    font-scale: 1.2

BuffProgressRect < UIProgressRect
  background: #000000
  opacity: 0.0
  percent: 100
  focusable: false
  phantom: true

GroupCooldownParticles < UIParticles
  effect: groupcooldown-effect

UIWindow
  id: buffsWindow
  height: 62
  width: 62
  padding: 5
  &save: true
  opacity: 0.9
  border: 0 #ffffffff
  &onMousePress: modules.game_buffs.cooldownSettings
  $hover:
    border: 3 #202e35

  Panel
    id: buffsPanel
    phantom: true
    layout:
      type: horizontalBox
    height: 62
    anchors.fill: parent