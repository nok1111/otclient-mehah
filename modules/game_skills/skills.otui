SkillFirstWidget < UIWidget

SkillButton < UIButton
  height: 21
  margin-bottom: 2
  &onClick: onSkillButtonClick

SmallSkillButton < SkillButton
  height: 14

SkillNameLabel < GameLabel
  font: verdana-11px-monochrome
  anchors.left: parent.left
  anchors.top: parent.top
  anchors.bottom: parent.bottom

SkillValueLabel < GameLabel
  id: value
  font: verdana-11px-monochrome
  text-align: topright
  anchors.right: parent.right
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  anchors.left: prev.left

ImageSkill < UIWidget
  id: icon
  size: 9 9
  width: 9
  margin-top: 13
  anchors.left: parent.left
  anchors.top: parent.top
  phantom: false

RedPercentPanel < ProgressBar
  id: percent
  background-color: red
  height: 5
  margin-top: 15
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  phantom: false

SkillPercentPanel < ProgressBar
  id: percent
  background-color: green
  height: 5
  margin-top: 15
  margin-left: 15
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  phantom: false

SectionLabel < GameLabel
  font: verdana-11px-monochrome
  text-align: center
  height: 14
  margin-top: 3
  margin-bottom: 1

MiniWindow
  id: skillWindow
  !text: tr('Skills')
  height: 150
  icon: /images/topbuttons/skills
  @onOpen: modules.game_skills.onMiniWindowOpen()
  @onClose: modules.game_skills.onMiniWindowClose()
  &save: true

  MiniWindowContents
    padding-left: 5
    padding-right: 5
    layout: verticalBox

    SectionLabel
      !text: tr('CHARACTER')
      color: #FFD700
      margin-top: 2

    SkillButton
      id: experience
      height: 15
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      SkillNameLabel
        !text: tr('Experience')
        color: #a098b0
      SkillValueLabel

    SkillButton
      id: level
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      SkillNameLabel
        !text: tr('Level')
        color: #f4ca16
      SkillValueLabel
        color: #f4ca16
      RedPercentPanel

    SkillButton
      id: fame
      height: 45
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      UIWidget
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top

      SkillNameLabel
        id: label
        anchors.left: parent.left
        text-align: topleft
        !text: tr('Fame level:')
      GameLabel
        id: fameLevel
        font: verdana-11px-monochrome
        !text: tr('0')
        anchors.right: parent.right
        anchors.top: label.top
        anchors.bottom: label.bottom
      RedPercentPanel
        id: famebar
        anchors.top: label.top
        anchors.left: parent.left
        height: 14
        background-color: orange

      GameLabel
        id: famePoints
        font: verdana-11px-monochrome
        !text: tr('0 pts')
        anchors.left: parent.left
        margin-left: 5
        anchors.top: famebar.top
        anchors.bottom: famebar.bottom
    GameLabel
      id: famePointslabel
      font: verdana-11px-monochrome
      !text: tr('Fame Points:')
      margin-top: -12
      GameLabel
        id: famePtsToLvl
        font: verdana-11px-monochrome
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        !text: tr('0')

    HorizontalSeparator
      margin-top: 6
      margin-bottom: 2

    SkillButton
      id: health
      height: 15
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      SkillNameLabel
        !text: tr('Hit Points')
        color: #a098b0
      SkillValueLabel

    SkillButton
      id: mana
      height: 15
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      SkillNameLabel
        !text: tr('Mana')
        color: #a098b0
      SkillValueLabel

    SkillButton
      id: capacity
      height: 15
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      SkillNameLabel
        !text: tr('Capacity')
        color: #a098b0
      SkillValueLabel

    SkillButton
      id: speed
      height: 15
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      SkillNameLabel
        !text: tr('Speed')
        color: #a098b0
      SkillValueLabel

    HorizontalSeparator
      margin-top: 4
      margin-bottom: 2

    SectionLabel
      !text: tr('COMBAT SKILLS')
      color: #ff6060

    SkillButton
      id: magiclevel
      height: 30
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      ImageSkill
        image-source: /images/icons/skill_attack
        image-size: 24 24
        size: 24 24
        margin-top: 2
        margin-left: 2
      SkillNameLabel
        !text: tr('Magic Level')
        color: #a098b0
        anchors.bottom: none
        margin-left: 30
      SkillValueLabel
        anchors.bottom: none
      SkillPercentPanel
        margin-left: 30
        margin-top: 16
        background-color: #cc3030

    SkillButton
      id: skillId2
      height: 30
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      ImageSkill
        image-source: /images/icons/skill_attack
        image-size: 24 24
        size: 24 24
        margin-top: 2
        margin-left: 2
      SkillNameLabel
        !text: tr('Strenght')
        color: #a098b0
        anchors.bottom: none
        margin-left: 30
      SkillValueLabel
        anchors.bottom: none
      SkillPercentPanel
        margin-left: 30
        margin-top: 16
        background-color: #cc3030

    SkillButton
      id: skillId3
      height: 30
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      ImageSkill
        image-source: /images/icons/skill_attack
        image-size: 24 24
        size: 24 24
        margin-top: 2
        margin-left: 2
      SkillNameLabel
        !text: tr('Arcana')
        color: #a098b0
        anchors.bottom: none
        margin-left: 30
      SkillValueLabel
        anchors.bottom: none
      SkillPercentPanel
        margin-left: 30
        margin-top: 16
        background-color: #cc3030

    SkillButton
      id: skillId4
      height: 30
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      ImageSkill
        image-source: /images/icons/skill_attack
        image-size: 24 24
        size: 24 24
        margin-top: 2
        margin-left: 2
      SkillNameLabel
        !text: tr('Distance')
        color: #a098b0
        anchors.bottom: none
        margin-left: 30
      SkillValueLabel
        anchors.bottom: none
      SkillPercentPanel
        margin-left: 30
        margin-top: 16
        background-color: #cc3030

    SkillButton
      id: skillId5
      height: 30
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      ImageSkill
        image-source: /images/icons/skill_attack
        image-size: 24 24
        size: 24 24
        margin-top: 2
        margin-left: 2
      SkillNameLabel
        !text: tr('Defence')
        color: #a098b0
        anchors.bottom: none
        margin-left: 30
      SkillValueLabel
        anchors.bottom: none
      SkillPercentPanel
        margin-left: 30
        margin-top: 16
        background-color: #cc3030

    HorizontalSeparator
      margin-top: 4
      margin-bottom: 2

    SectionLabel
      !text: tr('CRAFTING')
      color: #3060cc

    SkillButton
      id: professionId1
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      SkillNameLabel
        id: label
        !text: tr('Blacksmithing')
        color: #a098b0
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/thunder
        image-size: 9 9
      SkillPercentPanel
        background-color: #3060cc

    SkillButton
      id: professionId2
      background-color: #1a152080
      border-width: 1
