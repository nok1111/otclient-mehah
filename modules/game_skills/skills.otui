      SkillValueLabel
      ImageSkill
        image-source: /images/icons/thunder
        image-size: 9 9
      SkillPercentPanel
        background-color: #3060cc

    HorizontalSeparator
      margin-top: 4
      margin-bottom: 2

    SectionLabel
      !text: tr('SPECIAL STATS')
      color: #60d0ff

    SmallSkillButton
      id: skillId7
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      SkillNameLabel
        !text: tr('Critical Hit Chance')
        color: #a098b0
