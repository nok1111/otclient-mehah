      border-width: 1
      border-color: #2a2040
      SkillNameLabel
        id: label
        !text: tr('Refinery')
        color: #a098b0
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/thunder
        image-size: 9 9
      SkillPercentPanel
        background-color: #3060cc

    SkillButton
      id: professionId4
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      SkillNameLabel
        id: label
        !text: tr('Enchanting')
        color: #a098b0
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/thunder
        image-size: 9 9
      SkillPercentPanel
        background-color: #3060cc

    SkillButton
      id: professionId5
      background-color: #1a152080
      border-width: 1
      border-color: #2a2040
      SkillNameLabel
        id: label
        !text: tr('Mining')
        color: #a098b0
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/thunder
        image-size: 9 9
      SkillPercentPanel
        background-color: #3060cc

    SkillButton
      id: professionId6
