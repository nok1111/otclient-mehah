WhiteDoveBox < CombatBox
  image-source: /images/game/combatmodes/whitedovemode
WhiteHandBox < CombatBox
  image-source: /images/game/combatmodes/whitehandmode
YellowHandBox < CombatBox
  image-source: /images/game/combatmodes/yellowhandmode
RedFistBox < CombatBox
  image-source: /images/game/combatmodes/redfistmode
SafeFightBox < CombatBox
  image-source: /images/game/combatmodes/safefight

StandModeBox < UICheckBox
  size: 20 20
  image-source: /images/inventory/buttons_general
  image-clip: 0 0 20 20
  $checked:
    image-clip: 20 0 20 20

ChaseModeBox < UICheckBox
  size: 20 20
  image-source: /images/inventory/buttons_general
  image-clip: 0 20 20 20
  $checked:
    image-clip: 20 20 20 20

ConditionWidget < UIWidget
  size: 10 10

  $!first:
    margin-left: 2

InventoryWindow
  id: maininventorypanel
  draggable: true
  phantom: false
  image-source: /images/ui/windows/window_header
  height: 380
  margin-top: 2
  image-border: 50
  padding: 5
  &panelHeight: 380
  on: true

  $!on:
    &panelHeight: 62
    height: 62

  UIWidget
    id: onPanel
    anchors.fill: parent
    margin-top: 6
    phantom: true

    Button
      id: changeSize
      image-source: /images/inventory/min_button_small
      image-clip: 0 0 12 12
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 8
      margin-top: 10
      size: 12 12
      @onClick: changeInventorySize()

      $pressed !disabled:
        image-clip: 12 0 12 12

    Button
      id: blessings
      image-source: /images/inventory/button_blessings_grey
      image-clip: 0 0 12 12
      anchors.top: changeSize.top
      anchors.left: changeSize.right
      margin-left: 3
      size: 12 12
      visible: false
      @onClick: modules.game_blessing.toggle()
      $pressed !disabled:
        image-clip: 12 0 12 12

    UIButton
      id: purseButton
      image-source: /images/inventory/purse
      !tooltip: tr('Open purse')
      anchors.left: boots.left
      anchors.bottom: boots.top   
      size: 34 12
      image-clip: 0 0 34 12
      margin-bottom: 3
      visible: false
      @onClick: |
        local purse = g_game.getLocalPlayer():getInventoryItem(InventorySlotPurse)
        if purse then
            g_game.use(purse)
        end

      $on:
        image-clip: 0 12 34 12
      $pressed:
        image-clip: 0 12 34 12

    TopToggleButton
      id: standPosture
      image-source: /images/game/combatmodes/stand
      image-clip: 0 0 20 20
      anchors.right: parent.right
      anchors.top: changeSize.top
      margin-right: 7
      size: 20 20
      @onClick: |
        selectPosture('stand')

      $pressed !disabled:
        image-clip: 0 20 20 20

      $disabled:
        image-clip: 0 20 20 20

    TopToggleButton
      id: followPosture
      image-source: /images/game/combatmodes/chasemode
      image-clip: 0 0 20 20
      anchors.right: standPosture.left
      anchors.top: standPosture.top
      margin-right: 4
      size: 20 20
      @onClick: |
        selectPosture('follow')

      $pressed !disabled:
        image-clip: 0 20 20 20

      $disabled:
        image-clip: 0 20 20 20
    TopToggleButton
      id: pvpToggle
      image-source: /images/game/combatmodes/onPanel
      image-clip: 0 0 44 20
      anchors.right: followPosture.left
      anchors.top: standPosture.top
      margin-right: 4
      size: 44 20
      @onClick: onSetPVPToggle(self, not self:isChecked())

      $pressed !disabled:
        image-clip: 0 20 44 20

      $disabled:
        image-clip: 0 20 44 20

      $checked:
        image-clip: 0 20 44 20

    TopToggleButton
      id: attack
      image-source: /images/game/combatmodes/fightoffensive
      image-clip: 0 0 20 20
      anchors.right: pvpToggle.left
      anchors.top: standPosture.top
      margin-right: 4
      size: 20 20
      @onClick: |
        selectCombat('attack')

      $pressed !disabled:
        image-clip: 0 20 20 20

      $disabled:
        image-clip: 0 20 20 20

    TopToggleButton
      id: defense
      image-source: /images/game/combatmodes/fightdefensive
      image-clip: 0 0 20 20
      anchors.right: attack.left
      anchors.top: attack.top
      margin-right: 4
      size: 20 20
      @onClick: |
        selectCombat('defense')

      $pressed !disabled:
        image-clip: 0 20 20 20

      $disabled:
        image-clip: 0 20 20 20

    TopToggleButton
      id: stop
      !text: tr('Stop')
      anchors.left: defense.left
      anchors.right: standPosture.right
      anchors.bottom: parent.bottom
      margin-bottom: 5
      font: cipsoftFont
      color: #c0c0c0ff
      size: 44 13
      @onClick: |
        g_game.stop()
        g_game.getLocalPlayer():stopAutoWalk()

    Panel
      id: icons
      size: 108 18
      padding: 2

      image-source: /images/ui/containerslot
      image-border: 3
      anchors.left: changeSize.left
      anchors.right: backpack.right
      anchors.bottom: parent.bottom
      anchors.top: stop.top
      margin-bottom: 5
      layout:
        type: horizontalBox

    Label
      id: activeLabel
      !text: tr('ACTIVE')
      text-align: center
      font: cipsoftFont
      color: #ffa500ff
      anchors.top: changeSize.bottom
      anchors.left: changeSize.left
      margin-top: 15
      margin-left: 3
      width: 70
      height: 12

    Panel
      id: activePanel
      image-source: /images/ui/windows/miniwindow_old
      image-border: 3
      anchors.top: activeLabel.bottom
      anchors.left: activeLabel.left
      margin-top: 2
      width: 70
      height: 125

      MainInventoryItem
        id: helmet
        !tooltip: tr('Spell Slot (Active)')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 8
        &slotPosition: {x = 65535, y = 1, z = 0}

      MainInventoryItem
        id: boots
        !tooltip: tr('Boots (Active)')
        anchors.top: helmet.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 5
        &slotPosition: {x = 65535, y = 8, z = 0}

      MainInventoryItem
        id: tools
        !tooltip: tr('Torch (Active)')
        anchors.top: boots.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 5
        &slotPosition: {x = 65535, y = 10, z = 0}

    Label
      id: combatLabel
      !text: tr('COMBAT')
      text-align: center
      font: cipsoftFont
      color: #ffa500ff
      anchors.top: activeLabel.top
      anchors.left: activePanel.right
      margin-left: 10
      width: 70
      height: 12

    Panel
      id: combatPanel
      image-source: /images/ui/windows/miniwindow_old
      image-border: 3
      anchors.top: combatLabel.bottom
      anchors.left: combatLabel.left
      phantom: true
      margin-top: 2
      width: 70
      height: 125

      MainInventoryItem
        id: sword
        !tooltip: tr('Weapon')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 8
        &slotPosition: {x = 65535, y = 6, z = 0}

      MainInventoryItem
        id: shield
        !tooltip: tr('Shield')
        anchors.top: sword.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 5
        &slotPosition: {x = 65535, y = 5, z = 0}

      MainInventoryItem
        id: armor
        !tooltip: tr('Armor')
        anchors.top: shield.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 5
        &slotPosition: {x = 65535, y = 4, z = 0}

    MainInventoryItem
      id: backpack
      !tooltip: tr('Backpack')
      anchors.top: activePanel.bottom
      anchors.left: activePanel.left
      anchors.right: combatPanel.right
      margin-top: 10
      &slotPosition: {x = 65535, y = 3, z = 0}

    MainInventoryItem
      id: ring
      !tooltip: tr('Ring')
      anchors.top: backpack.bottom
      anchors.left: activePanel.left
      margin-top: 8
      &slotPosition: {x = 65535, y = 9, z = 0}

    MainInventoryItem
      id: amulet
      !tooltip: tr('Necklace')
      anchors.top: backpack.bottom
      anchors.right: combatPanel.right
      margin-top: 8
      &slotPosition: {x = 65535, y = 2, z = 0}

    Label
      id: craftingLabel
      !text: tr('CRAFTING')
      text-align: center
      font: cipsoftFont
      color: #ffa500ff
      anchors.top: ring.bottom
      anchors.left: activePanel.left
      anchors.right: combatPanel.right
      margin-top: -5
      height: 12

    Panel
      id: craftingPanel
      image-source: /images/ui/windows/miniwindow_old
      image-border: 3
      anchors.top: craftingLabel.bottom
      anchors.left: craftingLabel.left
      anchors.right: craftingLabel.right
      margin-top: 2
      height: 50

      MainInventoryItem
        id: rune2
        !tooltip: tr('Crafting Rune 2')
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10
        &slotPosition: {x = 65535, y = 13, z = 0}

      MainInventoryItem
        id: rune1
        !tooltip: tr('Crafting Rune 1')
        anchors.top: rune2.top
        anchors.right: rune2.left
        margin-right: 10
        &slotPosition: {x = 65535, y = 12, z = 0}

      MainInventoryItem
        id: rune3
        !tooltip: tr('Crafting Rune 3')
        anchors.top: rune2.top
        anchors.left: rune2.right
        margin-left: 10
        &slotPosition: {x = 65535, y = 14, z = 0}

    Panel
      id: statsPanel
      image-source: /images/ui/panel_flat
      image-border: 3
      image-color: #222222dd
      anchors.top: craftingPanel.bottom
      anchors.left: activePanel.left
      anchors.right: combatPanel.right
      margin-top: 10
      height: 22

      Label
        !text: tr('Soul:')
        font: cipsoftFont
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        color: #aaaaff

      Label
        id: soul
        !text: '100000'
        font: cipsoftFont
        anchors.left: prev.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 3
        color: #ffffff

      Label
        !text: tr('Cap:')
        font: cipsoftFont
        anchors.right: capacity.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 3
        color: #ffaa55

      Label
        id: capacity
        !text: '10000'
        font: cipsoftFont
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 5
        color: #ffffff

    MainInventoryItem
      id: soulPanel
      visible: false
      enabled: false
      &slotPosition: {x = 65535, y = 0, z = 0}

    MainInventoryItem
      id: capacityPanel
      visible: false
      enabled: false
      &slotPosition: {x = 65535, y = 0, z = 0}

    MainInventoryItem
      id: legs
      anchors.top: statsPanel.bottom
      anchors.left: statsPanel.left
      enabled: false
      visible: false
      margin-top: 3
      &slotPosition: {x = 65535, y = 7, z = 0}

  UIWidget
    id: offPanel
    anchors.fill: parent
    phantom: true

    Button
      id: changeSize
      image-source: /images/inventory/max_button_small
      image-clip: 0 0 12 12
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 8
      margin-top: 5
      size: 12 12
      @onClick: changeInventorySize()

      $pressed !disabled:
        image-clip: 12 0 12 12

    MainInventoryItem
      id: soulAndCapacity
      anchors.left: changeSize.right
      anchors.top: changeSize.top
      margin-left: 4
      size: 30 44

      Label
        !text: tr('Cap')
        text.align: center
        font: cipsoftFont
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        color: #c0c0c0ff
        margin-top: 1
        height: 10

      Label
        id: capacity
        !text: '10000'
        font: cipsoftFont
        text-align: center
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        margin-top: 8
        color: #c0c0c0ff

      Label
        !text: tr('Soul')
        text.align: center
        font: cipsoftFont
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        color: #c0c0c0ff
        margin-bottom: 4
        height: 10

      Label
        id: soul
        !text: '100000'
        font: cipsoftFont
        text-align: center
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        margin-bottom: -2
        color: #c0c0c0ff

    TopToggleButton
      id: attack
      image-source: /images/game/combatmodes/fightoffensive
      image-clip: 0 0 20 20
      anchors.left: soulAndCapacity.right
      anchors.top: changeSize.top
      margin-left: 3
      size: 20 20
      @onClick: |
        selectCombat('attack')

      $pressed !disabled:
        image-clip: 0 20 20 20

      $disabled:
        image-clip: 0 20 20 20

    TopToggleButton
      id: defense
      image-source: /images/game/combatmodes/fightdefensive
      image-clip: 0 0 20 20
      anchors.left: attack.right
      anchors.top: changeSize.top
      margin-left: 1
      size: 20 20
      @onClick: |
        selectCombat('defense')

      $pressed !disabled:
        image-clip: 0 20 20 20

      $disabled:
        image-clip: 0 20 20 20


    TopToggleButton
      id: standPosture
      image-source: /images/game/combatmodes/stand
      image-clip: 0 0 20 20
      anchors.left: defense.right
      anchors.top: changeSize.top
      margin-left: 1
      size: 20 20
      @onClick: |
        selectPosture('stand')

      $pressed !disabled:
        image-clip: 0 20 20 20

      $disabled:
        image-clip: 0 20 20 20

    TopToggleButton
      id: followPosture
      image-source: /images/game/combatmodes/chasemode
      image-clip: 0 0 20 20
      anchors.left: standPosture.right
      anchors.top: standPosture.top
      margin-left: 1
      size: 20 20
      @onClick: |
        selectPosture('follow')

      $pressed !disabled:
        image-clip: 0 20 20 20

      $disabled:
        image-clip: 0 20 20 20
    TopToggleButton
      id: pvpToggle
      image-source: /images/game/combatmodes/onPanel
      image-clip: 0 0 44 20
      anchors.left: followPosture.right
      anchors.top: standPosture.top
      margin-left: 1
      size: 44 20
      @onClick: onSetPVPToggle(self, not self:isChecked())

      $pressed !disabled:
        image-clip: 0 20 44 20

      $disabled:
        image-clip: 0 20 44 20

      $checked:
        image-clip: 0 20 44 20

    Button
      id: blessings
      image-source: /images/inventory/button_blessings_grey
      image-clip: 0 0 12 12
      anchors.top: expert.bottom
      anchors.left: changeSize.left
      margin-top: 3
      size: 12 12
      @onClick: modules.game_blessing.toggle()
      $pressed !disabled:
        image-clip: 12 0 12 12

    Panel
      id: icons
      anchors.left: soulAndCapacity.left
      anchors.right: pvp.right
      anchors.bottom: parent.bottom
      anchors.top: blessings.top
      phantom: false
      image-source: /images/ui/containerslot
      image-border: 3
      layout:
        type: horizontalBox

    TopToggleButton
      id: stop
      !text: tr('Stop')
      anchors.right: parent.right
      margin-right: 7
      anchors.bottom: icons.bottom
      font: cipsoftFont
      color: #c0c0c0ff
      size: 44 13
      @onClick: |
        g_game.stop()
        g_game.getLocalPlayer():stopAutoWalk()
