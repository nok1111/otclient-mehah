

MapTravelCostEntry < UIWidget
  height: 25

  UIWidget
    id: icon
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    size: 22 22
    image-source: /images/topbuttons/commands

  UIWidget
    id: text
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: icon.right
    margin-left: 5
    text-auto-resize: true

MapTravelZoneHeader < UIWidget
  height: 50
  phantom: false

  UICreature
    id: creatureIcon
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    size: 38 38

  UIWidget
    id: imageIcon
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    size: 38 38
    image-auto-resize: true
    image-smooth: true
    visible: false

  UIWidget
    id: info
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.left: creatureIcon.right
    anchors.right: parent.right
    margin-left: 8

    Label
      id: name
      color: #dfdfdf
      anchors.left: parent.left
      anchors.top: parent.top
      text-auto-resize: true
      margin-top: 10

    Label
      id: level
      anchors.left: parent.left
      anchors.top: name.bottom
      text-auto-resize: true

MapTravelMonsterEntry < UIWidget
  height: 32

  UICreature
    id: creatureIcon
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    size: 30 30

  Label
    id: text
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: creatureIcon.right
    margin-left: 6
    text-auto-resize: true

Panel
  text-offset: 5 2
  text-align: top
  image-source: /images/ui/list1
  image-border: 7
  size: 120 40
  phantom: true
  padding: 15
  layout:
    type: verticalBox
    fit-children: true
    spacing: 0
