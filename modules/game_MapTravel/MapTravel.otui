

MapTravelNode < UIWidget
  image-auto-resize: true
  phantom: false

MapTravelZoneNode < UICreature
  phantom: false

MapTravelZoneImageNode < UIWidget
  phantom: false
  image-auto-resize: true
  image-smooth: true

Mapimage < UIWidget
  phantom: false
  image-smooth: true

UIWidget
  anchors.fill: gameRootPanel
  @onClick: self:hide()
  phantom: false
  background-color: #00000060

  UIWidget
    id: mapPanel
    anchors.centerIn: parent
    phantom: false
    image-auto-resize: true
    draggable: true

    FlatPanel
      id: viewOnlyBadge
      text: VIEW ONLY
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 8
      margin-right: 8
      padding: 4
      text-auto-resize: true
      text-align: center
      background-color: #1a1a1acc
      color: #ffd966
      border-width: 1
      border-color: #666666
      visible: false

    UIWidget
      id: mapImageDev
      anchors.fill: parent
      visible: false
      phantom: false

    FlatPanel
      id: devModePanel
      size: 120 50
      text: Dev Mode
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 10
      margin-right: 10
      visible: false

    ComboBox
      id: nodesComboBox
      anchors.top: parent.top
      anchors.left: parent.left
      width: 200
      margin: 20
      visible: false