

MapTravelNode < UIWidget
  image-auto-resize: true
  phantom: false

MapTravelZoneNode < UICreature
  phantom: false

MapTravelZoneImageNode < UIWidget
  phantom: false
  image-auto-resize: true
  image-smooth: true

Mapimage < UIWidget
  phantom: false
  image-smooth: true

UIWidget
  anchors.fill: gameRootPanel
  @onClick: self:hide()
  phantom: false
  background-color: #00000060

  # Background frame
  FlatPanel
    id: mainFrame
    anchors.fill: parent
    image-source: /images/ui/backdrop-dark-grey
    image-border: 7
    padding: 8
    z-index: 0


  UIWidget
    id: mapPanel
    anchors.fill: parent
    phantom: false
    image-auto-resize: true
    draggable: false
    border-width: 1
    border-color: #3a3a3a
    z-index: 50

    # Top filters bar
    FlatPanel
      id: topBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 44
      background-color: #1c1c1ce6
      border-width: 1
      border-color: #333333
      padding: 6 8
      z-index: 100

    # Title
      UIWidget
        id: titleIcon
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 26 26
        image-source: /images/icons/minimap.png
        image-smooth: true

      Label
        id: titleLabel
        anchors.left: titleIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        text: World Map
        color: #dfdfdf
        font: terminus-14px-bold

      Button
        id: resetFilters
        anchors.left: titleLabel.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 12
        size: 30 30
        text: R
        tooltip: Reset filters

      Button
        id: centerMap
        anchors.left: resetFilters.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        size: 30 30
        icon: /images/icons/dot-circle_10469560.png
        tooltip: Center on player

      Button
        id: zoomOut
        anchors.left: centerMap.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        size: 30 30
        icon: /images/game/minimap/zoom_out.png
        tooltip: Zoom out

      Label
        id: zoomLabel
        anchors.left: zoomOut.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        width: 46
        text: 100%
        color: #dfdfdf
        text-align: center

      Button
        id: zoomIn
        anchors.left: zoomLabel.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        size: 30 30
        icon: /images/game/minimap/zoom_in.png
        tooltip: Zoom in

      ComboBox
        id: levelFilter
        width: 130
        height: 30
        anchors.left: zoomIn.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 10

      UIWidget
        id: searchIcon
        anchors.left: levelFilter.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 10
        size: 18 18
        image-source: /images/icons/search.png
        image-smooth: true

      TextEdit
        id: searchBox
        anchors.left: searchIcon.right
        anchors.right: closeBtn.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        margin-right: 8
        height: 30
        text: ""
        placeholder: Search...

      Button
        id: closeBtn
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        size: 30 30
        text: X
        tooltip: Close

    # Draggable map content (world map image + nodes live here)
    UIWidget
      id: mapCanvas
      anchors.top: topBar.bottom
      anchors.left: parent.left
      image-auto-resize: true
      image-smooth: true
      z-index: 10

    # Left control rail: vertical zoom slider + layer toggles
    FlatPanel
      id: leftRail
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      phantom: false
      focusable: true
      width: 112
      height: 285
      background-color: #161616d8
      border-width: 1
      border-color: #333333
      z-index: 90
      padding: 8

      Button
        id: railZoomIn
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        size: 30 30
        icon: /images/game/minimap/zoom_in.png
        tooltip: Zoom in

      UIWidget
        id: railZoomTrack
        anchors.top: railZoomIn.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        size: 6 100
        background-color: #2a2a2a
        border-width: 1
        border-color: #444444

        UIWidget
          id: railZoomThumb
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          size: 18 12
          background-color: #80c7f8
          border-width: 1
          border-color: #dfdfdf

      Button
        id: railZoomOut
        anchors.top: railZoomTrack.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 6
        size: 30 30
        icon: /images/game/minimap/zoom_out.png
        tooltip: Zoom out

      CheckBox
        id: railToggleMonsters
        anchors.top: railZoomOut.bottom
        anchors.left: parent.left
        margin-top: 12
        width: 96
        text: Show Monsters
        tooltip: Show monster icons

      CheckBox
        id: railToggleZones
        anchors.top: railToggleMonsters.bottom
        anchors.left: parent.left
        margin-top: 6
        width: 96
        text: Show Zones
        tooltip: Show zone images

      CheckBox
        id: railToggleUG
        anchors.top: railToggleZones.bottom
        anchors.left: parent.left
        margin-top: 6
        width: 96
        text: UG Zones
        tooltip: Show underground zones

    # Horizontal Scrollbar
    FlatPanel
      id: hScroll
      height: 12
      phantom: false
      focusable: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-bottom: 4
      background-color: #2a2a2a
      border-width: 1
      border-color: #444444
      z-index: 120

      Button
        id: hThumb
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 60
        height: 10
        text: ""
        background-color: #585858
        border-width: 1
        border-color: #777777

    # Vertical Scrollbar
    FlatPanel
      id: vScroll
      width: 12
      phantom: false
      focusable: true
      anchors.top: topBar.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-right: 4
      background-color: #2a2a2a
      border-width: 1
      border-color: #444444
      z-index: 120

      Button
        id: vThumb
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        width: 10
        height: 60
        text: ""
        background-color: #585858
        border-width: 1
        border-color: #777777


    FlatPanel
      id: viewOnlyBadge
      text: VIEW ONLY
      anchors.verticalCenter: topBar.verticalCenter
      anchors.right: parent.right
      margin-right: 8
      padding: 4
      text-auto-resize: true
      text-align: center
      background-color: #1a1a1acc
      color: #ffd966
      border-width: 1
      border-color: #666666
      visible: false
      z-index: 200


    UIWidget
      id: mapImageDev
      anchors.top: topBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      visible: false
      phantom: false

    FlatPanel
      id: devModePanel
      size: 120 50
      text: Dev Mode
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 10
      margin-right: 10
      visible: false

    ComboBox
      id: nodesComboBox
      anchors.top: parent.top
      anchors.left: parent.left
      width: 200
      margin: 20
      visible: false