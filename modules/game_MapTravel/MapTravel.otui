

MapTravelNode < UIWidget
  image-auto-resize: true
  phantom: false

MapTravelZoneNode < UICreature
  phantom: false

MapTravelZoneImageNode < UIWidget
  phantom: false
  image-auto-resize: true
  image-smooth: true

Mapimage < UIWidget
  phantom: false
  image-smooth: true

UIWidget
  anchors.fill: gameRootPanel
  @onClick: self:hide()
  phantom: false
  background-color: #00000060

  # Background frame
  FlatPanel
    id: mainFrame
    anchors.fill: parent
    image-source: /images/ui/panel_flat
    image-border: 7
    padding: 8
    z-index: 0

  UIWidget
    id: mapPanel
    anchors.fill: parent
    phantom: false
    image-auto-resize: true
    draggable: false
    border-width: 1
    border-color: #3a3a3a
    z-index: 50

    # Top filters bar
    FlatPanel
      id: topBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28
      background-color: #1c1c1ce6
      border-width: 1
      border-color: #333333
      padding: 3 6
      z-index: 100

    # Topbar controls
      Label
        id: filtersLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        text: Filters:
        color: #cfcfcf

      Button
        id: resetFilters
        anchors.left: filtersLabel.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        width: 22
        text: R
        tooltip: Reset filters

      Button
        id: centerMap
        anchors.left: resetFilters.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        width: 24
        text: C
        tooltip: Center map

      Button
        id: zoomOut
        anchors.left: centerMap.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        width: 24
        text: -
        tooltip: Zoom out

      Button
        id: zoomIn
        anchors.left: zoomOut.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        width: 24
        text: +
        tooltip: Zoom in

      ComboBox
        id: levelFilter
        width: 120
        anchors.left: zoomIn.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6

      ComboBox
        id: scrollSpeed
        width: 90
        anchors.left: levelFilter.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        tooltip: Scroll speed

      TextEdit
        id: searchBox
        anchors.left: levelFilter.right
        anchors.right: closeBtn.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        margin-right: 8
        text: ""
        placeholder: Search...

      Button
        id: closeBtn
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        width: 24
        text: X
        tooltip: Close

    # Draggable map content (world map image + nodes live here)
    UIWidget
      id: mapCanvas
      anchors.top: topBar.bottom
      anchors.left: parent.left
      image-auto-resize: true
      image-smooth: true
      z-index: 10

    # Horizontal Scrollbar
    FlatPanel
      id: hScroll
      height: 12
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-bottom: 4
      background-color: #2a2a2a
      border-width: 1
      border-color: #444444
      z-index: 120

      Button
        id: hThumb
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 60
        height: 10
        text: ""
        background-color: #585858
        border-width: 1
        border-color: #777777

    # Vertical Scrollbar
    FlatPanel
      id: vScroll
      width: 12
      anchors.top: topBar.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-right: 4
      background-color: #2a2a2a
      border-width: 1
      border-color: #444444
      z-index: 120

      Button
        id: vThumb
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        width: 10
        height: 60
        text: ""
        background-color: #585858
        border-width: 1
        border-color: #777777


    FlatPanel
      id: viewOnlyBadge
      text: VIEW ONLY
      anchors.verticalCenter: topBar.verticalCenter
      anchors.right: parent.right
      margin-right: 8
      padding: 4
      text-auto-resize: true
      text-align: center
      background-color: #1a1a1acc
      color: #ffd966
      border-width: 1
      border-color: #666666
      visible: false
      z-index: 200

    FlatPanel
      id: mainFrame
      anchors.centerIn: parent
      image-source: /images/ui/panel_flat
      image-border: 7
      padding: 8
      z-index: 40

    UIWidget
      id: mapImageDev
      anchors.top: topBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      visible: false
      phantom: false

    FlatPanel
      id: devModePanel
      size: 120 50
      text: Dev Mode
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 10
      margin-right: 10
      visible: false

    ComboBox
      id: nodesComboBox
      anchors.top: parent.top
      anchors.left: parent.left
      width: 200
      margin: 20
      visible: false