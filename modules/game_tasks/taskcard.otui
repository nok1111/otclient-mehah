TaskCard < Panel
  size: 270 280
  image-source: /images/ui/panel_flat
  image-border: 3
  image-color: #3a3a3a
  padding: 10
  phantom: false
  
  Panel
    id: tierBadge
    size: 80 22
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -5
    margin-right: -5
    image-source: /images/ui/panel_flat
    image-border: 2
    
    Label
      !text: tr('RARE')
      anchors.centerIn: parent
      font: verdana-11px-rounded
      text-align: center
      color: #0070DD
  
  Label
    id: taskName
    !text: tr('Hunt Task')
    anchors.top: parent.top
    anchors.left: parent.left
    font: verdana-11px-rounded
    color: #ffffff
    margin-top: 2
    
  Panel
    id: monsterPanel
    height: 52
    anchors.top: taskName.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    layout:
      type: horizontalBox
      spacing: 4
      align-center: true
    
  Label
    id: killsLabel
    !text: tr('Kills: 120')
    anchors.top: monsterPanel.bottom
    anchors.left: parent.left
    margin-top: 8
    font: verdana-11px-rounded
    
  Label
    id: zoneLabel
    !text: tr('Zone: 20-30')
    anchors.top: killsLabel.bottom
    anchors.left: parent.left
    margin-top: 3
    
  Label
    id: modifiersTitle
    !text: tr('Modifiers:')
    anchors.top: zoneLabel.bottom
    anchors.left: parent.left
    margin-top: 10
    font: verdana-11px-rounded
    color: #c0c0c0
    
  Panel
    id: modifiersPanel
    height: 65
    anchors.top: modifiersTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    layout:
      type: verticalBox
      spacing: 2
    
  Label
    id: rewardsTitle
    !text: tr('Rewards:')
    anchors.top: modifiersPanel.bottom
    anchors.left: parent.left
    margin-top: 8
    font: verdana-11px-rounded
    color: #c0c0c0
    
  Label
    id: goldReward
    !text: tr('Gold: 320')
    anchors.top: rewardsTitle.bottom
    anchors.left: parent.left
    margin-top: 3
    color: #FFD700
    
  Label
    id: fameReward
    !text: tr('Fame: 50')
    anchors.top: goldReward.bottom
    anchors.left: parent.left
    margin-top: 2
    color: #00BFFF
    
  Button
    id: lockButton
    !text: tr('LOCK')
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 90
    height: 25
    margin-bottom: 5
    
  Button
    id: startButton
    !text: tr('START')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 90
    height: 25
    margin-bottom: 5
    image-color: #00aa00
    
  Panel
    id: lockedOverlay
    anchors.fill: parent
    visible: false
    background-color: #00000060
    phantom: true
    
    Label
      !text: tr('LOCKED')
      anchors.centerIn: parent
      font: verdana-11px-rounded
      color: #FFD700
      text-align: center
