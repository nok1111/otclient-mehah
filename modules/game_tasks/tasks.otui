TaskCard < Panel
  id: taskCardPanel
  height: 370
  width: 210
  image-border: 5
  padding: 5
  phantom: false
  &cardHeight: 370
  &cardWidth: 210
  
  Label
    id: tierBadge
    size: 80 20
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
    margin-right: 2
    text-align: center
    font: verdana-11px-rounded
    background-color: #1a1a1a
    
  Label
    id: taskName
    text: Hunt Task
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: tierBadge.left
    font: verdana-11px-rounded
    color: #ffffff
    text-align: center
    margin-top: 8
    margin-right: 5
    
  Panel
    id: headerImagePanel
    height: 80
    width: 200
    anchors.top: taskName.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 20
    &panelHeight: 80
    &panelWidth: 200
      
  Panel
    id: infoPanel
    height: 60
    width: 200
    anchors.top: headerImagePanel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5
    image-source: /images/ui/windows/mod_overlay
    image-border: 5
    padding: 5
    &panelHeight: 60
    &panelWidth: 200
    
    Label
      id: killsLabel
      text: Kills: 15
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5
      width: 200
      font: verdana-11px-rounded
      text-align: center
      
    Label
      id: zoneLabel
      text: Zone: 20-30
      anchors.top: killsLabel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 3
      width: 200
      font: verdana-11px-rounded
      text-align: center
      
    Label
      id: zoneNameLabel
      text: Zone Name
      anchors.top: zoneLabel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      width: 200
      font: verdana-11px-rounded
      text-align: center
      color: #FFD700
  
  Panel
    id: modifiersPanel
    height: 90
    width: 200
    anchors.top: infoPanel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5
    image-border: 2
    padding: 5
    &panelHeight: 90
    &panelWidth: 200
    
    Label
      id: modifiersTitle
      text: Modifiers:
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      font: verdana-11px-rounded
      color: #aaaaaa
      
    Panel
      id: modifiersList
      anchors.top: modifiersTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 3
      layout:
        type: verticalBox
        spacing: 2
        fit-children: false
  
  Panel
    id: rewardsPanel
    height: 75
    width: 200
    anchors.top: modifiersPanel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5
    image-border: 2
    padding: 5
    &panelHeight: 75
    &panelWidth: 200
    
    Label
      id: rewardsTitle
      text: Rewards:
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      font: verdana-11px-rounded
      color: #aaaaaa
      
    Panel
      id: rewardsContainer
      anchors.top: rewardsTitle.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5
      height: 20
      width: 180
      layout:
        type: horizontalBox
        spacing: 10
        fit-children: false
      
      Panel
        id: reward1Panel
        size: 85 20
        visible: false
        
        UIWidget
          id: reward1Icon
          size: 16 16
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 40
          
        Label
          id: reward1Label
          anchors.left: reward1Icon.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          width: 65
          font: verdana-11px-rounded
          
      Panel
        id: reward2Panel
        size: 85 20
        visible: false
        
        UIWidget
          id: reward2Icon
          size: 16 16
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          
        Label
          id: reward2Label
          anchors.left: reward2Icon.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 5
          width: 65
          font: verdana-11px-rounded
    
  Button
    id: lockButton
    text: LOCK
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    width: 80
    height: 25
    margin-bottom: 15
    margin-left: 10
    image-color: #4a4a00
    
  Button
    id: startButton
    text: START
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 80
    height: 25
    margin-bottom: 15
    margin-right: 10
    image-color: #09f309ff
    
  Panel
    id: lockedOverlay
    anchors.fill: parent
    visible: false
    background-color: #00000080
    phantom: true
    
    UIWidget
      id: lockIcon
      size: 32 32
      anchors.centerIn: parent
      image-source: /images/icons/lock
      
    Label
      text: LOCKED
      anchors.top: lockIcon.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 5
      font: verdana-11px-rounded
      color: #FFD700
      text-align: center

MainWindow
  id: tasksWindow
  !text: tr('TASK BOARD')
  size: 700 750
  @onEscape: modules.game_tasks.toggleTasksPanel()

  Panel
    id: headerPanel
    height: 70
    width: 690
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5
    image-source: /images/ui/windows/miniwindow_old
    image-border: 5
    padding: 5
    &panelHeight: 70
    &panelWidth: 690
    
    Label
      id: fameLabel
      text: Fame: 0
      font: verdana-11px-rounded
      anchors.left: parent.left
      anchors.top: parent.top
      width: 150
      margin-top: 5
      margin-left: 10
      
    Label
      id: fameLevelLabel
      text: Level 1 (0/100)
      font: verdana-11px-rounded
      anchors.left: parent.left
      anchors.top: fameLabel.bottom
      width: 200
      margin-top: 5
      margin-left: 10
      
    Label
      id: dailyBonusLabel
      text: Daily Bonus: +20 Fame (Available)
      font: verdana-11px-rounded
      color: #00ff00
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 5
      margin-right: 10

  Label
    id: availableTasksTitle
    text: Available Tasks (3/3)
    font: verdana-11px-rounded
    anchors.top: headerPanel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15
    text-align: center

  Panel
    id: taskCardsContainer
    height: 380
    anchors.top: availableTasksTitle.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    width: 660
    layout:
      type: horizontalBox
      spacing: 15
      fit-children: false
      align-center: true

  Panel
    id: actionPanel
    height: 45
    width: 690
    anchors.top: taskCardsContainer.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    image-source: /images/ui/windows/miniwindow_old
    image-border: 5
    padding: 5
    &panelHeight: 45
    &panelWidth: 690
    layout:
      type: horizontalBox
      spacing: 15
      align-center: true
    
    Panel
      id: rerollSection
      width: 280
      
      UIWidget
        id: rerollIcon
        size: 16 16
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        image-source: /images/icons/reroll
      
      Button
        id: rerollButton
        text: Reroll Tasks
        width: 110
        height: 28
        anchors.left: rerollIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        @onClick: modules.game_tasks.onRerollClick()
        
      Label
        id: rerollCostLabel
        text: Cost:
        anchors.left: rerollButton.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        font: verdana-11px-rounded
        
      UIWidget
        id: fameCostIcon
        size: 24 20
        anchors.left: rerollCostLabel.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        margin-bottom: 2
        image-source: /images/icons/fame_big
        
      Label
        id: rerollCostAmount
        text: 50
        anchors.left: fameCostIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 3
        color: #FF8000
        width: 50
        font: verdana-11px-rounded
      
    VerticalSeparator
      width: 2
      margin-top: 5
      margin-bottom: 5
      margin-left: -50
    
    Panel
      id: rerollsAvailableSection
      width: 180
      margin-left: 5
      
      UIWidget
        id: rerollAvailableIcon
        size: 16 16
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        image-source: /images/icons/reroll
      
      Label
        id: rerollsAvailableLabel
        text: Free Rerolls: 5/10
        anchors.left: rerollAvailableIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        width: 200
        font: verdana-11px-rounded
        color: #00ff00
    
    VerticalSeparator
      width: 2
      margin-top: 5
      margin-bottom: 5
    
    Panel
      id: premiumSection
      width: 210
      
      UIWidget
        id: premiumIcon
        size: 24 20
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        margin-bottom: 2
        image-source: /images/icons/fame_big
        
      Label
        id: premiumLabel
        text: Premium: 1 free lock
        anchors.left: premiumIcon.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        font: verdana-11px-rounded
        color: #FFD700

  Panel
    id: activeTaskPanel
    height: 120
    width: 690
    anchors.top: actionPanel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    image-source: /images/ui/windows/panel_border
    image-border: 5
    padding: 8
    &panelHeight: 120
    &panelWidth: 690
    
    Panel
      id: headerSection
      height: 20
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      
      Label
        id: activeTaskTitle
        text: Active Task:
        font: verdana-11px-rounded
        color: #FFD700
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 5
        text-auto-resize: true
        
      Label
        id: activeTaskStatus
        text: No active task
        font: verdana-11px-rounded
        color: #888888
        anchors.left: activeTaskTitle.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        text-auto-resize: true
      
    ScrollablePanel
      id: progressContainer
      anchors.top: headerSection.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5
      margin-left: 5
      margin-right: 5
      height: 55
      vertical-scrollbar: progressScrollBar
      layout:
        type: verticalBox
        spacing: 3
        fit-children: true
      
    VerticalScrollBar
      id: progressScrollBar
      anchors.top: progressContainer.top
      anchors.bottom: progressContainer.bottom
      anchors.right: parent.right
      step: 14
      pixels-scroll: true
        
    Panel
      id: taskButtonsPanel
      height: 28
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 5
      layout:
        type: horizontalBox
        spacing: 10
        
      Button
        id: completeButton
        text: Complete Task
        width: 120
        height: 25
        visible: false
        image-color: #00ff00
        @onClick: modules.game_tasks.onCompleteClick()

  Panel
    id: dailyBonusPanel
    height: 28
    anchors.top: activeTaskPanel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    width: 400
    margin-top: 8
    
    UIWidget
      id: fameIcon
      size: 16 16
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      image-source: /images/icons/fame
      
    Label
      id: dailyBonusText
      text: +20 Fame (First Daily Task Completed)
      color: #FFD700
      font: verdana-11px-rounded
      anchors.left: fameIcon.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 5

  Button
    id: closeButton
    text: Close
    width: 100
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: -6
    margin-right: 10
    @onClick: modules.game_tasks.toggleTasksPanel()
