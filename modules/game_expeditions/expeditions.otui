ExpeditionWindow < MainWindow
  id: expeditionWindow
  !text: tr('Combat Expeditions')
  height: 520
  @onEscape: closeExpeditionPanel()
  @onGeometryChange: |
    if not self:isVisible() then
      closeExpeditionPanel()
    end

  Label
    id: titleLabel
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    text: Daily Expeditions
    font: verdana-11px-rounded
    color: #FFD700
    text-auto-resize: true

  Button
    id: prevButton
    width: 40
    height: 40
    anchors.top: titleLabel.bottom
    anchors.left: parent.left
    margin-top: 200
    margin-left: 10
    image-color: #00FFFF
    image-border: 3
    
    UIWidget
      id: prevArrow
      anchors.centerIn: parent
      image-source: /images/ui/scrollbar/scrollbar_arrow_left
      phantom: true

  Panel
    id: panelContainer
    anchors.top: titleLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15

  Button
    id: nextButton
    width: 40
    height: 40
    anchors.top: titleLabel.bottom
    anchors.right: parent.right
    margin-top: 200
    margin-right: 10
    image-color: #00FFFF
    image-border: 3
    
    UIWidget
      id: nextArrow
      anchors.centerIn: parent
      image-source: /images/ui/scrollbar/scrollbar_arrow_right
      phantom: true

  Button
    id: closeButton
    !text: tr('Close')
    width: 80
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 15

ExpeditionPanel < UIWidget
  size: 280 400
  image-source: /images/ui/windows/panel_border
  image-border: 50
  padding: 5

  UIWidget
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 150
    margin: 5
    margin-top: 15
    image-source: /images/ui/expedition_default
    image-smooth: true

  Label
    id: nameLabel
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    margin-left: 10
    margin-right: 10
    text: Expedition Name
    font: verdana-11px-rounded
    color: #FFD700
    text-auto-resize: true
    text-align: center

  Panel
    id: levelPanel
    anchors.top: nameLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5
    height: 20
    background-color: #00000000
    layout:
      type: horizontalBox
      spacing: 5
      fit-children: true
      align-center: true
    
    UIWidget
      id: levelIcon
      width: 9
      height: 9
      image-source: /images/icons/icon_experience
      image-smooth: true
    
    Label
      id: levelLabel
      text: Level 1 - 20
      font: verdana-11px-rounded
      color: #FFAA00
      text-auto-resize: true

  Label
    id: pvpLabel
    anchors.top: levelPanel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5
    text: Non PVP Zone
    font: verdana-11px-rounded
    color: #90EE90
    text-auto-resize: true

  Label
    id: descLabel
    anchors.top: pvpLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 10
    margin-right: 10
    height: 30
    text: Description of the expedition zone
    font: verdana-11px-antialised
    color: #C0C0C0
    text-wrap: true
    text-align: center

  Panel
    id: buffStatusPanel
    anchors.top: descLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 5
    height: 90
    width: 250
    image-source: /images/ui/windows/miniwindow
    image-border: 5
    padding: 5
    &panelHeight: 90
    
    UIWidget
      id: buffIcon
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 3
      size: 12 12
      image-smooth: true
      image-fixed-ratio: true
      phantom: false
      visible: false
    
    Label
      id: buffStatusLabel
      anchors.top: buffIcon.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      text: No buffs available
      font: verdana-11px-antialised
      color: #c0c0c0
      width: 200
      text-wrap: true
      text-align: center
      text-auto-resize: true
    
    Label
      id: buffDescLabel
      anchors.top: buffStatusLabel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      margin-left: 10
      margin-right: 10
      height: 30
      text:
      font: verdana-11px-antialised
      color: #FFFFFF
      text-wrap: true
      text-align: center
      visible: false

  Button
    id: joinButton
    !text: tr('Join Expedition')
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 10
    width: 150

TeleportPanel < UIWidget
  size: 210 320
  image-source: /images/ui/windows/panel_border
  image-border: 50
  padding: 5

  UIWidget
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 180
    margin: 5
    margin-top: 15
    image-source: /images/ui/expedition_default
    image-smooth: true

  Label
    id: nameLabel
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 10
    margin-right: 10
    text: Location Name
    font: verdana-11px-rounded
    color: #FFD700
    text-auto-resize: true
    text-align: center

  Label
    id: descLabel
    anchors.top: nameLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    margin-left: 10
    margin-right: 10
    height: 30
    text: Description
    font: verdana-11px-antialised
    color: #C0C0C0
    text-wrap: true
    text-align: center

  Button
    id: teleportButton
    !text: tr('Teleport')
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 5
    width: 120
