MainWindow
  size: 280 120
  !text: tr('Rename Category')
  @onEnter:
    if QuickLoot and QuickLoot.confirmCategoryName then
      QuickLoot.confirmCategoryName()
    end
  @onEscape:
    if QuickLoot and QuickLoot.cancelCategoryName then
      QuickLoot.cancelCategoryName()
    end

  Label
    !text: tr('Category name') .. ':'
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  TextEdit
    id: name
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 10

  Button
    id: confirmButton
    !text: tr('Ok')
    width: 64
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 10
    @onClick:
      if QuickLoot and QuickLoot.confirmCategoryName then
        QuickLoot.confirmCategoryName()
      end

  Button
    id: cancelButton
    !text: tr('Cancel')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick:
      if QuickLoot and QuickLoot.cancelCategoryName then
        QuickLoot.cancelCategoryName()
      end
