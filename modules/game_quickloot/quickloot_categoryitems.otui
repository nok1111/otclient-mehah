QuickLootCategoryItem < UIWidget
  background-color: #484848

  Label
    id: label
    color: #C0C0C0
    anchors.verticalCenter: parent.verticalCenter
    anchors.left: parent.left
    margin-left: 4
    text-auto-resize: true

  Item
    id: item
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: remove.left
    margin-right: 6

  QtButton
    id: remove
    !text: tr('Remove')
    size: 58 20
    anchors.verticalCenter: parent.verticalCenter
    anchors.right: parent.right
    margin-right: 4

MainWindow
  id: main
  !text: tr('Category Items')
  size: 420 360
  @onEscape: QuickLoot.closeCategoryItemsWindow()

  ScrollablePanel
    id: list
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: close.top
    margin-bottom: 8
    border-width: 1
    border-color: #00000077
    background-color: #ffffff11
    padding-left: 1
    padding-top: 1
    padding-bottom: 3
    vertical-scrollbar: scrollbar
    layout:
      type: grid
      cell-size: 390 28
      cell-spacing: 0
      flow: true

  VerticalScrollBar
    id: scrollbar
    anchors.top: list.top
    anchors.bottom: list.bottom
    anchors.right: list.right
    step: 28
    pixels-scroll: true

  QtButton
    id: close
    !text: tr('Close')
    size: 60 20
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    @onClick: QuickLoot.closeCategoryItemsWindow()
