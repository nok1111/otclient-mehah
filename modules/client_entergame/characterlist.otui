CharacterWidget < UIWidget
  size: 100 170
  background-color: #ffffff04
  border-width: 1
  border-color: #ffffff0a
  focusable: true
  phantom: false
  &updateOnStates: |
    function(self)
      local children = self:getChildren()
      for i=1,#children do
        children[i]:setOn(self:isFocused())
      end
    end
  @onFocusChange: self:updateOnStates()
  @onSetup: self:updateOnStates()

  $focus:
    background-color: #3a7ec820
    border-color: #5599cc90

  Label
    id: name
    color: #cccccc
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    height: 16
    margin-top: 4
    background-color: alpha

    $on:
      color: #ffffff

  Creature
    id: outfitCreatureBox
    anchors.top: name.bottom
    anchors.left: parent.left
    size: 80 80
    margin-top: 2
    margin-left: 10
    fixed-creature-size: true

  Label
    id: charInfo
    color: #778899
    anchors.top: outfitCreatureBox.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    margin-top: 2
    text-wrap: true
    text-auto-resize: true
    background-color: alpha

    $on:
      color: #aabbcc

  Label
    id: worldName
    color: #556677
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    height: 14
    margin-bottom: 2
    background-color: alpha
    &baseText: '%s'

    $on:
      color: #778899

  Label
    id: mainCharacter
    size: 9 8
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 4
    margin-top: 4
    image-source: /images/game/entergame/maincharacter
    image-clip: 0 0 9 8
    visible: false

  Label
    id: statusDailyReward
    size: 11 19
    visible: false

  Label
    id: statusHidden
    size: 11 19
    visible: false

  Label
    id: level
    visible: false

  Label
    id: vocation
    visible: false

MainWindow
  id: charactersWindow
  !text: tr('Character List')
  visible: false
  @onEnter: CharacterList.doLogin()
  @onEscape: CharacterList.hide(true)
  @onSetup: |
    g_keyboard.bindKeyPress('Left', function() self:getChildById('characters'):focusPreviousChild(KeyboardFocusReason) end, self)
    g_keyboard.bindKeyPress('Right', function() self:getChildById('characters'):focusNextChild(KeyboardFocusReason) end, self)
    if g_game.getFeature(GameEnterGameShowAppearance) then
      self:setSize({width = 745, height = 430})
    else
      self:setHeight(310)
    end

  ScrollablePanel
    id: characters
    background-color: #1e2228
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: accountStatusCaption.top
    margin-bottom: 8
    padding: 8
    focusable: false
    horizontal-scrollbar: characterListHScrollBar
    auto-focus: first
    layout:
      type: horizontalBox
      spacing: 6

  HorizontalScrollBar
    id: characterListHScrollBar
    anchors.left: characters.left
    anchors.right: characters.right
    anchors.top: characters.bottom
    step: 106
    pixels-scroll: true
    visible: false

  Label
    id: accountStatusCaption
    !text: tr('Account Status') .. ':'
    color: #778899
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 2

  Label
    id: accountStatusIcon
    size: 22 20
    anchors.left: parent.left
    anchors.bottom: next.bottom
    image-source: /images/game/entergame/premium
    image-clip: 0 0 22 20
    visible: false

  Label
    id: accountStatusLabel
    !text: tr('Free Account')
    color: #bbbbbb
    anchors.left: parent.left
    anchors.right: parent.right
    text-auto-resize: true
    margin-bottom: 5
    anchors.bottom: separator.top

    $on:
      color: #FF0000

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 8

  CheckBox
    id: enhanceGraphics
    !text: tr('Enhanced Graphics')
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-right: 10
    font: small-9px
    width: 110

  Button
    id: autoReconnect
    anchors.left: enhanceGraphics.right
    anchors.bottom: parent.bottom
    width: 90
    font: small-9px
    $!on:
      image-color: red
    $on:
      image-color: green

  Button
    id: buttonOk
    !text: tr('Ok')
    width: 64
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 10
    @onClick: CharacterList.doLogin()

  Button
    id: buttonCancel
    !text: tr('Cancel')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: CharacterList.hide(true)
