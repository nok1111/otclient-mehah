InventoryWindow
  id: mainmappanel
  draggable: true
  phantom: false
  image-source: /images/ui/windows/mainwindow
  &panelHeight: 200
  height: 200

  UIWidget
    id: minimapBorder
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 32
    margin-left: 5
    margin-right: 5
    size: 140 116
    image-source: /images/ui/1pixel_down_frame

    Minimap
      id: minimap
      anchors.fill: parent
      margin: 1

  UIWidget
    id: controls
    anchors.left: minimapBorder.left
    anchors.right: minimapBorder.right
    anchors.top: minimapBorder.bottom
    margin-top: 4
    height: 20

    Button
      id: floorDownBtn
      size: 20 20
      anchors.left: parent.left
      anchors.top: parent.top
      image-source: /images/ui/buttons/arrowtopdown
      image-clip: 0 0 20 20
      @onClick: downLayer()

      $hover !disabled:
        image-clip: 0 20 20 20

      $pressed !disabled:
        image-clip: 0 40 20 20

    Button
      id: floorUpBtn
      size: 20 20
      anchors.left: floorDownBtn.right
      anchors.top: parent.top
      margin-left: 2
      image-source: /images/ui/buttons/arrowtopdown
      image-clip: 20 0 20 20
      @onClick: upLayer()

      $hover !disabled:
        image-clip: 20 20 20 20

      $pressed !disabled:
        image-clip: 20 40 20 20

    Button
      id: zoomOutBtn
      size: 20 20
      anchors.left: floorUpBtn.right
      anchors.top: parent.top
      margin-left: 10
      image-source: /images/ui/buttons/plusandminus
      image-clip: 0 0 20 20
      @onClick: zoomOut()

      $hover !disabled:
        image-clip: 0 20 20 20

      $pressed !disabled:
        image-clip: 0 40 20 20

    Button
      id: zoomInBtn
      size: 20 20
      anchors.left: zoomOutBtn.right
      anchors.top: parent.top
      margin-left: 2
      image-source: /images/ui/buttons/plusandminus
      image-clip: 20 0 20 20
      @onClick: zoomIn()

      $hover !disabled:
        image-clip: 20 20 20 20

      $pressed !disabled:
        image-clip: 20 40 20 20

    Button
      id: mapButton
      text: Map
      size: 48 20
      anchors.right: parent.right
      anchors.top: parent.top
      @onClick: return true

  
