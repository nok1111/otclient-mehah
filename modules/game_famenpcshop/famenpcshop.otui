// Fame Category Tab - MainPanelGridButton with left icon
FameCategoryTab < MainPanelGridButton
  width: 100
  height: 28
  
  UIWidget
    id: iconWidget
    size: 16 16
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    phantom: true

  Label
    id: tabLabel
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    text-auto-resize: true
    phantom: true
    color: #dfdfdf

// Fame Item Card - Compact grid item
FameItemCard < UICheckBox
  size: 100 130
  border-width: 2
  border-color: #3a3a3a
  image-source: /images/ui/windows/panel_border
  image-auto-resize: true
  @onCheckChange: modules.game_famenpcshop.onItemCardSelected(self)

  Item
    id: itemWidget
    phantom: true
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 20
    size: 48 48

  UICreature
    id: creatureWidget
    phantom: true
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    size: 70 70

  Panel
    id: priceContainer
    height: 16
    anchors.bottom: next.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 2
    layout:
      type: horizontalBox
      spacing: 3
      fit-children: true

    UIWidget
      id: fameIcon
      size: 12 12
      image-source: /images/icons/fame
      phantom: true

    Label
      id: priceLabel
      text: 0 Fame
      font: verdana-11px-rounded
      color: #ffd700
      text-auto-resize: true
      phantom: true

  Label
    id: levelLabel
    text: Lvl 1
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 5
    font: verdana-11px-rounded
    color: #aaaaaa
    text-auto-resize: true

  UIWidget
    id: lockIcon
    size: 24 24
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 5
    image-source: /images/icons/lock_small
    visible: false
    phantom: true

  UIWidget
    id: ownedIcon
    size: 32 32
    anchors.top: parent.top
    anchors.left: parent.left
    margin: 5
    image-source: /images/icons/check_buy
    visible: false
    phantom: true

  $checked:
    border-color: #ffd700
    background-color: #2a2a2a

MainWindow
  id: famenpcWindow
  size: 700 580
  @onEscape: modules.game_famenpcshop.hide()

  Button
    id: closeButton
    text: close
    size: 60 26
    anchors.top: parent.top
    anchors.right: parent.right
    margin: 14 4 4 4
    font: verdana-11px-rounded
    color: #ffffff
    background-color: #cc0000
    phantom: false
    @onClick: modules.game_famenpcshop.hide()
    
    $hover:
      background-color: #ff0000

  // Header with Fame Points, Fame Level and Search
  Panel
    id: headerPanel
    height: 40
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 10 80 0 10
    image-source: /images/ui/windows/123123
    image-auto-resize: true

    // Fame Points Icon
    UIWidget
      id: fameIcon
      size: 16 16
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      image-source: /images/icons/fame_big
      phantom: true

    // Fame Points Label
    Label
      id: famePointsLabel
      text: Fame: 0 pts
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      font: verdana-11px-rounded
      color: #ffd700
      text-auto-resize: true

    // Fame Level Icon
    UIWidget
      id: fameLevelIcon
      size: 16 16
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 20
      image-source: /images/icons/star
      phantom: true

    // Fame Level Label
    Label
      id: fameLevelLabel
      text: Level: 0
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      font: verdana-11px-rounded
      color: #88ccff
      text-auto-resize: true

    // Gold Icon
    UIWidget
      id: goldIcon
      size: 16 16
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 20
      image-source: /images/icons/prey_gold
      phantom: true

    // Gold Label
    Label
      id: goldLabel
      text: Gold: 0
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      font: verdana-11px-rounded
      color: #ffcc00
      text-auto-resize: true

    // Token Icon
    UIWidget
      id: tokenIcon
      size: 16 16
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 20
      image-source: /images/icons/token
      phantom: true

    // Token Label
    Label
      id: tokenLabel
      text: Tokens: 0
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      width: 80
      font: verdana-11px-rounded
      color: #00ffaa
      text-auto-resize: true

    // Search Icon
    UIWidget
      id: searchIcon
      size: 16 16
      anchors.right: next.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      image-source: /images/icons/search
      phantom: true

    // Search Input
    TextEdit
      id: searchInput
      width: 100
      height: 25
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 10
      @onTextChange: modules.game_famenpcshop.onSearchTextChange()

  // Tabs Panel
  Panel
    id: tabsPanel
    height: 35
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 5 10 0 10
    layout:
      type: horizontalBox
      spacing: 5

  // Main Content Area
  Panel
    id: contentPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 5 10 10 10

    // Items Grid (Left Side)
    Panel
      id: itemsGridContainer
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      anchors.right: parent.horizontalCenter
      margin-right: 5
      background-color: #1a1a1a

      VerticalScrollBar
        id: itemsScrollBar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        step: 140
        pixels-scroll: true

      ScrollablePanel
        id: itemsGrid
        anchors.fill: parent
        margin-right: 12
        vertical-scrollbar: itemsScrollBar
        layout:
          type: grid
          cell-size: 145 130
          cell-spacing: 10
          flow: true

    // Item Details Panel (Right Side)
    Panel
      id: detailsPanel
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      anchors.left: parent.horizontalCenter
      margin-left: 5
      visible: false
      image-source: /images/ui/windows/legendary
      image-auto-resize: true

      Label
        id: detailNameLabel
        text: Item Name
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 15
        font: verdana-11px-rounded
        color: #ffffff
        text-align: center
        text-auto-resize: true

      // Normal preview (non-cosmetic shops)
      UICreature
        id: detailCreatureWidget
        anchors.top: detailNameLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10
        size: 128 128

      Item
        id: detailItemWidget
        anchors.top: detailNameLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 32
        size: 64 64

      // Cosmetic floor preview (shop 2 only)
      Panel
        id: cosmeticPreview
        anchors.top: detailNameLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 5
        size: 224 224
        visible: false
        phantom: true

        Panel
          id: cosmeticFloor
          anchors.fill: parent
          phantom: true
          layout:
            type: grid
            cell-size: 32 32
            num-columns: 7
            num-lines: 7

        UICreature
          id: cosmeticCreature
          anchors.fill: parent
          phantom: true

      UIWidget
        id: detailOwnedIcon
        size: 96 96
        anchors.top: detailNameLabel.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10
        image-source: /images/icons/check_buy
        visible: false
        phantom: true

      Label
        id: detailPriceLabel
        text: Price: 0 Fame
        anchors.top: cosmeticPreview.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 5 10 0 10
        font: verdana-11px-rounded
        color: #ffd700
        text-align: center

      Label
        id: detailLevelLabel
        text: Fame Level Required: 0
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 3 10 0 10
        color: #aaaaaa
        text-align: center

      Label
        id: detailTypeLabel
        text: Cosmetic / Account-wide
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 3 10 0 10
        color: #88ccff
        text-align: center

      TextEdit
        id: detailDescLabel
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 5 10 0 10
        height: 45
        text-wrap: true
        editable: false
        multiline: true
        change-cursor-image: false
        focusable: false
        selectable: false
        color: #cccccc
        background-color: #1a1a1a

      HorizontalScrollBar
        id: quantityScroll
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin: 5 10 0 10
        show-value: true
        minimum: 1
        maximum: 1
        step: 1
        @onValueChange: modules.game_famenpcshop.onQuantityChange(self:getValue())

      Button
        id: buyButton
        text: BUY
        width: 130
        height: 30
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: prev.bottom
        margin-top: 8
        @onClick: modules.game_famenpcshop.onBuyClick()

      UIWidget
        id: purchaseCheckIcon
        size: 48 48
        anchors.centerIn: buyButton
        image-source: /images/icons/check_buy
        visible: false
        phantom: true
