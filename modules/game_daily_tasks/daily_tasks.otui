DailyTaskRow < Panel
  height: 78
  image-source: /images/ui/windows/miniwindow
  image-border: 5
  padding: 6

  // Category icon (kill / gathering / dungeon / alchemy / etc.)
  UIWidget
    id: categoryIcon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    size: 40 40
    image-source: /images/game/buffs/arcana.png
    phantom: true

  // Difficulty pill badge (left-top)
  Panel
    id: diffBadge
    anchors.top: parent.top
    anchors.left: categoryIcon.right
    margin-top: 4
    margin-left: 8
    size: 58 14
    image-source: /images/ui/windows/miniwindow
    image-border: 3
    Label
      id: diffLabel
      anchors.fill: parent
      text-align: center
      color: #FFFFFF
      font: verdana-11px-antialised
      text: easy

  // Profession tag (right next to difficulty)
  Label
    id: professionLabel
    anchors.verticalCenter: diffBadge.verticalCenter
    anchors.left: diffBadge.right
    margin-left: 6
    color: #C5E1FF
    font: verdana-11px-antialised
    text: 

  Label
    id: title
    anchors.top: parent.top
    anchors.left: categoryIcon.right
    anchors.right: rewardsPanel.left
    margin-top: 18
    margin-left: 8
    margin-right: 6
    text-align: left
    color: #E7CF7A
    font: verdana-11px-rounded
    text: Task

  Label
    id: desc
    anchors.top: title.bottom
    anchors.left: categoryIcon.right
    anchors.right: rewardsPanel.left
    margin-top: 1
    margin-left: 8
    margin-right: 6
    text-align: left
    text-wrap: true
    color: #FFFFFF
    font: verdana-11px-antialised
    text: -

  // Rewards cluster: AP icon + value, Essence icon + value
  Panel
    id: rewardsPanel
    anchors.top: parent.top
    anchors.right: claimButton.left
    margin-top: 4
    margin-right: 6
    width: 120
    height: 24

    UIWidget
      id: apIcon
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 20 20
      image-source: /images/icons/row-2-column-8.png
    Label
      id: apValue
      anchors.left: apIcon.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      color: #FFD56B
      font: verdana-11px-rounded
      text: +0
    UIWidget
      id: essIcon
      anchors.left: apValue.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      size: 20 20
      image-source: /images/icons/gem.png
    Label
      id: essValue
      anchors.left: essIcon.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      color: #D7B4FF
      font: verdana-11px-rounded
      text: +0

  ProgressBar
    id: progress
    anchors.bottom: parent.bottom
    anchors.left: categoryIcon.right
    anchors.right: claimButton.left
    margin-bottom: 4
    margin-left: 8
    margin-right: 6
    height: 14
    minimum: 0
    maximum: 100
    value: 0
    text: 0/0

  Button
    id: claimButton
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    width: 92
    height: 26
    text: Claim

DailyTasksWindow < MainWindow
  id: dailyTasksWindow
  !text: tr('Daily Tasks')
  size: 680 640
  visible: false
  @onEscape: modules.game_daily_tasks.hide()

  // Top banner with crate icon, header and daily progress
  Panel
    id: headerPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 12
    margin-right: 12
    height: 76
    image-source: /images/ui/windows/miniwindow
    image-border: 5

    UIWidget
      id: crateIcon
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 10
      size: 56 56
      image-source: /images/codex/golden-crate.png

    Label
      id: headerLabel
      anchors.top: parent.top
      anchors.left: crateIcon.right
      anchors.right: parent.right
      margin-top: 8
      margin-left: 12
      margin-right: 12
      text: Daily Tasks
      color: #E7CF7A
      font: verdana-11px-rounded
      text-align: left

    Label
      id: headerSubLabel
      anchors.top: headerLabel.bottom
      anchors.left: crateIcon.right
      anchors.right: parent.right
      margin-top: 2
      margin-left: 12
      margin-right: 12
      text: Complete 4 tasks to unlock the Golden Crate
      color: #C5E1FF
      font: verdana-11px-antialised
      text-align: left

    ProgressBar
      id: dailyProgress
      anchors.bottom: parent.bottom
      anchors.left: crateIcon.right
      anchors.right: parent.right
      margin-bottom: 8
      margin-left: 12
      margin-right: 12
      height: 14
      minimum: 0
      maximum: 4
      value: 0
      text: 0/4

  Button
    id: claimDailyButton
    anchors.top: headerPanel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    width: 280
    height: 28
    text: Claim Golden Crate
    enabled: false

  Button
    id: closeButton
    !text: tr('Close')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 12
    margin-bottom: 10
    width: 90
    height: 26
    @onClick: modules.game_daily_tasks.hide()

  VerticalScrollBar
    id: tasksScroll
    anchors.top: claimDailyButton.bottom
    anchors.bottom: closeButton.top
    anchors.right: parent.right
    margin-top: 10
    margin-right: 12
    margin-bottom: 8
    width: 14
    step: 28
    pixels-scroll: true

  ScrollablePanel
    id: tasksList
    anchors.top: claimDailyButton.bottom
    anchors.left: parent.left
    anchors.right: tasksScroll.left
    anchors.bottom: closeButton.top
    margin-top: 10
    margin-left: 12
    margin-right: 4
    margin-bottom: 8
    vertical-scrollbar: tasksScroll
    layout:
      type: verticalBox
      spacing: 6
