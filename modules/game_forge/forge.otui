ForgeWindow < MainWindow
  id: forgeWindow
  !text: tr('Infernal Forge')
  size: 790 540
  visible: false
  @onEscape: modules.game_forge.hide()

  Button
    id: perksButton
    !text: tr('Perks')
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 6
    margin-right: 12
    width: 80
    height: 22

  Button
    id: forgeCloseButton
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 10
    margin-right: 12
    width: 80
    height: 22

  Label
    id: ashBonusLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    margin-left: 16
    margin-right: 16
    text: Ash Bonus: 0%
    color: #E7CF7A
    font: verdana-11px-rounded
    text-align: center

  Label
    id: milestoneLabel
    anchors.top: ashBonusLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 16
    margin-right: 16
    text: Milestone: 0
    color: #C5E1FF
    font: verdana-11px-antialised
    text-align: center

  Label
    id: progressLabel
    anchors.top: milestoneLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 16
    margin-right: 16
    text: Core: 0 | Progress: 0/0
    color: #9FD49F
    font: verdana-11px-antialised
    text-align: center

  ProgressBar
    id: coreProgressBar
    anchors.top: progressLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 18
    margin-right: 18
    height: 16
    minimum: 0
    maximum: 100
    value: 0
    text: Core Progress: 0/0

  Panel
    id: cardsContainer
    anchors.top: coreProgressBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-left: 16
    margin-right: 16
    margin-bottom: 14
    layout:
      type: horizontalBox
      spacing: 12

    ForgeActionCard
      id: feedCard
      cardImage:
        image-source: /images/forge/feed_core

    ForgeActionCard
      id: consumeCard
      cardImage:
        image-source: /images/forge/consume_ash

    ForgeActionCard
      id: infuseCard
      cardImage:
        image-source: /images/forge/infuse_core

ForgeActionCard < Panel
  width: 230
  image-source: /images/ui/windows/miniwindow
  image-border: 5
  padding: 8
  layout:
    type: verticalBox
    spacing: 5

  Label
    id: cardTitle
    text: Action
    color: #E7CF7A
    font: verdana-11px-rounded
    text-align: center

  UIWidget
    id: cardImage
    width: 136
    height: 136
    margin-left: 47

  Label
    id: cardDesc
    text: Description
    color: #C5E1FF
    font: verdana-11px-antialised
    text-wrap: true
    height: 46

  Label
    id: cardCostLabel
    text: Cost: -
    color: #FFFFFF
    font: verdana-11px-antialised

  Label
    id: cardValueLabel
    text: Value: -
    color: #9FD49F
    font: verdana-11px-antialised

  Button
    id: cardButton
    text: Execute

ForgePerksWindow < MainWindow
  id: forgePerksWindow
  !text: tr('Forge Perks')
  size: 600 560
  visible: false
  @onEscape: modules.game_forge.togglePerks()

  Label
    id: perksHeader
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 12
    margin-right: 12
    height: 16
    text: Core Level: 0
    color: #E7CF7A
    font: verdana-11px-rounded
    text-align: center

  Button
    id: perksCloseButton
    !text: tr('Close')
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-bottom: 10
    margin-right: 12
    width: 80
    height: 22

  VerticalScrollBar
    id: perksScrollBar
    anchors.top: perksHeader.bottom
    anchors.bottom: perksCloseButton.top
    anchors.right: parent.right
    margin-top: 8
    margin-right: 6
    margin-bottom: 8
    step: 32
    pixels-scroll: true

  ScrollablePanel
    id: perksList
    anchors.top: perksHeader.bottom
    anchors.left: parent.left
    anchors.right: perksScrollBar.left
    anchors.bottom: perksCloseButton.top
    margin-top: 8
    margin-left: 10
    margin-right: 4
    margin-bottom: 8
    vertical-scrollbar: perksScrollBar
    layout:
      type: verticalBox
      spacing: 3

ForgePerkRow < Panel
  height: 56
  image-source: /images/ui/windows/miniwindow
  image-border: 4
  padding: 4

  Label
    id: rowTitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 10
    margin-right: 10
    text: Level
    color: #C5C5C5
    font: verdana-11px-rounded

  Label
    id: rowDesc
    anchors.top: rowTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 10
    margin-right: 10
    height: 32
    text: -
    color: #C5E1FF
    font: verdana-11px-antialised
    text-wrap: true

