AuctionWindow < MainWindow
  id: auctionWindow
  !text: tr("Auction House")
  size: 640 420
  @onEscape: window:hide()

  Button
    id: openButton
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 8
    margin-left: 8
    text: Open
    @onClick: onOpen()

  TextEdit
    id: searchEdit
    anchors.left: openButton.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 8
    size: 200 20

  Button
    id: searchButton
    anchors.left: searchEdit.right
    anchors.top: parent.top
    margin-left: 6
    margin-top: 8
    text: Search
    @onClick: onSearch()

  Panel
    id: leftPane
    anchors.top: openButton.bottom
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-left: 8
    margin-bottom: 8
    size: 300 0

    Label
      text: Results
      anchors.left: parent.left
      anchors.top: parent.top

    UIScrollArea
      id: browseScroll
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      anchors.bottom: parent.bottom
      margin-top: 4

      Panel
        id: browseList
        layout:
          type: verticalBox
          fit-children: true
          fit-children-last: true

  Panel
    id: rightPane
    anchors.top: openButton.bottom
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    anchors.left: leftPane.right
    margin-top: 8
    margin-right: 8
    margin-left: 8
    margin-bottom: 8

    Label
      text: My Listings
      anchors.left: parent.left
      anchors.top: parent.top

    UIScrollArea
      id: myScroll
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 4
      height: 160

      Panel
        id: myList
        layout:
          type: verticalBox
          fit-children: true
          fit-children-last: true

    HorizontalSeparator
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6

    Label
      text: Create Listing
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 6

    Panel
      id: createRow
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 38
      margin-top: 4

      UIItem
        id: listItemSlot
        anchors.left: parent.left
        size: 36 36
        virtual: true
        item-id: 0
        item-count: 0
        draggable: false
        tooltip: Drag item here from inventory

      Label
        text: Price:
        anchors.left: listItemSlot.right
        anchors.top: parent.top
        margin-left: 8

      TextEdit
        id: priceEdit
        anchors.left: prev.right
        anchors.top: parent.top
        margin-left: 4
        size: 80 18
        numbers-only: true

      Label
        text: Count:
        anchors.left: priceEdit.right
        anchors.top: parent.top
        margin-left: 8

      ScrollBar
        id: countSpin
        anchors.left: prev.right
        anchors.top: parent.top
        margin-left: 4
        size: 100 18
        minimum: 1
        maximum: 100
        orientation: horizontal

      Button
        id: listButton
        anchors.right: parent.right
        anchors.top: parent.top
        text: List
        @onClick: onList()

    Panel
      id: actionsRow
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 32
      margin-top: 8

      Button
        id: buyButton
        anchors.left: parent.left
        text: Buy Selected
        @onClick: onBuy()

      Button
        id: cancelButton
        anchors.left: buyButton.right
        margin-left: 8
        text: Cancel My Selected
        @onClick: onCancel()


AuctionRow < Panel
  height: 32
  layout:
    type: horizontalBox
    fit-children: false
  anchors.left: parent.left
  anchors.right: parent.right

  UIItem
    id: icon
    size: 32 32
    virtual: true

  Label
    id: name
    anchors.left: icon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    text: Item Name
    width: 180
    text-auto-resize: false
    wrap: false

  Label
    id: price
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    text: 0
    color: yellow
